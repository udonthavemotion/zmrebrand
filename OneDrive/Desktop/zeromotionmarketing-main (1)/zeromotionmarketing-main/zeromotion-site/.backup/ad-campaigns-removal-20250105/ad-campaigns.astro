---
// ZEROMOTION-AD-CAMPAIGNS-REBRAND-2025
import BaseLayout from "../layouts/BaseLayout.astro";
import ModernBookingModal from "../components/ModernBookingModal.astro";
import DarkContentSection from "../components/sections/DarkContentSection.astro";
import BackgroundLayer from "../components/site/BackgroundLayer.astro";
import SEOInternalLinks from "../components/SEOInternalLinks.astro";
import VideoBg from "../components/common/VideoBg.astro";

const HERO_VIDEO = "/pictures/web design page/beautiful.mp4";

// SEO Configuration for Ad Campaigns Service Page
const title = "Complete Marketing Systems | ZeroMotion Marketing | Houma, LA";
const description = "Stop running ads in isolation. Get website + advertising + branding + AI working together as one intelligent system that turns every dollar into maximum ROI. Complete marketing systems for Houma businesses.";
const keywords = "integrated marketing systems Houma LA, complete marketing systems Thibodaux Louisiana, advertising website branding AI integration Louisiana, marketing automation Houma, conversion-focused advertising Louisiana";
const canonical = "/ad-campaigns";
const ogImage = "/og-webdesign.png";

// Ad Campaigns Service Schema
const adCampaignsSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Complete Marketing Systems",
    "description": "Integrated marketing systems combining advertising, websites, branding, and AI automation for Louisiana businesses.",
    "provider": {
      "@type": "Organization",
      "name": "ZeroMotion Marketing",
      "url": "https://zeromotion.marketing"
    },
    "serviceType": "Integrated Marketing Systems",
    "areaServed": [
      {
        "@type": "City",
        "name": "Houma",
        "addressRegion": "LA"
      },
      {
        "@type": "City",
        "name": "Thibodaux",
        "addressRegion": "LA"
      }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Marketing Systems",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Starter Website + Smart Advertising",
            "description": "Complete marketing system with website and targeted advertising"
          },
          "priceRange": "$200-$300"
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Growth Marketing + Automation System",
            "description": "Advanced marketing ecosystem with multi-platform advertising"
          },
          "priceRange": "$1000-$1500"
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why do you combine website, ads, branding, and AI instead of just running ads?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Because ads without optimized websites waste 40-60% of your budget. When your ads drive traffic to conversion-optimized websites with consistent branding and smart automation, every component amplifies the others for maximum ROI."
        }
      },
      {
        "@type": "Question",
        "name": "Can I get just advertising without the website and branding components?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We focus on complete marketing systems because they deliver better results. However, if you have a high-converting website and strong brand, we can integrate our advertising with your existing assets."
        }
      },
      {
        "@type": "Question",
        "name": "How is this different from other advertising agencies?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Most agencies just run ads and hope your website converts. We optimize your entire customer journey - from ad click to website conversion to automated follow-up. This integrated approach typically delivers 60% better ROI than standalone advertising."
        }
      }
    ]
  }
];
---

<BaseLayout {title} {description} {keywords} {canonical} {ogImage} schema={adCampaignsSchema}>
  <!-- Preload critical videos for smooth experience -->
  <link rel="preload" as="video" href={HERO_VIDEO} type="video/mp4" crossorigin="anonymous" />
  <link rel="dns-prefetch" href="//zeromotion.marketing" />
  <meta name="video-quality" content="ultra-high" />
  <meta name="video-preload" content="auto" />

  <!-- Background Layer -->
  <BackgroundLayer
    poster="/pictures/web design page/beautiful.mp4"
    desktopSrc="/pictures/web design page/beautiful.mp4"
    overlay="vignette"
  />

  <div class="ad-campaigns">
    <section class="hero" data-hero>
      <div class="container-page ad-hero">
        <h1 class="h1">Complete Marketing Systems That Convert + Scale + Dominate</h1>
        <p class="sub">
          Stop running ads in isolation. Get website + advertising + branding + AI working together as one intelligent system that turns every dollar into maximum ROI.
        </p>
        <div class="btn-row">
          <a
            class="btn btn-primary"
            href="#pricing"
            onclick="window.dataLayer&&dataLayer.push({event:'cta_click',label:'See Complete Marketing Systems'})"
            data-event="adcampaigns_complete_system_view"
            ><span class="btn-text-main">See Complete Marketing Systems</span></a
          >
          <a
            class="btn-ghost"
            href="#how"
            onclick="window.dataLayer&&dataLayer.push({event:'cta_click',label:'How Integration Works'})"
            data-event="adcampaigns_integration_benefits_view"
            ><span class="btn-text-main">How Integration Works</span></a
          >
        </div>
        <div class="platforms">
          Meta • Google • TikTok • YouTube • Maps • Retargeting
        </div>
      </div>
    </section>

    <!-- Integration benefits section -->
    <section class="section" style="position: relative; isolation: isolate; padding: var(--zm-gap-xl) 0;">
      <VideoBg src="/assets/textures/36471-410610193_small.mp4" opacity={0.15} />
      <div class="container-page">
        <div id="integration-benefits" class="merged-integration-section" style="text-align: center; max-width: 1200px; margin: 0 auto; position: relative; z-index: 1;">
          <h2 class="h2" style="color: #8b5cf6; margin-bottom: 24px;">Why Integrated Marketing Systems Outperform Standalone Ads</h2>
          <p class="sub" style="margin-bottom: 60px; color: #e2e8f0; max-width: 800px; margin-left: auto; margin-right: auto;">Ads without optimized websites, consistent branding, and smart automation waste 60% of your budget</p>

          <div class="benefits-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 40px; margin: 40px 0; justify-content: center;">
            <div class="benefit-card card" style="text-align: center; position: relative; border: 2px solid rgba(139, 92, 246, 0.3); transition: all 0.3s ease;">
              <div class="benefit-icon" style="font-size: 3.5rem; color: #8b5cf6; margin-bottom: 25px;">🚀</div>
              <h3 class="h3" style="color: #ffffff; margin-bottom: 20px;">Website + Ads = Higher Conversion</h3>
              <p style="color: #e2e8f0; line-height: 1.6;">Your ads drive traffic to conversion-optimized websites, not generic landing pages. Every click has the best chance to become a customer.</p>
            </div>

            <div class="benefit-card card" style="text-align: center; position: relative; border: 2px solid rgba(139, 92, 246, 0.3); transition: all 0.3s ease;">
              <div class="benefit-icon" style="font-size: 3.5rem; color: #8b5cf6; margin-bottom: 25px;">🎯</div>
              <h3 class="h3" style="color: #ffffff; margin-bottom: 20px;">Brand + Ads = Trust That Converts</h3>
              <p style="color: #e2e8f0; line-height: 1.6;">Your ads, website, and follow-up emails all match your professional brand. Consistent messaging builds trust that converts prospects into customers.</p>
            </div>

            <div class="benefit-card card" style="text-align: center; position: relative; border: 2px solid rgba(139, 92, 246, 0.3); transition: all 0.3s ease;">
              <div class="benefit-icon" style="font-size: 3.5rem; color: #8b5cf6; margin-bottom: 25px;">🤖</div>
              <h3 class="h3" style="color: #ffffff; margin-bottom: 20px;">AI + Ads = Smart Optimization</h3>
              <p style="color: #e2e8f0; line-height: 1.6;">AI monitors your ad performance, website behavior, and lead quality to automatically optimize campaigns for maximum ROI.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How Our Integrated Marketing Systems Work -->
    <section class="adcampaigns-hero-video-section section">
      <div class="enhanced-process" id="how">
        <h2 class="h2" style="color: #8b5cf6; text-align: center; margin-bottom: 40px;">How Our Integrated Marketing Systems Work</h2>
        <p class="sub" style="text-align: center; margin-bottom: 40px; color: #e2e8f0;">Every component amplifies the others for maximum business growth</p>

        <div class="process-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px;">
          <div class="process-step card">
            <div class="process-number">1</div>
            <h3 class="h3" style="color: #ffffff; margin-bottom: 15px;">Analyze Your Complete Business System</h3>
            <p style="color: #e2e8f0; line-height: 1.5;">We analyze your current website, brand positioning, ad performance, and customer journey to identify integration opportunities that most competitors miss.</p>
          </div>

          <div class="process-step card">
            <div class="process-number">2</div>
            <h3 class="h3" style="color: #ffffff; margin-bottom: 15px;">Build Integrated Marketing Infrastructure</h3>
            <p style="color: #e2e8f0; line-height: 1.5;">We optimize your website for conversions, align your brand messaging across all platforms, and set up AI automation that works with your advertising campaigns.</p>
          </div>

          <div class="process-step card">
            <div class="process-number">3</div>
            <h3 class="h3" style="color: #ffffff; margin-bottom: 15px;">Launch Coordinated Campaigns</h3>
            <p style="color: #e2e8f0; line-height: 1.5;">We launch advertising campaigns that drive traffic to conversion-optimized websites with brand-consistent messaging and AI-powered lead qualification.</p>
          </div>
        </div>
      </div>

      <!-- Hero Video Background -->
      <video
        src="/pictures/web design page/beautiful.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        class="adcampaigns-hero-background-video stable-hero-video"
        style="opacity: 0.8; filter: brightness(0.8) contrast(1.1) saturate(1.2); will-change: transform; position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0;"
        onloadstart="this.style.visibility='visible'"
        oncanplay="this.classList.add('loaded')"
        width="1920"
        height="1080"
        aria-hidden="true"
        role="img"
        aria-label="Background video showing ZeroMotion's integrated marketing process"
      ></video>

      <!-- Overlay gradient for text readability -->
      <div class="adcampaigns-hero-video-overlay" style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(139, 92, 246, 0.05), rgba(0, 0, 0, 0.2)); z-index: 1; pointer-events: none;"></div>
    </section>

    <!-- Industries We Scale in Houma -->
    <section class="industries-section section" style="position: relative; isolation: isolate; padding: var(--zm-gap-xl) 0;">
      <div class="container-page">
        <div style="text-align: center; margin-bottom: 50px; position: relative; z-index: 1;">
          <h2 class="h2" style="margin-bottom: 20px;">Industries We Scale in Houma</h2>
          <p class="sub" style="max-width: 800px; margin: 0 auto 20px auto;">
            Complete marketing systems tailored for each industry's unique challenges and opportunities
          </p>
        </div>

        <div class="benefits-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 40px; margin: 40px 0; justify-content: center;">
          <!-- Construction & Trades -->
          <div class="benefit-card card industry-card" style="text-align: center; position: relative; border: 2px solid rgba(139, 92, 246, 0.3); transition: all 0.3s ease;">
            <VideoBg src="/videos/industries/construction.mp4" opacity={0.2} />
            <div class="benefit-icon" style="font-size: 4rem; color: #8b5cf6; margin-bottom: 30px;">🏗️</div>
            <h3 class="h3" style="color: #ffffff; margin-bottom: 24px; font-weight: 700;">Construction & Trades</h3>
            <p style="color: #e2e8f0; line-height: 1.7; margin-bottom: 20px; font-size: 1.05rem;">Booked jobs, not just clicks.</p>
            <p class="sub" style="color: #e2e8f0; opacity: 0.85; font-size: 0.95rem; line-height: 1.6;">Emergency-call campaigns • Radius targeting • Call-only ads • After-hours retargeting</p>
            <div class="industry-enhancement" style="background: rgba(139, 92, 246, 0.1); border-left: 4px solid #8b5cf6; padding: 20px; margin-top: 15px; border-radius: 8px;">
              <p style="color: #e2e8f0; margin-bottom: 10px; font-size: 1.05rem;">Complete system includes contractor-optimized website + targeted ads + professional brand + automated lead qualification</p>
              <p class="result-focus" style="color: #10b981; font-weight: bold; font-size: 1.1rem;">Average 40% increase in qualified leads within 60 days</p>
            </div>
          </div>

          <!-- Real Estate -->
          <div class="benefit-card card industry-card" style="text-align: center; position: relative; border: 2px solid rgba(139, 92, 246, 0.3); transition: all 0.3s ease;">
            <VideoBg src="/videos/industries/real-estate.mp4" opacity={0.2} />
            <div class="benefit-icon" style="font-size: 4rem; color: #8b5cf6; margin-bottom: 30px;">🏠</div>
            <h3 class="h3" style="color: #ffffff; margin-bottom: 24px; font-weight: 700;">Real Estate</h3>
            <p style="color: #e2e8f0; line-height: 1.7; margin-bottom: 20px; font-size: 1.05rem;">Showings and signed contracts.</p>
            <p class="sub" style="color: #e2e8f0; opacity: 0.85; font-size: 0.95rem; line-height: 1.6;">Lead forms that qualify • Home value hooks • Lookalike buyers • Map pin targeting</p>
            <div class="industry-enhancement" style="background: rgba(139, 92, 246, 0.1); border-left: 4px solid #8b5cf6; padding: 20px; margin-top: 15px; border-radius: 8px;">
              <p style="color: #e2e8f0; margin-bottom: 10px; font-size: 1.05rem;">Integrated approach includes agent websites + listing promotion + brand consistency + automated lead nurturing</p>
              <p class="result-focus" style="color: #10b981; font-weight: bold; font-size: 1.1rem;">Typical 60% improvement in lead-to-appointment conversion</p>
            </div>
          </div>

          <!-- Auto Detailing & Tint -->
          <div class="benefit-card card industry-card" style="text-align: center; position: relative; border: 2px solid rgba(139, 92, 246, 0.3); transition: all 0.3s ease;">
            <VideoBg src="/videos/industries/auto.mp4" opacity={0.2} />
            <div class="benefit-icon" style="font-size: 4rem; color: #8b5cf6; margin-bottom: 30px;">🚗</div>
            <h3 class="h3" style="color: #ffffff; margin-bottom: 24px; font-weight: 700;">Auto Detailing & Tint</h3>
            <p style="color: #e2e8f0; line-height: 1.7; margin-bottom: 20px; font-size: 1.05rem;">Calendars filled weekly.</p>
            <p class="sub" style="color: #e2e8f0; opacity: 0.85; font-size: 0.95rem; line-height: 1.6;">Local intent keywords • Promo bundles • Instagram DM capture • Review boosts</p>
            <div class="industry-enhancement" style="background: rgba(139, 92, 246, 0.1); border-left: 4px solid #8b5cf6; padding: 20px; margin-top: 15px; border-radius: 8px;">
              <p style="color: #e2e8f0; margin-bottom: 10px; font-size: 1.05rem;">Complete system includes service-focused website + local advertising + brand differentiation + automated booking</p>
              <p class="result-focus" style="color: #10b981; font-weight: bold; font-size: 1.1rem;">Usually 50% increase in online bookings within 90 days</p>
            </div>
          </div>
        </div>

        <div style="text-align: center; margin-top: 40px; position: relative; z-index: 1;">
          <p class="sub" style="color: #e2e8f0;">
            <a
              href="#consultation-booking"
              class="underline underline-offset-4"
              data-cta="industries_tailor_cta"
              style="color: #8b5cf6;"
              >Don't see your industry? We'll tailor it. →</a>
          </p>
        </div>
      </div>
    </section>

          <!-- Complete Business Growth System -->
    <section class="adcampaigns-comparison-video-section section">
      <div class="container-page">
        <div id="pricing">
          <div style="text-align: center; margin-bottom: 50px;">
            <h2 class="h2" style="margin-bottom: 20px;">Choose Your Complete Marketing System</h2>
            <p class="sub" style="color: #e2e8f0; max-width: 800px; margin: 0 auto;">Website optimization + advertising + branding + AI automation working together</p>
          </div>

          <div class="pricing-cards-modern" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 40px; max-width: 1400px; margin: 0 auto; padding: 20px 0; justify-content: center;">
            <!-- Starter System - Subscription Focus -->
            <div class="card pkg system-card subscription-focus" style="border: 3px solid rgba(34, 197, 94, 0.6); background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(34, 197, 94, 0.05)); position: relative; text-align: center; padding: 40px 30px 60px 30px; border-radius: 25px; overflow: visible; margin-bottom: 20px;">
              <div class="model-indicator" style="position: absolute; top: -15px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #22c55e, #16a34a); color: white; padding: 8px 20px; border-radius: 20px; font-weight: bold; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">
                🚀 STARTER SYSTEM
              </div>

              <h3 class="h2" style="color: #22c55e; margin-bottom: 25px; font-weight: 700;">Starter Website + Smart Advertising</h3>
              <div class="pricing-highlight" style="background: rgba(0, 0, 0, 0.4); padding: 25px; border-radius: 15px; margin-bottom: 30px;">
                <div style="font-size: 2.2rem; font-weight: bold; color: #ffffff; line-height: 1;">$200–$300</div>
                <div style="color: #22c55e; font-weight: 600; margin: 8px 0;">build cost</div>
                <div style="font-size: 1.8rem; font-weight: bold; color: #22c55e;">+ $75–$100/mo</div>
                <div style="color: #e2e8f0; opacity: 0.8; font-size: 0.9rem; margin-top: 10px;">
                  <strong style="color: #22c55e;">Professional website + targeted ads</strong>
                </div>
              </div>

              <p class="system-description" style="color: #e2e8f0; margin: 25px 0; line-height: 1.6; font-size: 1rem;">Professional website with conversion optimization + targeted advertising + brand consistency + smart lead automation. Perfect for new businesses ready to grow systematically.</p>

              <ul style="text-align: left; margin: 30px 0; color: #e2e8f0; padding-left: 0; list-style: none;">
                <li style="margin-bottom: 15px; padding-left: 30px; position: relative;"><span style="position: absolute; left: 0; color: #22c55e; font-weight: bold; font-size: 1.2rem;">✓</span> Conversion-optimized website (1-3 pages)</li>
                <li style="margin-bottom: 15px; padding-left: 30px; position: relative;"><span style="position: absolute; left: 0; color: #22c55e; font-weight: bold; font-size: 1.2rem;">✓</span> Google Ads OR Facebook Ads (your choice)</li>
                <li style="margin-bottom: 15px; padding-left: 30px; position: relative;"><span style="position: absolute; left: 0; color: #22c55e; font-weight: bold; font-size: 1.2rem;">✓</span> Brand-consistent ad creative and messaging</li>
                <li style="margin-bottom: 15px; padding-left: 30px; position: relative;"><span style="position: absolute; left: 0; color: #22c55e; font-weight: bold; font-size: 1.2rem;">✓</span> Smart lead capture and automated follow-up</li>
                <li style="margin-bottom: 15px; padding-left: 30px; position: relative;"><span style="position: absolute; left: 0; color: #22c55e; font-weight: bold; font-size: 1.2rem;">✓</span> Basic performance tracking and optimization</li>
                <li style="margin-bottom: 15px; padding-left: 30px; position: relative;"><span style="position: absolute; left: 0; color: #22c55e; font-weight: bold; font-size: 1.2rem;">✓</span> Monthly strategy review and adjustments</li>
              </ul>

              <a
                class="btn-primary subscription-cta"
                href="#consultation-booking"
                onclick="window.dataLayer&&dataLayer.push({event:'cta_click',label:'Start Starter System'})"
                style="background: linear-gradient(135deg, #22c55e, #16a34a); width: calc(100% - 20px); padding: 18px; font-weight: 700; font-size: 1.1rem; border-radius: 12px; text-transform: none; transition: all 0.3s ease; position: absolute; bottom: 15px; left: 50%; transform: translateX(-50%); box-shadow: 0 8px 25px rgba(34, 197, 94, 0.4); z-index: 10;"
                >🚀 Start Your Marketing System</a
              >
            </div>

            <!-- Growth System - Popular -->
            <div class="card pkg system-card popular-card project-focus" style="border: 3px solid rgba(139, 92, 246, 0.8); background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(139, 92, 246, 0.08)); position: relative; text-align: center; padding: 40px 30px 60px 30px; border-radius: 25px; box-shadow: 0 25px 50px rgba(139, 92, 246, 0.25); overflow: visible; margin-bottom: 20px;">
              <div class="popular-badge" style="position: absolute; top: -18px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #f59e0b, #d97706); color: white; padding: 10px 25px; border-radius: 25px; font-weight: bold; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 5px 15px rgba(245, 158, 11, 0.4);">
                ⭐ MOST POPULAR
              </div>
              <div class="model-indicator" style="position: absolute; top: 8px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #8b5cf6, #a855f7); color: white; padding: 6px 18px; border-radius: 15px; font-weight: bold; font-size: 11px; text-transform: uppercase; letter-spacing: 1px;">
                💎 GROWTH SYSTEM
              </div>

              <h3 class="h2" style="color: #8b5cf6; margin: 35px 0 25px 0; font-weight: 700;">Growth Marketing + Automation System</h3>
              <div class="pricing-highlight" style="background: rgba(0, 0, 0, 0.5); padding: 30px; border-radius: 15px; margin-bottom: 30px; border: 2px solid rgba(139, 92, 246, 0.3);">
                <div style="font-size: 2.5rem; font-weight: bold; color: #ffffff; line-height: 1;">$1,000–$1,500</div>
                <div style="color: #8b5cf6; font-weight: 600; margin: 8px 0;">setup cost</div>
                <div style="font-size: 1.2rem; color: #8b5cf6; font-weight: 600;">+ $150–$300/mo</div>
                <div style="color: #e2e8f0; opacity: 0.9; font-size: 0.9rem; margin-top: 12px;">
                  <strong style="color: #8b5cf6;">Complete marketing ecosystem</strong>
                </div>
              </div>

              <p class="system-description" style="color: #e2e8f0; margin: 25px 0; line-height: 1.6; font-size: 1rem;">Complete marketing ecosystem with multi-platform advertising, conversion funnels, brand integration, and AI-powered automation for growing businesses.</p>

              <ul style="text-align: left; margin: 30px 0; color: #e2e8f0; padding-left: 0; list-style: none;">
                <li style="margin-bottom: 15px; padding-left: 30px; position: relative;"><span style="position: absolute; left: 0; color: #8b5cf6; font-weight: bold; font-size: 1.2rem;">✓</span> Advanced website with conversion funnels</li>
                <li style="margin-bottom: 15px; padding-left: 30px; position: relative;"><span style="position: absolute; left: 0; color: #8b5cf6; font-weight: bold; font-size: 1.2rem;">✓</span> Google Ads + Facebook Ads + retargeting campaigns</li>
                <li style="margin-bottom: 15px; padding-left: 30px; position: relative;"><span style="position: absolute; left: 0; color: #8b5cf6; font-weight: bold; font-size: 1.2rem;">✓</span> Brand-consistent email sequences and templates</li>
                <li style="margin-bottom: 15px; padding-left: 30px; position: relative;"><span style="position: absolute; left: 0; color: #8b5cf6; font-weight: bold; font-size: 1.2rem;">✓</span> AI-powered lead scoring and qualification</li>
                <li style="margin-bottom: 15px; padding-left: 30px; position: relative;"><span style="position: absolute; left: 0; color: #8b5cf6; font-weight: bold; font-size: 1.2rem;">✓</span> Social media integration and automated posting</li>
                <li style="margin-bottom: 15px; padding-left: 30px; position: relative;"><span style="position: absolute; left: 0; color: #8b5cf6; font-weight: bold; font-size: 1.2rem;">✓</span> Advanced analytics and ROI tracking</li>
              </ul>

              <a
                class="btn-primary custom-cta"
