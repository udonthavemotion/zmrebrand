---
import TransparentLogo from "./TransparentLogo.astro";
---

<section
  id="hero"
  class="relative isolate overflow-hidden bg-black min-h-[70svh] sm:min-h-[78svh] grid place-items-center hero-section"
  aria-labelledby="hero-title"
  data-hero
>
  <!-- Optimized Hero Video - Enhanced for bright, colorful display -->
  <video
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover border-none outline-none optimized-video stable-hero-video"
    style="border: none; outline: none; box-shadow: none; filter: brightness(0.8) contrast(1.1) saturate(1.2); will-change: transform;"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    data-critical="true"
    width="1920"
    height="1080"
    aria-hidden="true"
    role="img"
    aria-label="Background video showing ZeroMotion's digital marketing services in action"
    onloadstart="this.style.visibility='visible'"
    oncanplay="this.classList.add('loaded')"
  >
    <source src="/photos/homepage_hero.mp4" type="video/mp4" />
  </video>

  <!-- Overlay gradient for text readability -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-black/80 via-transparent to-black/60"
  ></div>
  <div class="relative container-page text-center hero-content">
    <TransparentLogo
      class="mx-auto mb-6 h-80 sm:h-[28rem] md:h-[36rem] lg:h-[40rem]"
    />
    <h1 id="hero-title" class="h1">Get 3X More Leads in 90 Days</h1>
    <p class="text-white/90 max-w-2xl mx-auto mt-4 text-lg">
      Zero Motion = zero manual effort, maximum conversion. AI-powered automation and CRM systems that transform Louisiana businesses from leads to loyal customers.
    </p>
    <!-- Urgency Indicator -->
    <div class="inline-flex items-center gap-2 mt-4 px-4 py-2 rounded-full bg-purple-500/20 border border-purple-500/30 text-purple-200 text-sm font-medium">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      <span>Free 30-Minute Consultation • Limited Spots Available</span>
    </div>
    <!-- Quick Benefits -->
    <div class="mt-6 flex flex-wrap justify-center gap-4 text-sm text-white/80 max-w-2xl mx-auto">
      <div class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-purple-400">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>No Long-Term Contracts</span>
      </div>
      <div class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-purple-400">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>90-Day Results Guarantee</span>
      </div>
      <div class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-purple-400">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Louisiana-Based Support</span>
      </div>
    </div>
    <div class="mt-6 mb-16 flex flex-col sm:flex-row gap-6 justify-center items-center max-w-lg mx-auto" role="group" aria-label="Primary actions">
      <button data-open-strategist-modal class="btn btn-primary btn-primary-enhanced" style="display: inline-flex; align-items: center; justify-content: center; text-align: center;" aria-describedby="strategy-description">
        <span class="btn-text-main">Book Free Strategy Call</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 8px;">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
        <span id="strategy-description" class="sr-only">Book your free 30-minute strategy consultation</span>
      </button>
      <a href="/quiz" class="hero-crm-btn group" aria-describedby="crm-description">
        <div class="hero-crm-content">
          <div class="hero-crm-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7v10c0 5.55 3.84 10 9 10s9-4.45 9-10V7L12 2z"/>
              <path d="M8 11l4 4 8-8"/>
            </svg>
          </div>
          <span class="hero-crm-text">Take Our Quiz</span>
          <div class="hero-crm-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17l9.2-9.2M17 17V7H7"/>
            </svg>
          </div>
        </div>
        <div class="hero-crm-glow"></div>
        <span id="crm-description" class="sr-only">Take our free business automation quiz</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Enhanced hero video stability */
  .stable-hero-video {
    visibility: hidden; /* Hide until loaded to prevent flicker */
    background: transparent;
    transform: translateZ(0); /* Force hardware acceleration */
    -webkit-transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    perspective: 1000px;
    -webkit-perspective: 1000px;
    image-rendering: optimizeQuality;
    transition: opacity 0.4s ease-in-out;
  }
  
  .stable-hero-video.loaded {
    visibility: visible;
  }
  
  /* Prevent video flickering during load */
  .stable-hero-video:not(.loaded) {
    opacity: 0 !important;
  }
  
  .stable-hero-video.loaded {
    opacity: 1 !important;
  }
  
  /* Ensure video maintains quality */
  .stable-hero-video {
    object-position: center center;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: optimize-contrast;
  }
  
  /* Mobile optimizations */
  @media (max-width: 768px) {
    .stable-hero-video {
      transform: translate3d(0, 0, 0); /* Better mobile performance */
      -webkit-transform: translate3d(0, 0, 0);
    }
  }
</style>

<style>
/* Enhanced Primary CTA Styling */
.btn-primary-enhanced {
  position: relative;
  min-width: 240px;
  min-height: 56px;
  font-size: 1.0625rem;
  font-weight: 600;
  background: linear-gradient(135deg, #8b5cf6 0%, #6E00FF 100%);
  box-shadow: 
    0 8px 32px rgba(139, 92, 246, 0.4),
    0 4px 16px rgba(110, 0, 255, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);
  border: 2px solid rgba(255, 255, 255, 0.15);
  transform: scale(1);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn-primary-enhanced:hover {
  transform: translateY(-2px) scale(1.03);
  box-shadow: 
    0 12px 40px rgba(139, 92, 246, 0.5),
    0 6px 20px rgba(110, 0, 255, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.3);
  background: linear-gradient(135deg, #9b6df6 0%, #7E10FF 100%);
}

.btn-primary-enhanced:active {
  transform: translateY(0) scale(0.98);
}

/* Urgency indicator responsive styles */
.hero-content .inline-flex {
  animation: pulse-subtle 3s ease-in-out infinite;
}

@keyframes pulse-subtle {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.85; }
}

@media (prefers-reduced-motion: reduce) {
  .btn-primary-enhanced {
    transition: none;
    animation: none;
  }
  .btn-primary-enhanced:hover {
    transform: none;
  }
  .hero-content .inline-flex {
    animation: none;
  }
}

/* Mobile responsive for buttons */
@media (max-width: 640px) {
  /* Ensure button container stacks properly on mobile */
  .hero-content .flex {
    gap: var(--space-4);
    max-width: 100%;
    margin-bottom: var(--space-7);
  }
  
  .btn-primary-enhanced {
    min-width: 200px;
    min-height: 52px;
    font-size: 1rem;
  }
  
  .hero-content .inline-flex span {
    font-size: 0.8125rem;
  }
}

/* Extra small screens */
@media (max-width: 480px) {
  .hero-crm-btn {
    min-width: 160px;
    border-radius: var(--radius-button);
  }

  .hero-crm-content {
    padding: var(--space-3) var(--space-4);
    gap: var(--space-2);
  }

  .hero-crm-icon {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
  }

  .hero-crm-text {
    font-size: 0.8rem;
  }

  .hero-crm-glow {
    border-radius: var(--radius-xl);
  }
}

/* ZeroMotion CRM Button Styling */
.hero-crm-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  text-align: center;
  white-space: normal;
  overflow-wrap: break-word;
  word-break: break-word;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(75, 0, 255, 0.08));
  border: 1px solid rgba(139, 92, 246, 0.4);
  border-radius: 28px;
  color: white;
  text-decoration: none;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow:
    0 12px 40px rgba(139, 92, 246, 0.3),
    0 4px 16px rgba(139, 92, 246, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.15);
  min-width: 200px;
  transform-style: preserve-3d;
  will-change: transform, box-shadow;
}

.hero-crm-btn:hover {
  transform: translateY(-3px) scale(1.02);
  border-color: rgba(139, 92, 246, 0.6);
  box-shadow:
    0 16px 50px rgba(139, 92, 246, 0.4),
    0 6px 20px rgba(139, 92, 246, 0.25),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.25), rgba(75, 0, 255, 0.15));
}

.hero-crm-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  position: relative;
  z-index: 2;
  text-align: center;
}

.hero-crm-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  background: rgba(139, 92, 246, 0.2);
  border: 1px solid rgba(139, 92, 246, 0.3);
  border-radius: 12px;
  color: rgba(139, 92, 246, 0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: all 0.35s ease;
}

.hero-crm-btn:hover .hero-crm-icon {
  background: rgba(139, 92, 246, 0.3);
  border-color: rgba(139, 92, 246, 0.5);
  color: #8b5cf6;
  transform: scale(1.05);
}

.hero-crm-text {
  font-size: 0.875rem;
  font-weight: 500;
  color: white;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-crm-arrow {
  color: rgba(255, 255, 255, 0.7);
  transition: all 0.3s ease;
}

.hero-crm-btn:hover .hero-crm-arrow {
  color: #8b5cf6;
  transform: translate(2px, -2px);
}

.hero-crm-glow {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
  border-radius: 24px;
  pointer-events: none;
}

.hero-crm-btn:hover .hero-crm-glow {
  opacity: 1;
}

/* Mobile optimizations */
@media (max-width: 640px) {
  .hero-crm-btn {
    min-width: 180px;
    min-height: 52px;
    border-radius: var(--radius-button-hero);
  }

  .hero-crm-content {
    padding: var(--space-3) var(--space-5);
    gap: var(--space-2);
    justify-content: center;
    text-align: center;
  }

  .hero-crm-icon {
    width: 28px;
    height: 28px;
    border-radius: 10px;
  }

  .hero-crm-text {
    font-size: 0.85rem;
  }

  .hero-crm-glow {
    border-radius: 22px;
  }
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  .hero-crm-btn {
    transition: none;
  }

  .hero-crm-btn:hover {
    transform: none;
  }

  .hero-crm-btn:hover .hero-crm-icon {
    transform: none;
  }

  .hero-crm-btn:hover .hero-crm-arrow {
    transform: none;
  }
}

/* Touch active state for mobile */
.hero-crm-btn.touch-active {
  transform: translateY(-1px) scale(0.98);
  box-shadow:
    0 8px 32px rgba(139, 92, 246, 0.3),
    0 2px 12px rgba(139, 92, 246, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.15);
}
</style>

<script is:inline>
  // Enhanced mobile touch support for hero CRM button
  document.addEventListener('DOMContentLoaded', function() {
    const heroCrmBtn = document.querySelector('.hero-crm-btn');

    if (heroCrmBtn) {
      // Add touch event listeners for mobile for better touch feedback
      heroCrmBtn.addEventListener('touchstart', function(e) {
        this.classList.add('touch-active');
      }, { passive: true });

      heroCrmBtn.addEventListener('touchend', function(e) {
        this.classList.remove('touch-active');
      }, { passive: true });
    }
  });
</script>
