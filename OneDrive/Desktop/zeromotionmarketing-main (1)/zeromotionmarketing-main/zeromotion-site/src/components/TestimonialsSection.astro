---
// Testimonials data - You can expand this as you get more reviews
const testimonials = [
  {
    name: "Sarah Martinez",
    business: "Martinez Plumbing",
    location: "Houma, LA",
    rating: 5,
    text: "We were losing 20-30 calls a week. ZeroMotion's missed call text-back has captured every single one. Our booking rate went from 40% to 85% in the first month.",
    service: "Growth CRM"
  },
  {
    name: "James Thibodaux",
    business: "Thibodaux HVAC",
    location: "Thibodaux, LA",
    rating: 5,
    text: "The AI voice agent answers calls when we're slammed. Customers think it's a real person. We've booked 60+ appointments through it in 2 months without lifting a finger.",
    service: "Complete CRM"
  },
  {
    name: "Lisa Bergeron",
    business: "Bergeron Real Estate",
    location: "Terrebonne Parish",
    rating: 5,
    text: "ZeroMotion built our CRM automation and we went from 5 Google reviews to 50+ in 90 days. Our organic traffic tripled. Best investment we've made.",
    service: "Growth CRM"
  }
];
---

<section class="section-padding" id="testimonials">
  <div class="container-page">
    <div class="text-center mb-12 reveal">
      <h2 class="h2 mb-4">Louisiana Businesses Trust ZeroMotion CRM</h2>
      <p class="text-white/70 max-w-2xl mx-auto">
        Real results from real local businesses
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map((testimonial) => (
        <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300">
          <!-- Rating Stars -->
          <div class="flex gap-1 mb-4">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Testimonial Text -->
          <p class="text-white/90 mb-6 leading-relaxed">"{testimonial.text}"</p>

          <!-- Author Info -->
          <div class="border-t border-white/10 pt-4">
            <div class="font-semibold text-white">{testimonial.name}</div>
            <div class="text-sm text-white/60">{testimonial.business}</div>
            <div class="text-sm text-white/50">{testimonial.location}</div>
            <div class="inline-flex items-center gap-2 mt-2 px-3 py-1 rounded-full bg-primary/20 border border-primary/30 text-primary text-xs font-medium">
              {testimonial.service}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
