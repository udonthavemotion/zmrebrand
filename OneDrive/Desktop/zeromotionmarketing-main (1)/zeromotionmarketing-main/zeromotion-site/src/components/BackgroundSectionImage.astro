---
export interface Props {
  src: string;
  opacity?: number; // 0..1
  brightness?: number; // 0..2 (1 = normal)
  contrast?: number; // 0..2 (1 = normal)
}
const { src, opacity = 0.6, brightness = 1.2, contrast = 1.1 } = Astro.props as Props;
---

<section class="relative isolate">
  <img
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover stable-image ultra-quality-image"
    src={src}
    alt=""
    aria-hidden="true"
    style={`opacity:${opacity}; filter: brightness(${brightness}) contrast(${contrast}) saturate(1.3) hue-rotate(0deg) blur(0px); will-change: transform, filter;`}
    loading="eager"
  />
  <!-- Reduced gradient overlay for brighter appearance -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-black/20 via-transparent to-black/20"
  >
  </div>
  <slot />
</section>

<style is:global>
  /* Ultra-high quality image rendering */
  .ultra-quality-image {
    /* Advanced hardware acceleration for images */
    transform: translateZ(0) translate3d(0, 0, 0);
    -webkit-transform: translateZ(0) translate3d(0, 0, 0);
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    perspective: 1000px;
    -webkit-perspective: 1000px;

    /* Maximum quality rendering for images */
    image-rendering: -webkit-optimize-contrast;
    image-rendering: -moz-crisp-edges;
    image-rendering: optimize-contrast;
    image-rendering: crisp-edges;
    image-rendering: high-quality;

    /* Enhanced image quality settings */
    object-position: center center;
    object-fit: cover;

    /* Smooth transitions optimized for images */
    will-change: transform, filter, opacity;
    transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter 0.4s ease-out,
                transform 0.3s ease-out;

    /* Anti-aliasing for smooth images */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;

    /* Enhanced color rendering for images */
    color-rendering: optimizeQuality;
    shape-rendering: geometricPrecision;
  }

  /* Enhanced image stability and loading */
  .stable-image {
    visibility: visible; /* Images don't need to be hidden like videos */
    background: transparent;

    /* Enhanced loading transition for images */
    transition: opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                visibility 0.1s ease-in,
                filter 0.4s ease-out;
  }

  /* High-quality mobile optimizations for images */
  @media (max-width: 768px) {
    .ultra-quality-image {
      /* Optimized mobile rendering for images */
      transform: translate3d(0, 0, 0) translateZ(0);
      -webkit-transform: translate3d(0, 0, 0) translateZ(0);

      /* Mobile-specific image quality - enhanced for sharpness */
      image-rendering: -webkit-optimize-contrast;
      image-rendering: optimize-contrast;
      image-rendering: crisp-edges;

      /* Enhanced mobile performance for images */
      will-change: transform, opacity;
      transition: opacity 0.5s ease-out, filter 0.3s ease-out;

      /* Mobile quality preservation */
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
      -webkit-perspective: 1000px;
      perspective: 1000px;
    }

    .stable-image {
      transform: translate3d(0, 0, 0); /* Better mobile performance */
      -webkit-transform: translate3d(0, 0, 0);

      /* Enhanced mobile image quality */
      image-rendering: -webkit-optimize-contrast;
      image-rendering: optimize-contrast;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
    }
  }

  /* Small mobile devices - extra quality optimization */
  @media (max-width: 480px) {
    .ultra-quality-image {
      /* Force maximum quality on small screens */
      image-rendering: -webkit-optimize-contrast !important;
      image-rendering: optimize-contrast !important;

      /* Prevent quality degradation on small screens */
      min-width: 100%;
      min-height: 100%;
      object-fit: cover;
      object-position: center center;
    }

    .stable-image {
      /* Enhanced small screen quality */
      image-rendering: -webkit-optimize-contrast !important;
      image-rendering: optimize-contrast !important;
    }
  }

  /* High-resolution display optimizations for images */
  @media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
    .ultra-quality-image {
      /* Enhanced image quality for retina displays */
      image-rendering: -webkit-optimize-contrast;
      image-rendering: optimize-contrast;
    }
  }

  /* 4K display optimizations for images */
  @media (min-width: 2560px) {
    .ultra-quality-image {
      /* Maximum image quality for 4K displays */
      image-rendering: -webkit-optimize-contrast;
      image-rendering: optimize-contrast;
    }
  }

  /* Enhanced color gamut support for images */
  @media (color-gamut: p3) {
    .ultra-quality-image {
      filter: brightness(1.2) contrast(1.25) saturate(1.35) hue-rotate(0deg) blur(0px);
    }
  }

  @media (color-gamut: rec2020) {
    .ultra-quality-image {
      filter: brightness(1.22) contrast(1.28) saturate(1.38) hue-rotate(0deg) blur(0px);
    }
  }
</style>
