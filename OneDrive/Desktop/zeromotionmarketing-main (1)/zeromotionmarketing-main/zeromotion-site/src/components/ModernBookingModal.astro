---
// Modern Booking Modal Component for ZRM CRM Calendar
// 🔒 LOCKED: This component is production-ready and should not be modified
// Form integration and modal behavior are optimized for all scenarios
interface Props {
  plan?: string;
  triggerText?: string;
  triggerClass?: string;
}

const { plan = '', triggerText = 'Book Free Consultation', triggerClass = 'btn-primary' } = Astro.props;

// Get ZRM CRM configuration from environment variables
const widgetBase = import.meta.env.PUBLIC_WIDGET_BASE || import.meta.env.PUBLIC_GHL_CAL_BASE || 'https://link.zeromotionmarketing.com';
const calendarId = import.meta.env.PUBLIC_GHL_CALENDAR_ID || 'fr87zeXsZz80Eg05tQEV';
const bookingUrl = `${widgetBase}/widget/booking/${calendarId}`;
---

<!-- Booking Modal Trigger Button -->
<button
  id={`booking-trigger-${plan}`}
  class={triggerClass}
  onclick={`openBookingModal('${plan}')`}
  type="button"
  aria-describedby={`booking-trigger-description-${plan}`}
  aria-haspopup="dialog"
>
  {triggerText}
  <span id={`booking-trigger-description-${plan}`} class="sr-only">Opens booking consultation modal dialog</span>
</button>

<!-- Modern Booking Modal -->
<div
  id={plan ? `booking-modal-${plan}` : 'booking-modal-'}
  class="booking-modal-overlay"
  style="display: none; position: fixed; inset: 0; z-index: 2147483647; background: rgba(10, 10, 10, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`booking-modal-title-${plan}`}
  aria-describedby={`booking-modal-description-${plan}`}
  tabindex="-1"
>
  <!-- Modal Container -->
  <div class="booking-modal-container">
    <!-- Header -->
    <div class="booking-modal-header">
      <div>
        <h2 id={`booking-modal-title-${plan}`} class="booking-modal-title">Book Your Free Consultation</h2>
        <p id={`booking-modal-description-${plan}`} class="booking-modal-subtitle">Let's discuss your project and create a custom strategy</p>
      </div>
      <button
        class="booking-modal-close"
        onclick={`closeBookingModal('${plan}')`}
        aria-label="Close booking modal"
        type="button"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Booking Content -->
    <div class="booking-modal-content">
      <iframe
        src={bookingUrl}
        style="width: 100%; height: 100%; border: none; background: transparent; margin: 0; padding: 0;"
        scrolling="auto"
        id={`consultation-iframe-${plan}`}
        title="Book Free Consultation"
        frameborder="0"
        allowtransparency="true"
        onload="this.style.border='none'; this.style.outline='none'; this.style.boxShadow='none';"
      ></iframe>
    </div>
  </div>
</div>

<!-- Booking Modal Styles -->
<style>
  .booking-modal-overlay {
    animation: modalFadeIn 0.3s ease-out;
  }

  .booking-modal-overlay.closing {
    animation: modalFadeOut 0.3s ease-in forwards;
  }

  .booking-modal-container {
    position: relative;
    max-width: 900px;
    width: 95vw;
    max-height: 90vh;
    height: 80vh;
    margin: 5vh auto;
    background: linear-gradient(145deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    box-shadow:
      0 25px 50px rgba(0,0,0,0.5),
      0 0 0 1px rgba(110,0,255,0.1),
      inset 0 1px 0 rgba(255,255,255,0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    animation: modalSlideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .booking-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px 32px;
    background: linear-gradient(90deg, rgba(110,0,255,0.1), rgba(75,0,255,0.05));
    border-bottom: 1px solid rgba(255,255,255,0.1);
    flex-shrink: 0;
  }

  .booking-modal-title {
    font-size: 28px;
    font-weight: 600;
    color: white;
    margin: 0 0 8px 0;
    background: linear-gradient(135deg, #ffffff, rgba(255,255,255,0.8));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .booking-modal-subtitle {
    font-size: 16px;
    color: rgba(255,255,255,0.7);
    margin: 0;
    font-weight: 400;
  }

  .booking-modal-close {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 16px;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.8);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .booking-modal-close:hover {
    transform: translateY(-1px);
    background: rgba(139, 92, 246, 0.2);
    border-color: rgba(139, 92, 246, 0.4);
    color: white;
    box-shadow: 
      0 8px 24px rgba(139, 92, 246, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .booking-modal-content {
    flex: 1;
    padding: 0;
    margin: 0;
    background: #0a0a0a;
    overflow: hidden;
    position: relative;
    border-radius: 0 0 20px 20px;
  }

  .booking-modal-content iframe {
    background: transparent !important;
    border: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block;
    position: absolute;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100% !important;
    height: 100% !important;
    border-radius: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    box-sizing: border-box !important;
  }

  /* Additional override for any iframe styling issues */
  .booking-modal-content iframe * {
    box-sizing: border-box !important;
  }

  /* Ensure iframe content fills completely */
  .booking-modal-content iframe::-webkit-scrollbar {
    display: none;
  }

  .booking-modal-content iframe {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  /* Animations */
  @keyframes modalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes modalFadeOut {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes modalSlideIn {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Mobile Responsive - Enhanced for iPhone Compatibility */
  @media (max-width: 768px) {
    .booking-modal-overlay {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      height: 100dvh !important; /* Dynamic viewport height for mobile browsers */
      z-index: 2147483647 !important;
      overflow: hidden !important;
      backdrop-filter: blur(20px) !important;
      -webkit-backdrop-filter: blur(20px) !important;
    }

    .booking-modal-container {
      width: 100vw !important;
      height: 100vh !important;
      height: 100dvh !important; /* Dynamic viewport height */
      max-height: 100vh !important;
      max-height: 100dvh !important;
      max-width: 100vw !important;
      margin: 0 !important;
      border-radius: 0 !important;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .booking-modal-header {
      padding: max(20px, env(safe-area-inset-top, 20px)) 24px 20px;
      position: sticky;
      top: 0;
      background: linear-gradient(90deg, rgba(110,0,255,0.15), rgba(75,0,255,0.08));
      z-index: 10;
      flex-shrink: 0;
      min-height: 80px;
    }

    .booking-modal-title {
      font-size: 24px;
    }

    .booking-modal-content {
      flex: 1 !important;
      height: auto !important;
      max-height: none !important;
      min-height: 0 !important;
      overflow: auto !important;
      position: relative;
      -webkit-overflow-scrolling: touch !important;
      /* Add padding for safe area */
      padding-bottom: max(20px, env(safe-area-inset-bottom, 20px)) !important;
    }

    .booking-modal-content iframe {
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      min-height: 600px !important; /* Ensure minimum height for form content */
      position: relative !important; /* Changed from absolute to allow natural scrolling */
      border-radius: 0 !important;
      pointer-events: auto !important;
      touch-action: auto !important;
      -webkit-overflow-scrolling: touch !important;
      /* Enable scrolling within iframe */
      overflow: auto !important;
    }

    .booking-modal-close {
      width: 52px;
      height: 52px;
      position: relative;
      z-index: 20;
    }
  }

  @media (max-width: 480px) {
    .booking-modal-header {
      padding: 16px 20px;
    }

    .booking-modal-title {
      font-size: 20px;
    }

    .booking-modal-subtitle {
      font-size: 14px;
    }

    .booking-modal-header {
      padding-top: max(16px, env(safe-area-inset-top));
      padding-left: max(20px, env(safe-area-inset-left));
      padding-right: max(20px, env(safe-area-inset-right));
    }

    .booking-modal-close {
      width: 56px;
      height: 56px;
    }
  }

  /* Touch active state for mobile */
  .booking-modal-close.touch-active,
  [id^="booking-trigger"].touch-active {
    transform: translateY(-1px) scale(0.98);
    box-shadow:
      0 8px 32px rgba(139, 92, 246, 0.3),
      0 2px 12px rgba(139, 92, 246, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }
</style>

<!-- Booking Modal JavaScript -->
<script is:inline>
  // Initialize booking modal functions only once
  if (!window.bookingModalInitialized) {
    window.bookingModalInitialized = true;

    // Enhanced mobile touch support
    document.addEventListener('DOMContentLoaded', function() {
      // Add touch event listeners for mobile booking buttons
      const bookingButtons = document.querySelectorAll('[id^="booking-trigger"]');
      bookingButtons.forEach(button => {
        // Add touch event listeners for mobile
        button.addEventListener('touchstart', function(e) {
          e.preventDefault();
          this.classList.add('touch-active');
        }, { passive: false });

        button.addEventListener('touchend', function(e) {
          e.preventDefault();
          this.classList.remove('touch-active');
          // Extract plan from button ID
          const buttonId = this.id;
          const plan = buttonId.replace('booking-trigger-', '');
          window.openBookingModal(plan);
        }, { passive: false });
      });

      // Enhanced modal close button handling for mobile
      const bookingModals = document.querySelectorAll('[id^="booking-modal"]');
      bookingModals.forEach(modal => {
        const closeBtn = modal.querySelector('.booking-modal-close');
        if (closeBtn) {
          // Add touch event listeners for mobile
          closeBtn.addEventListener('touchstart', function(e) {
            e.preventDefault();
            this.classList.add('touch-active');
          }, { passive: false });

          closeBtn.addEventListener('touchend', function(e) {
            e.preventDefault();
            this.classList.remove('touch-active');
            // Extract plan from modal ID
            const modalId = modal.id;
            const plan = modalId.replace('booking-modal-', '');
            window.closeBookingModal(plan);
          }, { passive: false });
        }

        // Enhanced click outside to close with touch support
        modal.addEventListener('touchstart', function(e) {
          if (e.target === this) {
            e.preventDefault();
            const modalId = this.id;
            const plan = modalId.replace('booking-modal-', '');
            window.closeBookingModal(plan);
          }
        }, { passive: false });
      });
    });
    
    // Focus trap utility for modal accessibility
    function setupFocusTrap(modal) {
      const focusableElements = modal.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      const firstFocusable = focusableElements[0];
      const lastFocusable = focusableElements[focusableElements.length - 1];
      
      function trapFocus(e) {
        if (e.key === 'Tab') {
          if (e.shiftKey) {
            if (document.activeElement === firstFocusable) {
              e.preventDefault();
              lastFocusable.focus();
            }
          } else {
            if (document.activeElement === lastFocusable) {
              e.preventDefault();
              firstFocusable.focus();
            }
          }
        }
      }
      
      modal.addEventListener('keydown', trapFocus);
      
      // Store the trap function to remove it later
      modal._focusTrap = trapFocus;
    }
    
    function removeFocusTrap(modal) {
      if (modal._focusTrap) {
        modal.removeEventListener('keydown', modal._focusTrap);
        delete modal._focusTrap;
      }
    }
    
    // Global modal functions
    window.openBookingModal = function(plan = '') {
      const modalId = plan ? `booking-modal-${plan}` : 'booking-modal-';
      const modal = document.getElementById(modalId);
      if (modal) {
        // Store the element that opened the modal for focus restoration
        const activeElement = document.activeElement;
        modal.setAttribute('data-previous-focus', activeElement?.id || '');
        
        // Store current scroll position for restoration
        const scrollY = window.scrollY;
        
        modal.style.display = 'block';
        
        // Prevent body scroll with mobile optimizations
        if (window.innerWidth <= 768) {
          // Mobile: lock scroll but allow iframe interaction
          document.body.style.position = 'fixed';
          document.body.style.top = `-${scrollY}px`;
          document.body.style.left = '0';
          document.body.style.right = '0';
          document.body.style.width = '100%';
          document.body.style.overflow = 'hidden';
          // Don't lock document element overflow to allow iframe scrolling
          // Store scroll position for later restoration
          modal.setAttribute('data-scroll-y', scrollY.toString());
        } else {
          // Desktop: just prevent body scroll
          document.body.style.overflow = 'hidden';
        }
        
        // Focus the modal for screen readers
        modal.focus();
        
        // Focus the close button after modal opens
        setTimeout(() => {
          const closeButton = modal.querySelector('.booking-modal-close');
          if (closeButton) {
            closeButton.focus();
          }
        }, 100);

        // Ensure iframe fills container properly with mobile optimizations
        const iframe = modal.querySelector('iframe');
        if (iframe) {
          // Force iframe to resize after modal opens
          setTimeout(() => {
            iframe.style.width = '100%';
            iframe.style.height = '100%';
            iframe.style.top = '0';
            iframe.style.left = '0';
            iframe.style.right = '0';
            iframe.style.bottom = '0';
            iframe.style.borderRadius = '0';
            iframe.style.outline = 'none';
            iframe.style.boxShadow = 'none';

            // Force a reflow to ensure proper sizing
            iframe.offsetHeight;
          }, 100);

          // Handle iframe loading errors
          iframe.addEventListener('error', function() {
            console.error('Booking iframe failed to load');
          });

          // Ensure iframe content loads properly
          iframe.addEventListener('load', function() {
            console.log('Booking iframe loaded successfully');
          });
        }

        // Track modal open
        if (window.dataLayer) {
          window.dataLayer.push({
            event: 'booking_modal_open',
            plan_type: plan || 'general',
            timestamp: Date.now()
          });
        }
        
        // Setup focus trapping
        setupFocusTrap(modal);
      } else {
        console.warn(`Booking modal not found: ${modalId}`);
      }
    };

    window.closeBookingModal = function(plan = '') {
      const modalId = plan ? `booking-modal-${plan}` : 'booking-modal-';
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.add('closing');
        
        // Restore focus to the element that opened the modal
        const previousFocusId = modal.getAttribute('data-previous-focus');
        const previousFocusElement = previousFocusId ? document.getElementById(previousFocusId) : null;
        
        setTimeout(() => {
          modal.style.display = 'none';
          modal.classList.remove('closing');
          
          // Restore body scroll with mobile optimizations
          if (window.innerWidth <= 768) {
            // Mobile: restore all locked styles and scroll position
            const scrollY = modal.getAttribute('data-scroll-y') || '0';
            document.body.style.position = '';
            document.body.style.top = '';
            document.body.style.left = '';
            document.body.style.right = '';
            document.body.style.width = '';
            document.body.style.overflow = '';
            // Restore scroll position smoothly
            window.scrollTo(0, parseInt(scrollY));
            // Clear stored scroll position
            modal.removeAttribute('data-scroll-y');
          } else {
            // Desktop: just restore body scroll
            document.body.style.overflow = '';
          }
          
          // Remove focus trap
          removeFocusTrap(modal);
          
          // Restore focus
          if (previousFocusElement) {
            previousFocusElement.focus();
          }
        }, 300);
      }
    };

    // Close on escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        const openModals = document.querySelectorAll('.booking-modal-overlay[style*="display: block"]');
        openModals.forEach(function(modal) {
          const plan = modal.id.replace('booking-modal-', '');
          window.closeBookingModal(plan);
        });
      }
    });

    // Close on backdrop click
    document.addEventListener('click', function(e) {
      if (e.target && e.target.classList && e.target.classList.contains('booking-modal-overlay')) {
        const plan = e.target.id.replace('booking-modal-', '');
        window.closeBookingModal(plan);
      }
    });
  }
</script>

<script src="https://link.zeromotionmarketing.com/js/form_embed.js" type="text/javascript"></script>
