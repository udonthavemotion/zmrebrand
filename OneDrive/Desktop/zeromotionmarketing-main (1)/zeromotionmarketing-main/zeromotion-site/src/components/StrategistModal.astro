---
// Strategist Consultation Modal Component - Reusable across all pages
// 🔒 LOCKED: This component is production-ready and should not be modified
// Modal z-index and form integration are optimized for all devices

// Get ZRM CRM configuration from environment variables
const widgetBase = import.meta.env.PUBLIC_WIDGET_BASE || import.meta.env.PUBLIC_GHL_CAL_BASE || 'https://link.zeromotionmarketing.com';
const calendarId = import.meta.env.PUBLIC_GHL_CALENDAR_ID || 'fr87zeXsZz80Eg05tQEV';
const bookingUrl = `${widgetBase}/widget/booking/${calendarId}`;
const calendarScript = import.meta.env.PUBLIC_GHL_CALENDAR_SCRIPT || '/js/booking_embed.js';
const calendarScriptUrl = `${widgetBase}${calendarScript}`;
---

<!-- Strategist Consultation Modal -->
<div
  id="strategist-modal"
  class="strategist-modal-overlay"
  style="display: none; position: fixed; inset: 0; z-index: 2147483647; background: rgba(10, 10, 10, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);"
  role="dialog"
  aria-modal="true"
  tabindex="-1"
>
  <!-- Modal Container -->
  <div class="strategist-modal-container">
    <!-- Header -->
    <div class="strategist-modal-header">
      <div>
        <h2 class="strategist-modal-title">Talk to a ZeroMotion Strategist</h2>
        <p class="strategist-modal-subtitle">Get expert guidance • Louisiana business focus • Free consultation</p>
      </div>
      <button
        class="strategist-modal-close"
        onclick="closeStrategistModal()"
        aria-label="Close strategist consultation modal"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Strategist Form Content -->
    <div class="strategist-modal-content">
      <iframe
        src={bookingUrl}
        style="width: 100%; height: 100%; border: none; background: transparent; margin: 0; padding: 0; display: block; position: absolute; top: 0; left: 0;"
        scrolling="auto"
        id="strategist-consultation-iframe"
        title="Book Strategist Consultation"
        frameborder="0"
        allowtransparency="true"
      ></iframe>
    </div>
  </div>
</div>

<!-- Strategist Modal Styles -->
<style>
  .strategist-modal-overlay {
    animation: strategistModalFadeIn 0.3s ease-out;
  }

  .strategist-modal-overlay.closing {
    animation: strategistModalFadeOut 0.3s ease-in forwards;
  }

  .strategist-modal-container {
    position: relative;
    max-width: 900px;
    width: 95vw;
    max-height: 90vh;
    height: 80vh;
    margin: 5vh auto;
    background: linear-gradient(145deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    box-shadow:
      0 25px 50px rgba(0,0,0,0.5),
      0 0 0 1px rgba(110,0,255,0.1),
      inset 0 1px 0 rgba(255,255,255,0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    animation: strategistModalSlideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .strategist-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px 32px;
    background: linear-gradient(90deg, rgba(110,0,255,0.1), rgba(75,0,255,0.05));
    border-bottom: 1px solid rgba(255,255,255,0.1);
    flex-shrink: 0;
  }

  .strategist-modal-title {
    font-size: 28px;
    font-weight: 600;
    color: white;
    margin: 0 0 8px 0;
    background: linear-gradient(135deg, #ffffff, rgba(255,255,255,0.8));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .strategist-modal-subtitle {
    font-size: 16px;
    color: rgba(255,255,255,0.7);
    margin: 0;
    font-weight: 400;
  }

  .strategist-modal-close {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 24px;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.8);
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 
      0 8px 24px rgba(0, 0, 0, 0.15),
      0 2px 8px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    transform-style: preserve-3d;
    will-change: transform, box-shadow;
  }

  .strategist-modal-close:hover {
    transform: translateY(-2px) scale(1.05);
    background: rgba(139, 92, 246, 0.2);
    border-color: rgba(139, 92, 246, 0.4);
    color: white;
    box-shadow: 
      0 12px 32px rgba(139, 92, 246, 0.2),
      0 4px 16px rgba(139, 92, 246, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }

  .strategist-modal-content {
    flex: 1;
    padding: 0;
    margin: 0;
    background: #0a0a0a;
    overflow: hidden;
    position: relative;
    border-radius: 0 0 20px 20px;
  }

  .strategist-modal-content iframe {
    background: transparent !important;
    border: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    border-radius: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    box-sizing: border-box !important;
  }

  /* Modal Animations */
  @keyframes strategistModalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes strategistModalFadeOut {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes strategistModalSlideIn {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Mobile Responsive - Enhanced for iPhone Compatibility */
  @media (max-width: 768px) {
    .strategist-modal-overlay {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      height: 100dvh !important; /* Dynamic viewport height for mobile browsers */
      z-index: 2147483647 !important;
      overflow: hidden !important;
      backdrop-filter: blur(20px) !important;
      -webkit-backdrop-filter: blur(20px) !important;
    }

    .strategist-modal-container {
      width: 100vw !important;
      height: 100vh !important;
      height: 100dvh !important; /* Dynamic viewport height */
      max-height: 100vh !important;
      max-height: 100dvh !important;
      max-width: 100vw !important;
      margin: 0 !important;
      border-radius: 0 !important;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .strategist-modal-header {
      padding: max(20px, env(safe-area-inset-top, 20px)) 24px 20px;
      position: sticky;
      top: 0;
      background: linear-gradient(90deg, rgba(110,0,255,0.15), rgba(75,0,255,0.08));
      z-index: 10;
      flex-shrink: 0;
      min-height: 80px;
    }

    .strategist-modal-title {
      font-size: 24px;
    }

    .strategist-modal-content {
      flex: 1 !important;
      height: auto !important;
      max-height: none !important;
      min-height: 0 !important;
      overflow: auto !important;
      position: relative;
      -webkit-overflow-scrolling: touch !important;
      /* Add padding for safe area */
      padding-bottom: max(20px, env(safe-area-inset-bottom, 20px)) !important;
    }

    .strategist-modal-content iframe {
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      min-height: 600px !important; /* Ensure minimum height for form content */
      position: relative !important; /* Changed from absolute to allow natural scrolling */
      border-radius: 0 !important;
      pointer-events: auto !important;
      touch-action: auto !important;
      -webkit-overflow-scrolling: touch !important;
      /* Enable scrolling within iframe */
      overflow: auto !important;
    }

    .strategist-modal-close {
      width: 52px;
      height: 52px;
      position: relative;
      z-index: 20;
    }
  }

  @media (max-width: 480px) {
    .strategist-modal-header {
      padding: 16px 20px;
      padding-top: max(16px, env(safe-area-inset-top));
      padding-left: max(20px, env(safe-area-inset-left));
      padding-right: max(20px, env(safe-area-inset-right));
    }

    .strategist-modal-title {
      font-size: 20px;
    }

    .strategist-modal-subtitle {
      font-size: 14px;
    }

    .strategist-modal-close {
      width: 56px;
      height: 56px;
    }
  }
</style>

<!-- JavaScript -->
<script is:inline>
  // Global Strategist Modal Functions
  window.openStrategistModal = function(source = 'unknown') {
    const modal = document.getElementById('strategist-modal');
    let touchStartY = 0;
    let touchActive = false;
    if (modal) {
      // Store current scroll position for restoration
      const scrollY = window.scrollY;
      
      modal.style.display = 'block';
      
      // Prevent body scroll with mobile optimizations
      if (window.innerWidth <= 768) {
        // Mobile: completely lock scroll and viewport
        document.body.style.position = 'fixed';
        document.body.style.top = `-${scrollY}px`;
        document.body.style.left = '0';
        document.body.style.right = '0';
        document.body.style.width = '100%';
        document.body.style.height = '100%';
        document.body.style.overflow = 'hidden';
        document.documentElement.style.overflow = 'hidden';
        // Store scroll position for later restoration
        modal.setAttribute('data-scroll-y', scrollY.toString());
      } else {
        // Desktop: just prevent body scroll
        document.body.style.overflow = 'hidden';
      }

      // Track modal open with source
      if (window.dataLayer) {
        window.dataLayer.push({
          event: 'strategist_modal_open',
          button_location: source,
          timestamp: Date.now()
        });
      }

      // Focus management for accessibility
      const closeBtn = modal.querySelector('.strategist-modal-close');
      if (closeBtn) {
        setTimeout(() => closeBtn.focus(), 100);
      }

      // Ensure iframe fills container properly
      const iframe = modal.querySelector('iframe');
      if (iframe) {
        setTimeout(() => {
          iframe.style.width = '100%';
          iframe.style.height = '100%';
          iframe.style.top = '0';
          iframe.style.left = '0';
        }, 100);
      }
    }
  };

  window.closeStrategistModal = function() {
    const modal = document.getElementById('strategist-modal');
    if (modal) {
      modal.classList.add('closing');
      setTimeout(() => {
        modal.style.display = 'none';
        modal.classList.remove('closing');
        
        // Restore body scroll with mobile optimizations
        if (window.innerWidth <= 768) {
          // Mobile: restore all locked styles and scroll position
          const scrollY = modal.getAttribute('data-scroll-y') || '0';
          document.body.style.position = '';
          document.body.style.top = '';
          document.body.style.left = '';
          document.body.style.right = '';
          document.body.style.width = '';
          document.body.style.height = '';
          document.body.style.overflow = '';
          document.documentElement.style.overflow = '';
          // Restore scroll position smoothly
          window.scrollTo(0, parseInt(scrollY));
          // Clear stored scroll position
          modal.removeAttribute('data-scroll-y');
        } else {
          // Desktop: just restore body scroll
          document.body.style.overflow = '';
        }
      }, 300);

      // Track modal close
      if (window.dataLayer) {
        window.dataLayer.push({
          event: 'strategist_modal_close',
          timestamp: Date.now()
        });
      }
    }
  };

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', function() {
    // Keyboard navigation for accessibility
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        const modal = document.getElementById('strategist-modal');
        if (modal && modal.style.display === 'block') {
          closeStrategistModal();
        }
      }
    });

    // Click outside to close
    document.addEventListener('click', function(e) {
      const modal = document.getElementById('strategist-modal');
      if (modal && modal.style.display === 'block' && e.target === modal) {
        closeStrategistModal();
      }
    });

    // iOS-safe touch handlers
    const modal = document.getElementById('strategist-modal');
    if (modal) {
      const closeBtn = modal.querySelector('.strategist-modal-close');
      const container = modal.querySelector('.strategist-modal-container');
      if (closeBtn) {
        closeBtn.addEventListener('touchstart', function(e) {
          e.preventDefault();
          closeStrategistModal();
        }, { passive: false });
      }
      // Backdrop touch to close
      modal.addEventListener('touchstart', function(e) {
        if (e.target === modal) {
          e.preventDefault();
          closeStrategistModal();
        }
      }, { passive: false });
      // Swipe down to close
      container?.addEventListener('touchstart', function(e) {
        if (!e.touches || e.touches.length === 0) return;
        touchActive = true;
        touchStartY = e.touches[0].clientY;
      }, { passive: true });
      container?.addEventListener('touchmove', function(e) {
        if (!touchActive || !e.touches || e.touches.length === 0) return;
        const deltaY = e.touches[0].clientY - touchStartY;
        if (deltaY > 60) {
          touchActive = false;
          closeStrategistModal();
        }
      }, { passive: true });
      container?.addEventListener('touchend', function() {
        touchActive = false;
      }, { passive: true });
    }

    // Ensure iframe loads properly
    const strategistIframe = document.getElementById('strategist-consultation-iframe');
    if (strategistIframe) {
      strategistIframe.addEventListener('load', function() {
        console.log('Strategist consultation iframe loaded successfully');
      });
    }

    // Handle buttons with data-open-strategist-modal attribute (Hero and Mobile Sticky CTA)
    const strategistModalButtons = document.querySelectorAll('[data-open-strategist-modal]');
    strategistModalButtons.forEach(function(button) {
      button.addEventListener('click', function(e) {
        e.preventDefault();

        // Get source information for analytics
        const source = button.getAttribute('data-source') ||
                      button.closest('section')?.id ||
                      button.closest('[class*="section"]')?.className?.split(' ')[0] ||
                      button.classList.contains('mobile-cta-button') ? 'mobile-sticky-cta' :
                      button.classList.contains('btn-primary-enhanced') ? 'hero-cta' :
                      'strategist-modal-button';

        openStrategistModal(source);
      });
    });

    // Update existing "Talk to a Strategist" buttons to use the modal
    const strategistButtons = document.querySelectorAll('a[href="#consultation-booking"], a[href*="Talk to Strategist"], a[href*="Talk to a Strategist"]');
    strategistButtons.forEach(function(button) {
      // Only update buttons that contain "strategist" text
      if (button.textContent && button.textContent.toLowerCase().includes('strategist')) {
        button.addEventListener('click', function(e) {
          e.preventDefault();

          // Get source information for analytics
          const source = button.getAttribute('data-source') ||
                        button.closest('section')?.id ||
                        button.closest('[class*="section"]')?.className?.split(' ')[0] ||
                        'unknown_section';

          openStrategistModal(source);
        });
      }
    });

    // Also handle buttons that might be added dynamically or have onclick handlers
    document.addEventListener('click', function(e) {
      const button = e.target.closest('a, button');
      if (button && button.textContent && button.textContent.toLowerCase().includes('talk to') && button.textContent.toLowerCase().includes('strategist')) {
        // Check if it's not already handled and doesn't have a specific href
        if (button.getAttribute('href') === '#consultation-booking' || 
            button.getAttribute('href') === '#' || 
            !button.getAttribute('href')) {
          e.preventDefault();
          
          const source = button.getAttribute('data-source') || 
                        button.closest('section')?.id || 
                        button.closest('[class*="section"]')?.className?.split(' ')[0] || 
                        'dynamic_button';
          
          openStrategistModal(source);
        }
      }
    });
  });
</script>

<script define:vars={{ calendarScriptUrl }} type="text/javascript">
  // Dynamically load ZRM calendar embed script
  const script = document.createElement('script');
  script.src = calendarScriptUrl;
  script.type = 'text/javascript';
  document.body.appendChild(script);
</script>
