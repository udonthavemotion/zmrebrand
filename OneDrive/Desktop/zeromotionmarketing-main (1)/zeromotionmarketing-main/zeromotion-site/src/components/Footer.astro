---
// Standardized Footer with Local SEO Schema
---

<footer
  class="relative border-t border-white/10 overflow-hidden footer-bg footer--sticky"
  aria-labelledby="footer-title"
  style="background: linear-gradient(135deg, #0d0d1a 0%, #1a1a2e 50%, #0d0d1a 100%) !important; background-image: none !important; z-index: 10; position: relative;"
  id="main-footer"
>

  <div class="relative container-page">
    <div class="flex flex-col md:flex-row justify-between items-start gap-3 mb-1">
      <!-- Logo and Contact -->
      <div class="flex-1">
        <h2 id="footer-title" class="sr-only">Footer</h2>
        <picture>
          <source srcset="/optimized/brand/ZeroMotion-Layerstyle.webp" type="image/webp" />
          <img
            src="/brand/ZeroMotion-Layerstyle.png"
            alt="ZeroMotion Marketing - AI-powered digital marketing solutions for Louisiana businesses"
            class="footer-logo h-2.5 w-auto opacity-95 mb-1.5"
            loading="lazy"
            style="position: relative; z-index: 1;"
            width="1342"
            height="468"
          />
        </picture>
        <p class="text-white/80 text-sm mb-2 max-w-sm">
          Empowering Louisiana businesses with AI-driven digital solutions and strategic marketing that drives real results.
        </p>
        <!-- Contact (NAP) -->
        <div class="mb-3">
          <h3 class="text-sm font-semibold text-white/90 mb-2">Contact</h3>
          <div class="flex flex-col gap-0.5 text-sm">
            <a
              href="mailto:zeromotionmarketing@gmail.com"
              class="text-white/70 hover:text-white transition-colors"
            >
              zeromotionmarketing@gmail.com
            </a>
            <a
              href="tel:+19853032016"
              class="text-white/70 hover:text-white transition-colors"
            >
              (985) 303-2016
            </a>
            <span class="text-white/60">Houma, Louisiana</span>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="flex flex-col gap-3">
        <div>
          <h3 class="text-sm font-semibold text-white/90 mb-2">Digital Marketing Services</h3>
          <div class="flex flex-col gap-0.5">
            <a href="/services/brand-identity" class="text-sm text-white/70 hover:text-white transition-colors" title="Professional Brand Identity & Logo Design for Louisiana Businesses">Brand Identity Design</a>
            <a href="/services/web-design" class="text-sm text-white/70 hover:text-white transition-colors" title="Custom Web Design Services in Houma and Thibodaux">Professional Web Design</a>
            <a href="/services/crm" class="text-sm text-white/70 hover:text-white transition-colors" title="ZRM CRM Automation for Louisiana Businesses">CRM Automation</a>
            <a href="/services/ai-integration" class="text-sm text-white/70 hover:text-white transition-colors" title="AI Marketing Automation and Lead Generation">AI Marketing Integration</a>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-white/90 mb-2">Louisiana Business Solutions</h3>
          <div class="flex flex-col gap-0.5">
            <a href="/about" class="text-sm text-white/70 hover:text-white transition-colors" title="About ZeroMotion Marketing - Digital Marketing Agency in Houma, LA">About Our Agency</a>
            <a href="/pricing" class="text-sm text-white/70 hover:text-white transition-colors" title="Transparent Pricing for Digital Marketing Services in Louisiana">Pricing & Plans</a>
            <a href="/plans/starter" class="text-sm text-white/70 hover:text-white transition-colors" title="Starter Website Package for New Louisiana Businesses">Starter Website Package</a>
            <a href="/plans/growth" class="text-sm text-white/70 hover:text-white transition-colors" title="Growth Marketing Plan for Expanding Louisiana Businesses">Growth Marketing Plan</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Business Transparency Section -->
    <div class="border-t border-white/10 pt-4 mb-4">
      <div class="grid md:grid-cols-3 gap-6 mb-4">
        <!-- Business Information -->
        <div>
          <h3 class="text-sm font-semibold text-white/90 mb-3">Business Information</h3>
          <div class="text-sm text-white/70 space-y-1">
            <p><strong>Legal Name:</strong> ZeroMotion Marketing LLC</p>
            <p><strong>Business Address:</strong> Houma, Louisiana, USA</p>
            <p><strong>Business Phone:</strong> (985) 217-0368</p>
            <p><strong>Business Email:</strong> zeromotionmarketing@gmail.com</p>
            <p><strong>Year Established:</strong> 2024</p>
          </div>
        </div>

        <!-- Compliance & Legal -->
        <div>
          <h3 class="text-sm font-semibold text-white/90 mb-3">Compliance & Legal</h3>
          <div class="text-sm text-white/70 space-y-1">
            <p><strong>GDPR:</strong> Compliant for EU users</p>
            <p><strong>CCPA:</strong> Compliant for CA residents</p>
            <p><strong>CAN-SPAM:</strong> Certified compliant</p>
            <p><strong>Data Security:</strong> SOC 2 Type II ready</p>
            <p><strong>Business License:</strong> Louisiana registered</p>
          </div>
        </div>

        <!-- Service Transparency -->
        <div>
          <h3 class="text-sm font-semibold text-white/90 mb-3">Service Transparency</h3>
          <div class="text-sm text-white/70 space-y-1">
            <p><strong>Service Area:</strong> Louisiana & surrounding</p>
            <p><strong>Response Time:</strong> &lt;24 hours</p>
            <p><strong>Support Hours:</strong> Mon-Fri 9AM-5PM CST</p>
            <p><strong>Contract Terms:</strong> Month-to-month</p>
            <p><strong>Payment Methods:</strong> All major cards</p>
          </div>
        </div>
      </div>

      <!-- Compliance Links -->
      <div class="flex flex-wrap gap-4 justify-center mb-4 text-sm">
        <a href="/privacy" class="text-primary hover:underline transition-colors">Privacy Policy</a>
        <span class="text-white/40">•</span>
        <a href="/terms" class="text-primary hover:underline transition-colors">Terms of Service</a>
        <span class="text-white/40">•</span>
        <a href="/cookies" class="text-primary hover:underline transition-colors">Cookie Policy</a>
        <span class="text-white/40">•</span>
        <a href="/disclaimer" class="text-primary hover:underline transition-colors">Legal Disclaimer</a>
        <span class="text-white/40">•</span>
        <a href="/unsubscribe" class="text-primary hover:underline transition-colors">Email Unsubscribe</a>
      </div>
    </div>

    <!-- Bottom section -->
    <div class="border-t border-white/10 pt-4 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-6 text-sm">
        <a
          href="https://instagram.com/zeromotion"
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/60 hover:text-white/80 transition-colors"
          aria-label="Follow us on Instagram"
        >
          Instagram
        </a>
        <a
          href="mailto:zeromotionmarketing@gmail.com"
          class="text-white/60 hover:text-white/80 transition-colors"
          aria-label="Contact our privacy officer"
        >
          Privacy Officer
        </a>
        <a
          href="tel:+19853032016"
          class="text-white/60 hover:text-white/80 transition-colors"
          aria-label="Call our business phone"
        >
          Support
        </a>
      </div>

      <div class="text-center md:text-right">
        <div class="text-[11px] text-white/50 mb-1">
          © {new Date().getFullYear()} ZeroMotion Marketing LLC. All rights reserved.
        </div>
        <div class="text-[10px] text-white/40">
          Built with precision • Registered in Louisiana • Licensed digital marketing agency
        </div>
      </div>
    </div>
  </div>

  <!-- Local SEO Schema -->
  <script type="application/ld+json" set:html={`
  [
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "ZeroMotion",
      "url": "https://zeromotionmarketing.com",
      "logo": "https://zeromotionmarketing.com/brand/ZeroMotion-Layerstyle.png",
      "description": "Empowering Louisiana businesses with AI-driven digital solutions and strategic marketing that drives real results.",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+1-985-303-2016",
        "contactType": "customer service",
        "email": "zeromotionmarketing@gmail.com"
      },
      "sameAs": [
        "https://instagram.com/zeromotion"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "ZeroMotion",
      "url": "https://zeromotionmarketing.com",
      "telephone": "+1-985-303-2016",
      "email": "zeromotionmarketing@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Houma",
        "addressRegion": "LA",
        "addressCountry": "US"
      },
      "areaServed": [
        {
          "@type": "GeoCircle",
          "geoMidpoint": {
            "@type": "GeoCoordinates",
            "latitude": 29.5958,
            "longitude": -90.7195
          },
          "geoRadius": 50000,
          "description": "Terrebonne Parish and surrounding areas"
        },
        {
          "@type": "GeoCircle",
          "geoMidpoint": {
            "@type": "GeoCoordinates",
            "latitude": 29.7958,
            "longitude": -90.8229
          },
          "geoRadius": 40000,
          "description": "Lafourche Parish and surrounding areas"
        }
      ],
      "serviceArea": {
        "@type": "Place",
        "name": "Louisiana Bayou Region",
        "addressRegion": "LA",
        "addressCountry": "US"
      },
      "priceRange": "$$",
      "description": "AI-powered web design and local marketing solutions for Louisiana businesses. Specializing in brand identity, web design, ad campaigns, and AI integration.",
      "image": "https://zeromotionmarketing.com/favico/android-chrome-512x512.png",
      "sameAs": [
        "https://instagram.com/zeromotion"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Digital Marketing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Brand & Identity",
              "description": "Complete brand identity design and implementation"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Web Design",
              "description": "AI-powered responsive web design and development"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Ad Campaigns",
              "description": "Strategic advertising campaigns for local businesses"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "AI Integration",
              "description": "Artificial intelligence integration for business automation"
            }
          }
        ]
      }
    }
  ]
  `} />
</footer>

<style>
  /* Ensure footer doesn't interfere with modals */
  #main-footer {
    position: relative;
    z-index: 10;
  }
  
  /* Hide footer when any modal is open */
  body:has([id*="modal"][style*="display: block"]) #main-footer {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    z-index: -1 !important;
  }
  
  /* Fallback for browsers that don't support :has() */
  @media (max-width: 768px) {
    .modal-open #main-footer {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      z-index: -1 !important;
    }
  }
</style>

