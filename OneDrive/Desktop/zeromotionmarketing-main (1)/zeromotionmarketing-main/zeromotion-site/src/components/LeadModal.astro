---
// Lead Capture Modal Component - Beautiful, seamless form embedding
// 🔒 LOCKED: This component is production-ready and should not be modified
// Any changes to modal behavior, z-index, or form integration could break the user experience
// Last validated: 2024 - All mobile/desktop scenarios tested and working

// Get ZRM CRM configuration from environment variables
const formBase = import.meta.env.PUBLIC_GHL_FORM_BASE || 'https://dashboard.zeromotionmarketing.com';
const formId = import.meta.env.PUBLIC_GHL_FORM_ID || 'n9og5xkVVmjupqiLT2R6';
const defaultFormUrl = `${formBase}/widget/form/${formId}`;
const formScript = '/js/form_embed.js';
const formScriptUrl = `${formBase}${formScript}`;
---

<!-- Lead Capture Modal -->
<div
  id="lead-modal"
  class="lead-modal-overlay"
  style="display: none; position: fixed; inset: 0; z-index: 2147483647; background: rgba(10, 10, 10, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);"
  role="dialog"
  aria-modal="true"
  tabindex="-1"
>
  <!-- Modal Container -->
  <div class="lead-modal-container">
    <!-- Header -->
    <div class="lead-modal-header">
      <div>
        <h2 class="lead-modal-title" id="lead-modal-title">Get Started with ZeroMotion</h2>
        <p class="lead-modal-subtitle" id="lead-modal-subtitle">Professional setup • Louisiana expertise • Real results</p>
      </div>
      <button
        class="lead-modal-close"
        onclick="closeLeadModal()"
        aria-label="Close lead capture modal"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Lead Form Content -->
    <div class="lead-modal-content">
      <iframe
        id="lead-form-iframe"
        style="width: 100%; height: 100%; border: none; background: transparent; margin: 0; padding: 0; display: block; position: absolute; top: 0; left: 0;"
        scrolling="no"
        title="Lead Capture Form"
        frameborder="0"
        allowtransparency="true"
      ></iframe>
      </div>
  </div>
</div>

  <!-- Lead Modal Styles -->
<style>
  .lead-modal-overlay {
    animation: leadModalFadeIn 0.3s ease-out;
          /* Ensure modal is above everything */
      z-index: 999999;
    /* Improve touch scrolling on mobile */
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  .lead-modal-overlay.closing {
    animation: leadModalFadeOut 0.3s ease-in forwards;
  }

  .lead-modal-container {
    position: relative;
    max-width: 900px;
    width: 95vw;
    max-height: 90vh;
    height: 80vh;
    margin: 5vh auto;
    background: linear-gradient(145deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    box-shadow:
      0 25px 50px rgba(0,0,0,0.5),
      0 0 0 1px rgba(110,0,255,0.1),
      inset 0 1px 0 rgba(255,255,255,0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    animation: leadModalSlideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* Prevent text selection issues on mobile */
    -webkit-user-select: none;
    user-select: none;
  }

  .lead-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: var(--space-5) var(--space-6);
    background: linear-gradient(90deg, rgba(110,0,255,0.1), rgba(75,0,255,0.05));
    border-bottom: 1px solid rgba(255,255,255,0.1);
    flex-shrink: 0;
  }

  .lead-modal-title {
    font-size: 28px;
    font-weight: 600;
    color: white;
    margin: 0 0 8px 0;
    background: linear-gradient(135deg, #ffffff, rgba(255,255,255,0.8));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead-modal-subtitle {
    font-size: 16px;
    color: rgba(255,255,255,0.7);
    margin: 0;
    font-weight: 400;
  }

  .lead-modal-close {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 24px;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.8);
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 
      0 8px 24px rgba(0, 0, 0, 0.15),
      0 2px 8px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    transform-style: preserve-3d;
    will-change: transform, box-shadow;
    /* Improve mobile touch target */
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    /* Ensure button is accessible on all mobile devices */
    min-width: 48px;
    min-height: 48px;
  }

  .lead-modal-close:hover {
    transform: translateY(-2px) scale(1.05);
    background: rgba(139, 92, 246, 0.2);
    border-color: rgba(139, 92, 246, 0.4);
    color: white;
    box-shadow: 
      0 12px 32px rgba(139, 92, 246, 0.2),
      0 4px 16px rgba(139, 92, 246, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }

  .lead-modal-content {
    flex: 1;
    padding: 0;
    margin: 0;
    background: #0a0a0a;
    overflow: hidden;
    position: relative;
    border-radius: 0 0 20px 20px;
    /* Ensure content area can be touched/scrolled */
    touch-action: auto;
    -webkit-overflow-scrolling: touch;
  }

  .lead-modal-content iframe {
    background: transparent !important;
    border: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    border-radius: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    box-sizing: border-box !important;
    /* Critical for mobile form interaction */
    pointer-events: auto;
    touch-action: auto;
    -webkit-overflow-scrolling: touch;
    /* Ensure iframe can receive touch events */
    isolation: isolate;
  }

  /* Modal Animations */
  @keyframes leadModalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes leadModalFadeOut {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes leadModalSlideIn {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .lead-modal-overlay {
      /* Prevent body scroll issues on mobile */
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      height: 100dvh !important; /* Use dynamic viewport height for better mobile support */
      /* Ensure proper stacking above everything including footer */
      z-index: 2147483647 !important; /* Maximum possible z-index */
      /* Prevent scrolling on mobile */
      overflow: hidden !important;
      /* Better mobile backdrop */
      backdrop-filter: blur(20px) !important;
      -webkit-backdrop-filter: blur(20px) !important;
      /* Ensure modal covers entire viewport */
      margin: 0 !important;
      padding: 0 !important;
    }

    .lead-modal-container {
      width: 100vw !important;
      width: 100dvw !important; /* Use dynamic viewport width for better mobile support */
      height: 100vh !important;
      max-height: 100vh !important;
      max-width: 100vw !important;
      margin: 0 !important;
      border-radius: 0 !important;
      /* Prevent zoom on iOS */
      -webkit-text-size-adjust: 100%;
      /* Better mobile performance */
      will-change: transform;
      /* Ensure no gaps */
      position: relative;
      overflow: hidden;
    }

    .lead-modal-header {
      padding: var(--space-5) var(--space-5);
      /* Ensure header doesn't interfere with iframe */
      position: relative;
      z-index: 10;
      flex-shrink: 0;
      /* Prevent header from being scrollable */
      position: sticky;
      top: 0;
      background: linear-gradient(90deg, rgba(110,0,255,0.15), rgba(75,0,255,0.08));
    }

    .lead-modal-content {
      /* Ensure content fills remaining space */
      height: calc(100vh - 80px) !important;
      max-height: calc(100vh - 80px) !important;
      overflow: hidden !important;
      /* Prevent any scrolling issues */
      position: relative;
    }

    .lead-modal-title {
      font-size: 24px;
    }

    .lead-modal-close {
      /* Larger touch target on mobile */
      width: 52px;
      height: 52px;
      /* Ensure it's always tappable */
      position: relative;
      z-index: 20;
    }

    .lead-modal-content iframe {
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      border-radius: 0 !important;
      /* Ensure iframe fills correctly and is interactive */
      min-height: calc(100vh - 80px) !important;
      position: absolute !important;
      /* Critical for mobile form interaction */
      pointer-events: auto !important;
      touch-action: auto !important;
      -webkit-overflow-scrolling: touch !important;
    }
  }

  @media (max-width: 480px) {
    .lead-modal-header {
      padding: var(--space-4) var(--space-5);
      /* Account for notches and safe areas */
      padding-top: max(var(--space-4), env(safe-area-inset-top));
      padding-left: max(20px, env(safe-area-inset-left));
      padding-right: max(20px, env(safe-area-inset-right));
    }

    .lead-modal-title {
      font-size: 20px;
    }

    .lead-modal-subtitle {
      font-size: 14px;
    }

    .lead-modal-close {
      /* Even larger touch target on small screens */
      width: 56px;
      height: 56px;
    }

    .lead-modal-content {
      /* Account for smaller screens */
      height: calc(100vh - 90px);
      /* Better touch scrolling */
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .lead-modal-content iframe {
      min-height: calc(100vh - 90px);
    }
  }

  /* Touch active states for better mobile feedback */
  .lead-modal-close.touch-active {
    transform: translateY(-1px) scale(0.98);
    background: rgba(139, 92, 246, 0.2);
    border-color: rgba(139, 92, 246, 0.4);
  }

  /* iOS Safari specific fixes */
  @supports (-webkit-touch-callout: none) {
    .lead-modal-container {
      /* Fix iOS viewport issues */
      height: -webkit-fill-available;
    }

    .lead-modal-content {
      height: calc(-webkit-fill-available - 100px);
    }

    .lead-modal-content iframe {
      min-height: calc(-webkit-fill-available - 100px);
    }
  }
</style>

<!-- JavaScript -->
<script define:vars={{ defaultFormUrl }}>
  // Lead Modal Configuration - Maps button contexts to form URLs and titles
  window.leadModalConfig = {
    'starter-plan': {
      title: 'Start Your Starter Website',
      subtitle: 'Get your custom quote in under 2 minutes • Limited spots available',
      formUrl: defaultFormUrl
    },
    'growth-plan': {
      title: 'Get Your Growth Plan',
      subtitle: 'Scale your business • Full marketing automation',
      formUrl: defaultFormUrl
    },
    'scale-plan': {
      title: 'Dominate with Scale Plan',
      subtitle: 'Enterprise solutions • Market domination',
      formUrl: defaultFormUrl
    },
    'contact-form': {
      title: 'Get Started with ZeroMotion',
      subtitle: 'Professional setup • Louisiana expertise • Real results',
      formUrl: defaultFormUrl
    },
    'default': {
      title: 'Get Started with ZeroMotion',
      subtitle: 'Professional setup • Louisiana expertise • Real results',
      formUrl: defaultFormUrl
    }
  };

  // Global Lead Modal Functions
  window.openLeadModal = function(context = 'default', customTitle = null, customSubtitle = null) {
    const modal = document.getElementById('lead-modal');
    const iframe = document.getElementById('lead-form-iframe');
    const titleEl = document.getElementById('lead-modal-title');
    const subtitleEl = document.getElementById('lead-modal-subtitle');
    let touchStartY = 0;
    let touchActive = false;
    
    if (modal && iframe) {
      // Get configuration for this context
      const config = window.leadModalConfig[context] || window.leadModalConfig['default'];
      
      // Set title and subtitle
      if (titleEl) titleEl.textContent = customTitle || config.title;
      if (subtitleEl) subtitleEl.textContent = customSubtitle || config.subtitle;
      
      // Set form URL
      iframe.src = config.formUrl;
      
      // Store current scroll position for restoration
      const scrollY = window.scrollY;
      
      // Enhanced z-index enforcement
      modal.style.zIndex = '2147483647';
      modal.style.position = 'fixed';
      modal.style.top = '0';
      modal.style.left = '0';
      modal.style.right = '0';
      modal.style.bottom = '0';
      modal.style.width = '100vw';
      modal.style.height = '100vh';
      
      // Show modal with enhanced mobile optimizations
      modal.style.display = 'block';
      
      // Add modal-open class to body for CSS targeting
      document.body.classList.add('modal-open');
      
      // Prevent body scroll with better mobile handling
      if (window.innerWidth <= 768) {
        // Mobile: completely lock scroll and viewport
        document.body.style.position = 'fixed';
        document.body.style.top = `-${scrollY}px`;
        document.body.style.left = '0';
        document.body.style.right = '0';
        document.body.style.width = '100%';
        document.body.style.height = '100%';
        document.body.style.overflow = 'hidden';
        // Prevent zoom and bounce
        document.documentElement.style.overflow = 'hidden';
        document.documentElement.style.height = '100%';
        // Store scroll position for later restoration
        modal.setAttribute('data-scroll-y', scrollY.toString());
        
        // Hide footer and navbar on mobile during modal
        const footer = document.querySelector('#main-footer');
        const navbar = document.querySelector('#navbar');
        if (footer) {
          footer.style.display = 'none';
          footer.style.visibility = 'hidden';
          footer.style.opacity = '0';
          footer.style.zIndex = '-1';
          modal.setAttribute('data-footer-hidden', 'true');
        }
        if (navbar) {
          navbar.style.display = 'none';
          navbar.style.visibility = 'hidden';
          navbar.style.opacity = '0';
          modal.setAttribute('data-navbar-hidden', 'true');
        }
      } else {
        // Desktop: just prevent body scroll
        document.body.style.overflow = 'hidden';
      }

      // Track modal open with context
      if (window.dataLayer) {
        window.dataLayer.push({
          event: 'lead_modal_open',
          form_context: context,
          button_location: context,
          timestamp: Date.now()
        });
      }

      // Focus management for accessibility (skip on mobile to avoid keyboard issues)
      const closeBtn = modal.querySelector('.lead-modal-close');
      if (closeBtn && window.innerWidth > 768) {
        setTimeout(() => closeBtn.focus(), 100);
      }

      // Enhanced iframe setup with mobile optimizations
      setTimeout(() => {
        iframe.style.width = '100%';
        iframe.style.height = '100%';
        iframe.style.top = '0';
        iframe.style.left = '0';
        
        // Force iframe reload on mobile to ensure proper rendering
        if (window.innerWidth <= 768) {
          const currentSrc = iframe.src;
          iframe.src = '';
          setTimeout(() => {
            iframe.src = currentSrc;
          }, 50);
        }
      }, 100);
    }
  };

  window.closeLeadModal = function() {
    const modal = document.getElementById('lead-modal');
    if (modal) {
      modal.classList.add('closing');
      setTimeout(() => {
        modal.style.display = 'none';
        modal.classList.remove('closing');
        
        // Remove modal-open class from body
        document.body.classList.remove('modal-open');
        
        // Restore body scroll with enhanced mobile optimizations
        if (window.innerWidth <= 768) {
          // Mobile: restore all locked styles and scroll position
          const scrollY = modal.getAttribute('data-scroll-y') || '0';
          document.body.style.position = '';
          document.body.style.top = '';
          document.body.style.left = '';
          document.body.style.right = '';
          document.body.style.width = '';
          document.body.style.height = '';
          document.body.style.overflow = '';
          document.documentElement.style.overflow = '';
          document.documentElement.style.height = '';
          
          // Restore hidden elements
          if (modal.getAttribute('data-footer-hidden') === 'true') {
            const footer = document.querySelector('#main-footer');
            if (footer) {
              footer.style.display = '';
              footer.style.visibility = '';
              footer.style.opacity = '';
              footer.style.zIndex = '';
            }
            modal.removeAttribute('data-footer-hidden');
          }
          
          if (modal.getAttribute('data-navbar-hidden') === 'true') {
            const navbar = document.querySelector('#navbar');
            if (navbar) {
              navbar.style.display = '';
              navbar.style.visibility = '';
              navbar.style.opacity = '';
            }
            modal.removeAttribute('data-navbar-hidden');
          }
          
          // Restore scroll position smoothly
          window.scrollTo(0, parseInt(scrollY));
          // Clear stored scroll position
          modal.removeAttribute('data-scroll-y');
        } else {
          // Desktop: just restore body scroll
          document.body.style.overflow = '';
        }
        
        // Clear iframe src to stop any ongoing requests
        const iframe = document.getElementById('lead-form-iframe');
        if (iframe) {
          iframe.src = '';
        }
      }, 300);

      // Track modal close
      if (window.dataLayer) {
        window.dataLayer.push({
          event: 'lead_modal_close',
          timestamp: Date.now()
        });
      }
    }
  };

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', function() {
    // Enhanced mobile touch support for modal buttons
    const leadModalButtons = document.querySelectorAll('[onclick*="openLeadModal"]');
    leadModalButtons.forEach(button => {
      // Add touch event listeners for better mobile interaction
      button.addEventListener('touchstart', function(e) {
        this.classList.add('touch-active');
      }, { passive: true });

      button.addEventListener('touchend', function(e) {
        this.classList.remove('touch-active');
      }, { passive: true });

      // Prevent double-tap zoom on mobile
      button.addEventListener('touchend', function(e) {
        e.preventDefault();
      }, { passive: false });
    });

    // Enhanced modal close button handling
    const modal = document.getElementById('lead-modal');
    if (modal) {
      const closeBtn = modal.querySelector('.lead-modal-close');
      if (closeBtn) {
        // Add touch event listeners for mobile
        closeBtn.addEventListener('touchstart', function(e) {
          e.preventDefault();
          this.classList.add('touch-active');
        }, { passive: false });

        closeBtn.addEventListener('touchend', function(e) {
          e.preventDefault();
          this.classList.remove('touch-active');
          closeLeadModal();
        }, { passive: false });

        // Ensure click still works for desktop
        closeBtn.addEventListener('click', function(e) {
          e.preventDefault();
          closeLeadModal();
        });
      }

      // Enhanced click/touch outside to close with proper mobile handling
      modal.addEventListener('touchstart', function(e) {
        if (e.target === modal) {
          e.preventDefault();
          closeLeadModal();
        }
      }, { passive: false });

      // Swipe down to close on modal container
      const container = modal.querySelector('.lead-modal-container');
      container?.addEventListener('touchstart', function(e) {
        if (!e.touches || e.touches.length === 0) return;
        touchActive = true;
        touchStartY = e.touches[0].clientY;
      }, { passive: true });
      container?.addEventListener('touchmove', function(e) {
        if (!touchActive || !e.touches || e.touches.length === 0) return;
        const deltaY = e.touches[0].clientY - touchStartY;
        if (deltaY > 60) {
          touchActive = false;
          closeLeadModal();
        }
      }, { passive: true });
      container?.addEventListener('touchend', function() {
        touchActive = false;
      }, { passive: true });
    }

    // Keyboard navigation for accessibility
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        const modal = document.getElementById('lead-modal');
        if (modal && modal.style.display === 'block') {
          closeLeadModal();
        }
      }
    });

    // Click outside to close (desktop)
    document.addEventListener('click', function(e) {
      const modal = document.getElementById('lead-modal');
      if (modal && modal.style.display === 'block' && e.target === modal) {
        closeLeadModal();
      }
    });

    // Enhanced iframe loading with mobile optimizations
    const leadIframe = document.getElementById('lead-form-iframe');
    if (leadIframe) {
      leadIframe.addEventListener('load', function() {
        console.log('Lead capture iframe loaded successfully');
        // Ensure iframe is properly sized on mobile
        if (window.innerWidth <= 768) {
          this.style.width = '100%';
          this.style.height = '100%';
          this.style.top = '0';
          this.style.left = '0';
        }
      });

      // Handle iframe loading errors
      leadIframe.addEventListener('error', function() {
        console.error('Lead capture iframe failed to load');
        // Could show fallback content here
      });
    }

    // Prevent iOS bounce scrolling when modal is open
    let modalOpen = false;
    const originalOpenLeadModal = window.openLeadModal;
    window.openLeadModal = function(...args) {
      modalOpen = true;
      return originalOpenLeadModal.apply(this, args);
    };

    const originalCloseLeadModal = window.closeLeadModal;
    window.closeLeadModal = function(...args) {
      modalOpen = false;
      return originalCloseLeadModal.apply(this, args);
    };

    // Prevent scroll when modal is open (iOS fix)
    document.addEventListener('touchmove', function(e) {
      if (modalOpen) {
        const modal = document.getElementById('lead-modal');
        if (modal && modal.style.display === 'block') {
          // Allow scrolling within the iframe content area
          const iframe = document.getElementById('lead-form-iframe');
          if (!iframe?.contains(e.target)) {
            e.preventDefault();
          }
        }
      }
    }, { passive: false });
  });
</script>

<script define:vars={{ formScriptUrl }} type="text/javascript">
  // Dynamically load ZRM form embed script
  const script = document.createElement('script');
  script.src = formScriptUrl;
  script.type = 'text/javascript';
  document.body.appendChild(script);
</script>