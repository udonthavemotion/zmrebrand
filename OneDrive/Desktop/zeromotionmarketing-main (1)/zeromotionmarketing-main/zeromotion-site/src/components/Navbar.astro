---
const links = [
  { href: "/", label: "Home" },
  { href: "/pricing", label: "Pricing" },
  { href: "/quiz", label: "Take Our Quiz" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

// Context-aware CTA logic
const isPricingPage = Astro.url.pathname === '/pricing';
const primaryCTAText = isPricingPage ? 'Book Free Consultation' : 'View Pricing';
const primaryCTAUrl = isPricingPage ? '/#consultation' : '/pricing';
---

<header
  id="navbar"
  class="fixed top-0 z-50 w-full transition-all duration-300 isolate header--sticky pad-safe-inline"
  style="background: transparent; border-bottom: 1px solid transparent;"
  role="banner"
>
  <nav id="navigation" class="container-page flex items-center justify-between h-14" role="navigation" aria-label="Main navigation">
    <!-- Desktop Logo (Left) -->
    <a 
      href="/" 
      rel="home" 
      aria-label="ZeroMotion Marketing - Home"
      class="hidden md:flex items-center mr-8"
    >
      <picture>
        <source srcset="/optimized/brand/ZeroMotion-Mobile-Logo.webp" type="image/webp" />
        <img
          src="/brand/ZeroMotion-Mobile-Logo.png"
          alt="ZeroMotion"
          class="desktop-nav-logo"
          loading="eager"
          width="120"
          height="32"
          style="height: 32px; width: auto; object-fit: contain;"
        />
      </picture>
    </a>

    <div class="hidden md:flex items-center justify-center gap-6 flex-1">
      {
        links.map((l) => (
          <a
            href={l.href}
            class={`text-sm transition-all duration-300 nav-link-glow font-normal ${
              Astro.url.pathname === l.href
                ? 'text-white'
                : 'text-white/80 hover:text-white'
            }`}
            aria-current={Astro.url.pathname === l.href ? "page" : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <div class="nav-item group relative" data-dropdown="services">
        <button
          class="text-sm text-white/80 hover:text-white inline-flex items-center gap-1.5 nav-link nav-link-glow transition-all duration-300 font-normal"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="services-menu"
          data-dd-trigger="services"
        >
          Services
          <svg 
            aria-hidden="true" 
            class="h-3.5 w-3.5 chev transition-transform duration-200 flex-shrink-0" 
            viewBox="0 0 24 24" 
            fill="none"
          >
            <path
              d="M6 9l6 6 6-6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div
          id="services-menu"
          role="menu"
          aria-label="Services"
          class="dd-panel absolute left-0 top-full mt-2 w-64 rounded-xl shadow-xl border border-white/10 backdrop-blur-md"
          style="background-color: var(--zm-surface);"
          data-dd-panel="services"
          data-open="false"
        >
          <ul class="py-2" data-dd-list>
            <li>
              <a
                href="/services/web-design"
                class="block rounded-lg px-3 py-2 text-sm text-white/80 hover:bg-white/5 hover:text-white dd-item transition-colors duration-200"
                role="menuitem"
                tabindex="-1">Web Design</a>
            </li>
            <li>
              <a
                href="/services/brand-identity"
                class="block rounded-lg px-3 py-2 text-sm text-white/80 hover:bg-white/5 hover:text-white dd-item transition-colors duration-200"
                role="menuitem"
                tabindex="-1">Brand &amp; Identity</a>
            </li>
            <li>
              <a
                href="/services/ai-integration"
                class="block rounded-lg px-3 py-2 text-sm text-white/80 hover:bg-white/5 hover:text-white dd-item transition-colors duration-200"
                role="menuitem"
                tabindex="-1">AI Integration</a>
            </li>
            <li>
              <a
                href="/services/crm"
                class="block rounded-lg px-3 py-2 text-sm text-white/80 hover:bg-white/5 hover:text-white dd-item transition-colors duration-200"
                role="menuitem"
                tabindex="-1">ZeroMotion CRM</a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Secondary CTA -->
      <a
        href="/services/crm"
        class="text-sm text-white/80 hover:text-white transition-colors duration-200"
        data-analytics="secondary-cta"
      >
        ZeroMotion CRM
      </a>

      <!-- Primary CTA (Context-Aware) -->
      <a
        href={primaryCTAUrl}
        class="btn btn-primary"
        data-analytics="primary-cta"
        onclick={primaryCTAUrl === '/#consultation' ? 'handleConsultationClick(event)' : undefined}
      >
        {primaryCTAText}
      </a>
    </div>

    <button
      class="md:hidden inline-flex items-center justify-center h-12 w-12 transition-all duration-300 relative z-60"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open navigation menu"
      aria-describedby="nav-toggle-description"
      id="nav-toggle"
      type="button"
    >
      <span id="nav-toggle-description" class="sr-only">Toggle navigation menu visibility</span>
      <!-- Animated hamburger to X icon -->
      <div class="hamburger-icon">
        <span class="hamburger-line hamburger-line-1"></span>
        <span class="hamburger-line hamburger-line-2"></span>
        <span class="hamburger-line hamburger-line-3"></span>
      </div>
    </button>
  </nav>
  <!-- Mobile Menu Backdrop -->
  <div
    id="mobile-backdrop"
    class="fixed inset-0 bg-black/40 backdrop-blur-sm transition-all duration-300 opacity-0 invisible md:hidden pointer-events-none"
    style="z-index: 45;"
    aria-hidden="true"
  ></div>

  <!-- Modern Mobile Menu - Bottom Sheet Style with Dialog Semantics -->
  <nav
    id="mobile-menu"
    data-mobile-menu
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation menu"
    class="fixed bottom-0 left-0 right-0 z-50 transform translate-y-full transition-all duration-500 ease-out md:hidden mobile-bottom-sheet"
    aria-hidden="true"
  >
    <!-- Pull Indicator -->
    <div class="flex justify-center pt-4 pb-2 bg-gradient-to-b from-transparent to-slate-900/50">
      <div class="w-12 h-1.5 bg-white/30 rounded-full"></div>
    </div>
    
    <!-- Menu Content - Glassmorphism applied via CSS -->
    <div class="bg-gradient-to-br from-slate-900/95 to-slate-800/95 backdrop-blur-xl border-t border-white/10 rounded-t-3xl shadow-2xl">
      <!-- Header Section with Centered Branded Logo -->
      <div class="mobile-menu-header">
        <!-- Centered Logo -->
        <div class="mobile-menu-logo-container">
          <picture class="mobile-menu-logo">
            <source srcset="/optimized/brand/ZeroMotion-Mobile-Logo.webp" type="image/webp" />
            <img
              src="/brand/ZeroMotion-Mobile-Logo.png"
              alt="ZeroMotion Marketing"
              class="mobile-menu-logo-img"
              loading="eager"
              width="140"
              height="48"
            />
          </picture>
        </div>
        <!-- Close Button (Right) -->
        <button
          id="mobile-close"
          class="mobile-menu-close-btn"
          aria-label="Close navigation menu"
          type="button"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-white">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Primary CTA Section -->
      <div class="px-6 py-5 bg-gradient-to-r from-violet-600/20 to-purple-600/20 border-b border-white/5">
        <a
          href={primaryCTAUrl}
          class="flex items-center justify-center w-full py-4 px-6 bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-700 hover:to-purple-700 text-white font-semibold rounded-2xl shadow-lg shadow-violet-500/25 transition-all duration-200 active:scale-98"
          data-analytics="primary-cta-mobile"
          onclick={primaryCTAUrl === '/#consultation' ? 'handleConsultationClick(event)' : undefined}
        >
          <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          {primaryCTAText}
        </a>
      </div>

      <!-- Navigation Grid -->
      <div class="px-6 py-5">
        <div class="grid grid-cols-2 gap-3 mb-5">
          <a
            href="/"
            class={`mobile-nav-card group flex flex-col items-center p-4 rounded-2xl transition-all duration-200 ${
              Astro.url.pathname === '/' 
                ? 'bg-white/15 border border-white/20 shadow-lg' 
                : 'bg-white/5 hover:bg-white/10 active:scale-95'
            }`}
            aria-current={Astro.url.pathname === '/' ? "page" : undefined}
          >
            <div class={`flex items-center justify-center w-12 h-12 rounded-2xl mb-3 transition-all duration-200 ${
              Astro.url.pathname === '/' ? 'bg-violet-500/30' : 'bg-white/10 group-hover:bg-violet-500/20'
            }`}>
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
            </div>
            <span class="text-sm font-medium text-white">Home</span>
          </a>

          <a
            href="/pricing"
            class={`mobile-nav-card group flex flex-col items-center p-4 rounded-2xl transition-all duration-200 ${
              Astro.url.pathname === '/pricing'
                ? 'bg-white/15 border border-white/20 shadow-lg'
                : 'bg-white/5 hover:bg-white/10 active:scale-95'
            }`}
            aria-current={Astro.url.pathname === '/pricing' ? "page" : undefined}
          >
            <div class={`flex items-center justify-center w-12 h-12 rounded-2xl mb-3 transition-all duration-200 ${
              Astro.url.pathname === '/pricing' ? 'bg-emerald-500/30' : 'bg-white/10 group-hover:bg-emerald-500/20'
            }`}>
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
              </svg>
            </div>
            <span class="text-sm font-medium text-white">Pricing</span>
          </a>

          <a
            href="/quiz"
            class={`mobile-nav-card group flex flex-col items-center p-4 rounded-2xl transition-all duration-200 ${
              Astro.url.pathname === '/quiz'
                ? 'bg-white/15 border border-white/20 shadow-lg'
                : 'bg-white/5 hover:bg-white/10 active:scale-95'
            }`}
            aria-current={Astro.url.pathname === '/quiz' ? "page" : undefined}
          >
            <div class={`flex items-center justify-center w-12 h-12 rounded-2xl mb-3 transition-all duration-200 ${
              Astro.url.pathname === '/quiz' ? 'bg-blue-500/30' : 'bg-white/10 group-hover:bg-blue-500/20'
            }`}>
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
              </svg>
            </div>
            <span class="text-sm font-medium text-white">Take Quiz</span>
          </a>

          <a
            href="/about"
            class={`mobile-nav-card group flex flex-col items-center p-4 rounded-2xl transition-all duration-200 ${
              Astro.url.pathname === '/about'
                ? 'bg-white/15 border border-white/20 shadow-lg'
                : 'bg-white/5 hover:bg-white/10 active:scale-95'
            }`}
            aria-current={Astro.url.pathname === '/about' ? "page" : undefined}
          >
            <div class={`flex items-center justify-center w-12 h-12 rounded-2xl mb-3 transition-all duration-200 ${
              Astro.url.pathname === '/about' ? 'bg-amber-500/30' : 'bg-white/10 group-hover:bg-amber-500/20'
            }`}>
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <span class="text-sm font-medium text-white">About</span>
          </a>
        </div>

        <!-- Services Section -->
        <div class="mb-5">
          <button
            class="mobile-services-toggle w-full flex items-center justify-between p-4 bg-white/5 hover:bg-white/10 rounded-2xl transition-all duration-200 active:scale-98"
            aria-expanded="false"
            aria-controls="mobile-services-submenu"
            aria-label="Services menu"
            data-mobile-services-toggle
            type="button"
          >
            <div class="flex items-center">
              <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-white/10 mr-4">
                <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <div class="text-left">
                <div class="text-base font-semibold text-white">Services</div>
                <div class="text-sm text-white/70">Smart Automations</div>
              </div>
            </div>
            <svg class="h-6 w-6 text-white/60 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          
          <div id="mobile-services-submenu" class="mobile-services-menu mt-3 space-y-2 hidden overflow-hidden" role="menu" aria-label="Services submenu">
            <a
              href="/services/web-design"
              class={`mobile-nav-subitem flex items-center p-3 rounded-xl transition-all duration-200 ${
                Astro.url.pathname === '/services/web-design'
                  ? 'bg-white/15 text-white border border-white/20'
                  : 'bg-white/5 text-white/80 hover:bg-white/10 hover:text-white active:scale-98'
              }`}
              role="menuitem"
              aria-current={Astro.url.pathname === '/services/web-design' ? "page" : undefined}
            >
              <div class="w-2 h-2 bg-blue-400 rounded-full mr-3"></div>
              Web Design
            </a>
            <a
              href="/services/brand-identity"
              class={`mobile-nav-subitem flex items-center p-3 rounded-xl transition-all duration-200 ${
                Astro.url.pathname === '/services/brand-identity'
                  ? 'bg-white/15 text-white border border-white/20'
                  : 'bg-white/5 text-white/80 hover:bg-white/10 hover:text-white active:scale-98'
              }`}
              role="menuitem"
              aria-current={Astro.url.pathname === '/services/brand-identity' ? "page" : undefined}
            >
              <div class="w-2 h-2 bg-purple-400 rounded-full mr-3"></div>
              Brand & Identity
            </a>
            <a
              href="/services/ai-integration"
              class={`mobile-nav-subitem flex items-center p-3 rounded-xl transition-all duration-200 ${
                Astro.url.pathname === '/services/ai-integration'
                  ? 'bg-white/15 text-white border border-white/20'
                  : 'bg-white/5 text-white/80 hover:bg-white/10 hover:text-white active:scale-98'
              }`}
              role="menuitem"
              aria-current={Astro.url.pathname === '/services/ai-integration' ? "page" : undefined}
            >
              <div class="w-2 h-2 bg-emerald-400 rounded-full mr-3"></div>
              AI Integration
            </a>
            <a
              href="/services/crm"
              class={`mobile-nav-subitem flex items-center p-3 rounded-xl transition-all duration-200 ${
                Astro.url.pathname === '/services/crm'
                  ? 'bg-white/15 text-white border border-white/20'
                  : 'bg-white/5 text-white/80 hover:bg-white/10 hover:text-white active:scale-98'
              }`}
              role="menuitem"
              aria-current={Astro.url.pathname === '/services/crm' ? "page" : undefined}
            >
              <div class="w-2 h-2 bg-amber-400 rounded-full mr-3"></div>
              ZeroMotion CRM
            </a>
          </div>
        </div>

        <!-- Contact Action -->
        <a
          href="/contact"
          class={`mobile-contact-card w-full flex items-center justify-between p-4 rounded-2xl transition-all duration-200 ${
            Astro.url.pathname === '/contact'
              ? 'bg-white/15 border border-white/20 shadow-lg'
              : 'bg-gradient-to-r from-purple-600/10 to-black/10 hover:from-purple-600/20 hover:to-black/20 active:scale-98'
          }`}
          aria-current={Astro.url.pathname === '/contact' ? "page" : undefined}
        >
          <div class="flex items-center">
            <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-gradient-to-br from-purple-600 to-black mr-4">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div class="text-left">
              <div class="text-lg font-semibold text-white">Contact Us</div>
              <div class="text-sm text-white/60">Get in touch</div>
            </div>
          </div>
          <svg class="h-5 w-5 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Safe area for bottom notch -->
      <div class="pb-safe-bottom"></div>
    </div>
  </nav>
  <script>
    // Type declarations for gtag and custom functions
    declare global {
      interface Window {
        gtag: (command: string, targetId: string, config?: any) => void;
        handleConsultationClick: (e: Event) => void;
        openBookingModal: (plan: string) => void;
      }
    }

    // Navbar scroll behavior
    const navbar = document.getElementById("navbar");
    const heroSection = document.querySelector("[data-hero]");

    function updateNavbarBackground() {
      if (!navbar) return;

      // Keep navbar completely transparent at all times
      navbar.style.background = "transparent";
      navbar.style.borderBottom = "1px solid transparent";
      navbar.style.backdropFilter = "none";
    }

    // Initial check
    updateNavbarBackground();

    // Listen for scroll events
    window.addEventListener("scroll", updateNavbarBackground, { passive: true });

    // Mobile menu functionality
    const btn = document.getElementById("nav-toggle");
    const menu = document.getElementById("mobile-menu");
    const backdrop = document.getElementById("mobile-backdrop");
    const closeBtn = document.getElementById("mobile-close");
    const hamburgerIcon = btn?.querySelector(".hamburger-icon");

    let isOpen = false;
    let focusableElements: HTMLElement[] = [];
    let firstFocusable: HTMLElement | null = null;
    let lastFocusable: HTMLElement | null = null;

    function closeOnEscape(e: KeyboardEvent) {
      if (e.key === "Escape") {
        hide();
        (btn as HTMLButtonElement | null)?.focus();
      }
    }

    // Focus trap implementation
    function trapFocus(e: KeyboardEvent) {
      if (e.key !== 'Tab') return;
      
      if (e.shiftKey) {
        // Shift + Tab (backwards)
        if (document.activeElement === firstFocusable) {
          e.preventDefault();
          lastFocusable?.focus();
        }
      } else {
        // Tab (forwards)
        if (document.activeElement === lastFocusable) {
          e.preventDefault();
          firstFocusable?.focus();
        }
      }
    }

    function hide() {
      if (!isOpen) return;
      
      isOpen = false;
      
      // Hide bottom sheet - slide down
      menu?.classList.add("translate-y-full");
      menu?.classList.remove("translate-y-0");
      
      // Update ARIA attributes
      menu?.setAttribute("aria-hidden", "true");
      
      // Hide backdrop and disable pointer events
      backdrop?.classList.add("opacity-0", "invisible", "pointer-events-none");
      backdrop?.classList.remove("opacity-100", "visible", "pointer-events-auto");
      
      // Reset body overflow - remove menu-open class
      document.body.classList.remove("menu-open");
      
      // Update button state
      btn?.setAttribute("aria-expanded", "false");
      hamburgerIcon?.classList.remove("open");
      
      // Show hamburger button again
      btn?.classList.remove("hamburger-hidden");
      
      // Remove event listeners
      document.removeEventListener("keydown", closeOnEscape as any);
      document.removeEventListener("keydown", trapFocus as any);

      // Analytics: nav_close
      if (window.gtag) {
        window.gtag('event', 'nav_close', {
          event_category: 'navigation',
          event_label: 'mobile_menu_bottom_sheet'
        });
      }
    }

    function show() {
      if (isOpen) return;
      
      isOpen = true;
      
      // Show bottom sheet - slide up
      menu?.classList.remove("translate-y-full");
      menu?.classList.add("translate-y-0");
      
      // Update ARIA attributes
      menu?.setAttribute("aria-hidden", "false");
      
      // Show backdrop and enable pointer events
      backdrop?.classList.remove("opacity-0", "invisible", "pointer-events-none");
      backdrop?.classList.add("opacity-100", "visible", "pointer-events-auto");
      
      // Prevent body scroll - add menu-open class
      document.body.classList.add("menu-open");
      
      // Update button state
      btn?.setAttribute("aria-expanded", "true");
      hamburgerIcon?.classList.add("open");
      
      // Hide hamburger button when menu is open
      btn?.classList.add("hamburger-hidden");
      
      // Setup focus trap
      if (menu) {
        focusableElements = Array.from(
          menu.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )
        ).filter(el => !el.hasAttribute('disabled') && el.offsetParent !== null);
        
        firstFocusable = focusableElements[0] || null;
        lastFocusable = focusableElements[focusableElements.length - 1] || null;
        
        // Focus first element after animation completes
        setTimeout(() => {
          firstFocusable?.focus();
        }, 100);
      }
      
      // Add event listeners
      document.addEventListener("keydown", closeOnEscape as any);
      document.addEventListener("keydown", trapFocus as any);

      // Analytics: nav_open
      if (window.gtag) {
        window.gtag('event', 'nav_open', {
          event_category: 'navigation',
          event_label: 'mobile_menu_bottom_sheet'
        });
      }
    }

    // Toggle menu
    btn?.addEventListener("click", () => {
      isOpen ? hide() : show();
    });

    // Close menu when clicking backdrop
    backdrop?.addEventListener("click", (e) => {
      e.stopPropagation();
      hide();
    });
    
    // Close menu when clicking close button
    closeBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      hide();
    });

    // Close menu when clicking nav links (with small delay for smooth transition)
    menu?.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        // Small delay to allow link navigation to start before menu closes
        setTimeout(hide, 50);
      });
    });

    // Mobile services dropdown
    const servicesToggle = document.querySelector("[data-mobile-services-toggle]");
    const servicesMenu = document.querySelector(".mobile-services-menu");
    const servicesChevron = servicesToggle?.querySelector("svg:last-child");

    servicesToggle?.addEventListener("click", () => {
      const isExpanded = servicesToggle.getAttribute("aria-expanded") === "true";

      if (isExpanded) {
        servicesToggle.setAttribute("aria-expanded", "false");
        servicesMenu?.classList.add("hidden");
        servicesChevron?.classList.remove("rotate-180");
      } else {
        servicesToggle.setAttribute("aria-expanded", "true");
        servicesMenu?.classList.remove("hidden");
        servicesChevron?.classList.add("rotate-180");
      }
    });

    // Desktop services dropdown
    const desktopServicesTrigger = document.querySelector("[data-dd-trigger='services']");
    const desktopServicesPanel = document.querySelector("[data-dd-panel='services']");
    const desktopServicesChevron = desktopServicesTrigger?.querySelector(".chev");

    let desktopServicesTimeout: ReturnType<typeof setTimeout> | undefined;

    function showDesktopServicesMenu() {
      clearTimeout(desktopServicesTimeout);
      if (desktopServicesPanel) {
        desktopServicesPanel.setAttribute("data-open", "true");
      }
      if (desktopServicesTrigger) {
        desktopServicesTrigger.setAttribute("aria-expanded", "true");
      }
      desktopServicesChevron?.classList.add("rotate-180");
    }

    function hideDesktopServicesMenu() {
      desktopServicesTimeout = setTimeout(() => {
        if (desktopServicesPanel) {
          desktopServicesPanel.setAttribute("data-open", "false");
        }
        if (desktopServicesTrigger) {
          desktopServicesTrigger.setAttribute("aria-expanded", "false");
        }
        desktopServicesChevron?.classList.remove("rotate-180");
      }, 150);
    }

    // Click handler for desktop services dropdown
    desktopServicesTrigger?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();

      const isExpanded = desktopServicesTrigger?.getAttribute("aria-expanded") === "true";
      if (isExpanded) {
        hideDesktopServicesMenu();
      } else {
        showDesktopServicesMenu();
      }
    });

    // Hover handlers for desktop services dropdown
    const desktopServicesGroup = document.querySelector(".nav-item.group");
    desktopServicesGroup?.addEventListener("mouseenter", showDesktopServicesMenu);
    desktopServicesGroup?.addEventListener("mouseleave", hideDesktopServicesMenu);

    // Close dropdown when clicking outside
    document.addEventListener("click", (e) => {
      if (!desktopServicesGroup?.contains(e.target as Node)) {
        hideDesktopServicesMenu();
      }
    });

    // Close dropdown on escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        hideDesktopServicesMenu();
      }
    });

    // Enhanced consultation button click handler
    window.handleConsultationClick = function(e) {
      e.preventDefault();

      // Check if booking modal function exists (available on pricing and service pages)
      if (typeof (window as any).openBookingModal === 'function') {
        // Open the booking modal directly
        (window as any).openBookingModal('');
      } else {
        // Navigate to pricing page which has the booking modal
        window.location.href = '/pricing';
      }

      // Track the click
      if (window.gtag) {
        window.gtag('event', 'consultation_click', {
          event_category: 'engagement',
          event_label: 'nav_consultation'
        });
      }
    };

    // Analytics for CTA clicks
    document.querySelectorAll("[data-analytics]").forEach((element) => {
      element.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const analyticsType = target.getAttribute("data-analytics");

        if (analyticsType && window.gtag) {
          if (analyticsType.includes("primary-cta")) {
            window.gtag('event', 'cta_click', {
              event_category: 'engagement',
              event_label: 'nav_primary'
            });
          }
        }
      });
    });

    // Enhanced mobile touch support for CTA buttons
    const ctaButtons = document.querySelectorAll('.btn-primary[data-analytics]');
    ctaButtons.forEach(button => {
      // Add touch event listeners for mobile
      button.addEventListener('touchstart', function(this: HTMLElement, e) {
        this.classList.add('touch-active');
      }, { passive: true });

      button.addEventListener('touchend', function(this: HTMLElement, e) {
        this.classList.remove('touch-active');
      }, { passive: true });
    });
  </script>
</header>

