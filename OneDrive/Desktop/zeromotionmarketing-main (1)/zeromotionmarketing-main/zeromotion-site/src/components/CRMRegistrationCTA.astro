---
// CRM Software Registration CTA Component

// Get ZRM CRM configuration from environment variables
const formBase = import.meta.env.PUBLIC_GHL_FORM_BASE || 'https://dashboard.zeromotionmarketing.com';
const formId = import.meta.env.PUBLIC_GHL_FORM_ID || 'n9og5xkVVmjupqiLT2R6';
const formUrl = `${formBase}/widget/form/${formId}`;
const formScript = '/js/form_embed.js';
const formScriptUrl = `${formBase}${formScript}`;
---

<section
  id="consultation"
  class="section-padding reveal"
  aria-labelledby="crm-title"
>
  <div class="container-page max-w-4xl">
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-3 mb-4 px-4 py-2 rounded-full bg-primary/10 border border-primary/20">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary">
          <path d="M12 2L2 7v10c0 5.55 3.84 10 9 10s9-4.45 9-10V7L12 2z"/>
          <path d="M8 11l4 4 8-8"/>
        </svg>
        <span class="text-sm font-medium text-primary">ZeroMotion CRM Platform</span>
      </div>
      <h2 id="crm-title" class="h2 mb-4 text-center">
        Discover Your Perfect Business Automation Strategy
      </h2>
      <p class="text-white/85 max-w-2xl mx-auto mb-6 text-lg">
        Take our free quiz to get personalized recommendations for your business. Find out which automation solutions work best for your needs.
      </p>

      <!-- Modern CTA Button -->
      <div class="flex justify-center">
        <a
          href="/quiz"
          class="crm-cta-button"
          type="button"
          aria-label="Take our quiz to get started"
        >
        <div class="crm-cta-content">
          <div class="crm-cta-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7v10c0 5.55 3.84 10 9 10s9-4.45 9-10V7L12 2z"/>
              <path d="M8 11l4 4 8-8"/>
            </svg>
          </div>
          <div class="crm-cta-text">
            <span class="crm-cta-title">Take Our Free Quiz</span>
            <span class="crm-cta-subtitle">Discover your perfect automation strategy • Get personalized recommendations</span>
          </div>
          <div class="crm-cta-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17l9.2-9.2M17 17V7H7"/>
            </svg>
          </div>
        </div>
        <div class="crm-cta-glow"></div>
      </a>
      </div>

      <!-- Trust Indicators -->
      <div class="flex flex-wrap justify-center gap-6 mt-8 text-sm text-white/60">
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 12l2 2 4-4"/>
            <circle cx="12" cy="12" r="10"/>
          </svg>
          No setup fees
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 12l2 2 4-4"/>
            <circle cx="12" cy="12" r="10"/>
          </svg>
          Louisiana-based support
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 12l2 2 4-4"/>
            <circle cx="12" cy="12" r="10"/>
          </svg>
          AI-powered automation
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA Styles -->
<style>

  /* CTA Button Styles */
  .crm-cta-button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: normal;
    overflow-wrap: break-word;
    word-break: break-word;
    background: linear-gradient(135deg, #6E00FF, #4B00FF);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 28px;
    padding: 0;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
    box-shadow:
      0 12px 40px rgba(110, 0, 255, 0.35),
      0 4px 16px rgba(110, 0, 255, 0.2),
      0 0 0 1px rgba(255,255,255,0.15),
      inset 0 1px 0 rgba(255,255,255,0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    max-width: 500px;
    width: 100%;
    margin: 0 auto;
    transform-style: preserve-3d;
    will-change: transform, box-shadow;
  }

  .crm-cta-button:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow:
      0 16px 50px rgba(110, 0, 255, 0.45),
      0 6px 20px rgba(110, 0, 255, 0.3),
      0 0 0 1px rgba(255,255,255,0.25),
      inset 0 1px 0 rgba(255,255,255,0.35);
    border-color: rgba(255,255,255,0.35);
  }

  .crm-cta-button:active {
    transform: translateY(-1px) scale(0.98);
    box-shadow:
      0 8px 30px rgba(110, 0, 255, 0.4),
      0 2px 12px rgba(110, 0, 255, 0.25),
      0 0 0 1px rgba(255,255,255,0.2),
      inset 0 1px 0 rgba(255,255,255,0.2);
  }

  .crm-cta-content {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    position: relative;
    z-index: 2;
  }

  .crm-cta-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .crm-cta-text {
    flex: 1;
    text-align: left;
  }

  .crm-cta-title {
    display: block;
    font-size: 18px;
    font-weight: 600;
    color: white;
    margin-bottom: 4px;
    line-height: 1.2;
  }

  .crm-cta-subtitle {
    display: block;
    font-size: 14px;
    color: rgba(255,255,255,0.8);
    line-height: 1.3;
  }

  .crm-cta-arrow {
    flex-shrink: 0;
    color: rgba(255,255,255,0.8);
    transition: transform 0.3s ease;
  }

  .crm-cta-button:hover .crm-cta-arrow {
    transform: translate(2px, -2px);
    color: white;
  }

  .crm-cta-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: 24px;
  }

  .crm-cta-button:hover .crm-cta-glow {
    opacity: 1;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .crm-cta-content {
      padding: var(--space-4) var(--space-5);
      gap: var(--space-3);
    }

    .crm-cta-icon {
      width: 40px;
      height: 40px;
    }

    .crm-cta-title {
      font-size: 16px;
    }

    .crm-cta-subtitle {
      font-size: 13px;
    }
  }
</style>

<!-- JavaScript -->
<script is:inline>
  // Track quiz CTA clicks
  document.addEventListener('DOMContentLoaded', function() {
    const ctaButton = document.querySelector('.crm-cta-button');
    
    if (ctaButton && window.dataLayer) {
      ctaButton.addEventListener('click', function() {
        window.dataLayer.push({
          event: 'quiz_cta_click',
          button_location: 'homepage_cta',
          timestamp: Date.now()
        });
      });
    }
  });
</script>
