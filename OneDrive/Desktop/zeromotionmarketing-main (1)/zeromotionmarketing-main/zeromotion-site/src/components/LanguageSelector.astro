---
// Language Selector Component for International Users
import { getSupportedLanguages, getCurrentLanguage } from "../lib/language-support";

const supportedLanguages = getSupportedLanguages();
const currentLanguage = getCurrentLanguage();
---

<div class="language-selector" role="region" aria-label="Language selector">
  <button
    id="language-toggle"
    class="language-toggle"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label="Select language"
  >
    <span class="current-language">
      <span class="flag">{currentLanguage.flag}</span>
      <span class="lang-code">{currentLanguage.code.toUpperCase()}</span>
    </span>
    <svg class="dropdown-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
      <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div
    id="language-menu"
    class="language-menu"
    role="listbox"
    aria-labelledby="language-toggle"
    aria-hidden="true"
  >
    {supportedLanguages.map(lang => (
      <button
        class={`language-option ${lang.code === currentLanguage.code ? 'active' : ''}`}
        data-lang={lang.code}
        role="option"
        aria-selected={lang.code === currentLanguage.code}
        aria-label={`Switch to ${lang.nativeName}`}
      >
        <span class="flag">{lang.flag}</span>
        <span class="lang-name">{lang.nativeName}</span>
        <span class="lang-code-alt">({lang.code.toUpperCase()})</span>
      </button>
    ))}
  </div>
</div>

<script>
  // Language selector functionality
  class LanguageSelector {
    private toggle: HTMLElement | null = null;
    private menu: HTMLElement | null = null;
    private isOpen = false;

    constructor() {
      this.init();
    }

    private init() {
      this.toggle = document.getElementById('language-toggle');
      this.menu = document.getElementById('language-menu');

      if (!this.toggle || !this.menu) return;

      // Event listeners
      this.toggle.addEventListener('click', () => this.toggleMenu());
      this.toggle.addEventListener('keydown', (e) => this.handleKeydown(e));

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (!this.toggle?.contains(e.target as Node) && !this.menu?.contains(e.target as Node)) {
          this.closeMenu();
        }
      });

      // Handle language selection
      this.menu.querySelectorAll('.language-option').forEach(option => {
        option.addEventListener('click', () => {
          const langCode = option.getAttribute('data-lang');
          if (langCode) {
            this.selectLanguage(langCode);
          }
        });
      });

      // Close on escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isOpen) {
          this.closeMenu();
          this.toggle?.focus();
        }
      });
    }

    private toggleMenu() {
      if (this.isOpen) {
        this.closeMenu();
      } else {
        this.openMenu();
      }
    }

    private openMenu() {
      if (!this.menu || !this.toggle) return;

      this.isOpen = true;
      this.menu.setAttribute('aria-hidden', 'false');
      this.toggle.setAttribute('aria-expanded', 'true');
      this.menu.style.display = 'block';

      // Focus management
      const firstOption = this.menu.querySelector('.language-option') as HTMLElement;
      if (firstOption) {
        setTimeout(() => firstOption.focus(), 10);
      }

      // Announce to screen readers
      this.announceToScreenReader('Language menu opened');
    }

    private closeMenu() {
      if (!this.menu || !this.toggle) return;

      this.isOpen = false;
      this.menu.setAttribute('aria-hidden', 'true');
      this.toggle.setAttribute('aria-expanded', 'false');
      this.menu.style.display = 'none';
    }

    private handleKeydown(e: KeyboardEvent) {
      if (e.key === 'ArrowDown' && !this.isOpen) {
        e.preventDefault();
        this.openMenu();
      } else if (e.key === 'ArrowUp' && this.isOpen) {
        e.preventDefault();
        this.closeMenu();
        this.toggle?.focus();
      }
    }

    private async selectLanguage(langCode: string) {
      try {
        // Import language manager
        const { setLanguage } = await import('/src/lib/language-support.ts');
        setLanguage(langCode);

        // Close menu
        this.closeMenu();

        // Update toggle button
        this.updateToggleButton(langCode);

        // Announce change
        this.announceToScreenReader(`Language changed to ${langCode}`);

        // Reload page to apply changes (optional - could be done without reload)
        // window.location.reload();
      } catch (error) {
        console.error('Failed to change language:', error);
        this.announceToScreenReader('Failed to change language');
      }
    }

    private updateToggleButton(langCode: string) {
      if (!this.toggle) return;

      // Update the current language display
      const currentLangSpan = this.toggle.querySelector('.current-language');
      if (currentLangSpan) {
        currentLangSpan.innerHTML = `
          <span class="flag">${this.getLanguageFlag(langCode)}</span>
          <span class="lang-code">${langCode.toUpperCase()}</span>
        `;
      }
    }

    private getLanguageFlag(langCode: string): string {
      const flags: { [key: string]: string } = {
        'en': '🇺🇸', 'es': '🇪🇸', 'fr': '🇫🇷', 'de': '🇩🇪', 'pt': '🇵🇹',
        'it': '🇮🇹', 'nl': '🇳🇱', 'ar': '🇸🇦', 'zh': '🇨🇳', 'ja': '🇯🇵', 'ko': '🇰🇷'
      };
      return flags[langCode] || '🌐';
    }

    private announceToScreenReader(message: string) {
      const announcement = document.createElement('div');
      announcement.setAttribute('aria-live', 'polite');
      announcement.setAttribute('aria-atomic', 'true');
      announcement.style.position = 'absolute';
      announcement.style.left = '-10000px';
      announcement.style.width = '1px';
      announcement.style.height = '1px';
      announcement.style.overflow = 'hidden';

      announcement.textContent = message;
      document.body.appendChild(announcement);

      setTimeout(() => {
        document.body.removeChild(announcement);
      }, 1000);
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new LanguageSelector());
  } else {
    new LanguageSelector();
  }
</script>

<style>
  .language-selector {
    position: relative;
    display: inline-block;
  }

  .language-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    color: white;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 0.875rem;
  }

  .language-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .language-toggle:focus-visible {
    outline: 2px solid var(--zm-primary);
    outline-offset: 2px;
  }

  .current-language {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .flag {
    font-size: 1rem;
  }

  .lang-code {
    font-weight: 600;
    text-transform: uppercase;
  }

  .dropdown-arrow {
    transition: transform 0.2s ease;
  }

  .language-toggle[aria-expanded="true"] .dropdown-arrow {
    transform: rotate(180deg);
  }

  .language-menu {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 1000;
    min-width: 200px;
    max-height: 300px;
    overflow-y: auto;
    background: rgba(10, 10, 26, 0.98);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    display: none;
  }

  .language-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem;
    background: none;
    border: none;
    color: white;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s ease;
    font-size: 0.875rem;
  }

  .language-option:hover,
  .language-option:focus-visible {
    background: rgba(255, 255, 255, 0.1);
  }

  .language-option.active {
    background: rgba(139, 92, 246, 0.2);
    color: var(--zm-primary);
  }

  .language-option.active::before {
    content: '✓';
    margin-right: 0.5rem;
    color: var(--zm-primary);
    font-weight: bold;
  }

  .lang-name {
    flex: 1;
  }

  .lang-code-alt {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
  }

  /* Mobile responsive */
  @media (max-width: 640px) {
    .language-menu {
      min-width: 180px;
      right: -1rem;
    }

    .language-option {
      padding: 0.625rem 0.875rem;
      font-size: 0.8125rem;
    }
  }

  /* High contrast mode */
  @media (prefers-contrast: high) {
    .language-toggle {
      border: 2px solid white;
    }

    .language-menu {
      border: 2px solid white;
    }
  }
</style>
