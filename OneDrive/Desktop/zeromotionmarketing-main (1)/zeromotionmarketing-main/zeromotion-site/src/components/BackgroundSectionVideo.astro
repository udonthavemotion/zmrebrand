---
export interface Props {
  src: string;
  opacity?: number; // 0..1
  brightness?: number; // 0..2 (1 = normal)
  contrast?: number; // 0..2 (1 = normal)
}
const { src, opacity = 0.6, brightness = 1.2, contrast = 1.1 } = Astro.props as Props;
---

<section class="relative isolate">
  <video
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover stable-video ultra-quality-texture"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    crossorigin="anonymous"
    disablepictureinpicture
    x-webkit-airplay="deny"
    width="1920"
    height="1080"
    aria-hidden="true"
    style={`opacity:${opacity}; filter: brightness(${brightness}) contrast(${contrast}) saturate(1.3) hue-rotate(0deg) blur(0px); will-change: transform, filter;`}
    onloadstart="this.style.visibility='visible'; this.style.imageRendering='optimizeQuality';"
    oncanplay="this.classList.add('loaded'); this.style.transform='translateZ(0)';"
    onloadeddata={`this.style.filter='brightness(${brightness}) contrast(${contrast}) saturate(1.3) hue-rotate(0deg) blur(0px)';`}
  >
    <source src={src} type="video/mp4" />
  </video>
  <!-- Reduced gradient overlay for brighter appearance -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-black/20 via-transparent to-black/20"
  >
  </div>
  <slot />
</section>
<style is:global>
  @media (prefers-reduced-motion: reduce) {
    section[aria-hidden] {
      display: none;
    }
  }
  
  /* Ultra-high quality texture video rendering */
  .ultra-quality-texture {
    /* Advanced hardware acceleration for texture videos */
    transform: translateZ(0) translate3d(0, 0, 0);
    -webkit-transform: translateZ(0) translate3d(0, 0, 0);
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    perspective: 1000px;
    -webkit-perspective: 1000px;
    
    /* Maximum quality rendering for textures */
    image-rendering: -webkit-optimize-contrast;
    image-rendering: -moz-crisp-edges;
    image-rendering: optimize-contrast;
    image-rendering: crisp-edges;
    image-rendering: high-quality;
    
    /* Enhanced texture quality settings */
    object-position: center center;
    object-fit: cover;
    
    /* Smooth transitions optimized for textures */
    will-change: transform, filter, opacity;
    transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
                filter 0.4s ease-out,
                transform 0.3s ease-out;
                
    /* Anti-aliasing for smooth textures */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    
    /* Enhanced color rendering for textures */
    color-rendering: optimizeQuality;
    shape-rendering: geometricPrecision;
  }

  /* Enhanced video stability and loading */
  .stable-video {
    visibility: hidden; /* Hide until loaded to prevent flicker */
    background: transparent;
    
    /* Enhanced loading transition for textures */
    transition: opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                visibility 0.1s ease-in,
                filter 0.4s ease-out;
  }
  
  .stable-video.loaded {
    visibility: visible;
    
    /* Enhanced quality when texture is loaded */
    image-rendering: -webkit-optimize-contrast;
    image-rendering: optimize-contrast;
  }
  
  /* Prevent video flickering during load with enhanced texture loading */
  .stable-video:not(.loaded) {
    opacity: 0 !important;
    filter: brightness(0.6) contrast(0.9) saturate(0.9) blur(1px);
  }
  
  .stable-video.loaded {
    opacity: var(--video-opacity, 0.7) !important;
  }
  
  /* Avoid flash of images by disallowing default poster rendering */
  video::-webkit-media-controls-enclosure { display: none !important; }
  
  /* Ensure videos maintain aspect ratio and maximum quality */
  .stable-video {
    object-position: center center;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: optimize-contrast;
  }
  
  /* High-quality mobile optimizations for textures */
  @media (max-width: 768px) {
    .ultra-quality-texture {
      /* Optimized mobile rendering for textures */
      transform: translate3d(0, 0, 0) translateZ(0);
      -webkit-transform: translate3d(0, 0, 0) translateZ(0);
      
      /* Mobile-specific texture quality - enhanced for sharpness */
      image-rendering: -webkit-optimize-contrast;
      image-rendering: optimize-contrast;
      image-rendering: crisp-edges;
      
      /* Enhanced mobile performance for textures */
      will-change: transform, opacity;
      transition: opacity 0.5s ease-out, filter 0.3s ease-out;
      
      /* Mobile quality preservation */
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
      -webkit-perspective: 1000px;
      perspective: 1000px;
    }
    
    .stable-video {
      transform: translate3d(0, 0, 0); /* Better mobile performance */
      -webkit-transform: translate3d(0, 0, 0);
      
      /* Enhanced mobile video quality */
      image-rendering: -webkit-optimize-contrast;
      image-rendering: optimize-contrast;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
    }
    
    .stable-video.loaded {
      /* Maintain quality on mobile */
      image-rendering: -webkit-optimize-contrast;
      image-rendering: optimize-contrast;
    }
  }
  
  /* Small mobile devices - extra quality optimization */
  @media (max-width: 480px) {
    .ultra-quality-texture {
      /* Force maximum quality on small screens */
      image-rendering: -webkit-optimize-contrast !important;
      image-rendering: optimize-contrast !important;
      
      /* Prevent quality degradation on small screens */
      min-width: 100%;
      min-height: 100%;
      object-fit: cover;
      object-position: center center;
    }
    
    .stable-video {
      /* Enhanced small screen quality */
      image-rendering: -webkit-optimize-contrast !important;
      image-rendering: optimize-contrast !important;
    }
  }
  
  /* High-resolution display optimizations for textures */
  @media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
    .ultra-quality-texture {
      /* Enhanced texture quality for retina displays */
      image-rendering: -webkit-optimize-contrast;
      image-rendering: optimize-contrast;
    }
  }
  
  /* 4K display optimizations for textures */
  @media (min-width: 2560px) {
    .ultra-quality-texture {
      /* Maximum texture quality for 4K displays */
      image-rendering: -webkit-optimize-contrast;
      image-rendering: optimize-contrast;
    }
  }
  
  /* Enhanced color gamut support for textures */
  @media (color-gamut: p3) {
    .ultra-quality-texture {
      filter: brightness(1.2) contrast(1.25) saturate(1.35) hue-rotate(0deg) blur(0px);
    }
  }
  
  @media (color-gamut: rec2020) {
    .ultra-quality-texture {
      filter: brightness(1.22) contrast(1.28) saturate(1.38) hue-rotate(0deg) blur(0px);
    }
  }
</style>
