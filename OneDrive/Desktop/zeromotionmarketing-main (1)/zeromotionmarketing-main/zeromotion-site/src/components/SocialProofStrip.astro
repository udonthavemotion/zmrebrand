---
// Social Proof Strip - Trust signals above pricing
---

<section class="social-proof-strip bg-gradient-to-r from-purple-900/20 to-black py-12 border-y border-white/10">
  <div class="container-page">
    <!-- Metrics Row -->
    <div class="grid md:grid-cols-3 gap-6 text-center">
      <div class="proof-card">
        <div class="text-4xl font-bold text-purple-400 mb-2">7–10d</div>
        <div class="text-white/70 text-sm">Typical launch timeline</div>
      </div>
      <div class="proof-card">
        <div class="text-4xl font-bold text-purple-400 mb-2">Same‑day</div>
        <div class="text-white/70 text-sm">Responses to new leads</div>
      </div>
      <div class="proof-card">
        <div class="text-4xl font-bold text-purple-400 mb-2">40+</div>
        <div class="text-white/70 text-sm">Projects delivered</div>
      </div>
    </div>
  </div>
</section>

<style>
  .proof-card {
    transition: transform 0.3s ease;
  }
  
  .proof-card:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .badge {
      font-size: 0.75rem;
      padding: 0.5rem 0.75rem;
    }
  }
</style>

