---
// Reusable video background component for sections
export interface Props {
  src?: string;
  poster?: string;
  opacity?: number;
}

const { src, poster, opacity = 0.22 } = Astro.props;
---

<div class="zm-video-bg" style={`--bg-opacity:${opacity}`}>
  {src && (
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      src={src}
      poster={poster ?? ''}
      class="zm-video-el"
      aria-hidden="true"
      role="img"
    ></video>
  )}
  <div class="zm-video-overlay"></div>
  <slot />
</div>

<style>
  .zm-video-bg {
    position: relative;
    isolation: isolate;
  }

  .zm-video-el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    pointer-events: none;
    filter: saturate(1.05);
  }

  .zm-video-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(120% 120% at 50% 20%, rgba(74,0,255,.35), transparent 60%),
                linear-gradient(rgba(0,0,0,var(--bg-opacity)), rgba(0,0,0,var(--bg-opacity)));
  }
</style>
