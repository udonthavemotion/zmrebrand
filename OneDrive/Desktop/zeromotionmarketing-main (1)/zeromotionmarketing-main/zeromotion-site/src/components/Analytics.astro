---
// Analytics Component - Comprehensive tracking setup
// Handles GA4, GTM, Facebook Pixel, LinkedIn Insight Tag, Hotjar, and Clarity
export interface Props {
  enableServerSide?: boolean;
  cookieConsent?: boolean;
}

const { 
  enableServerSide = false,
  cookieConsent = true
} = Astro.props as Props;

// Analytics IDs from environment
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
const fbPixelId = import.meta.env.PUBLIC_FB_PIXEL_ID;
const linkedInPartnerId = import.meta.env.PUBLIC_LINKEDIN_PARTNER_ID;
const hotjarId = import.meta.env.PUBLIC_HOTJAR_ID;
const clarityId = import.meta.env.PUBLIC_CLARITY_ID;
const gtmServerUrl = import.meta.env.PUBLIC_GTM_SERVER_URL;

// Get current page info for tracking
const currentUrl = Astro.url.pathname;
const isHomePage = currentUrl === '/';
const isPricingPage = currentUrl.includes('/pricing');
const isServicePage = currentUrl.includes('/services');
const isPlanPage = currentUrl.includes('/plans');
---

<!-- Google Tag Manager -->
{gtmId && (
  <>
    <script is:inline define:vars={{ gtmId, gtmServerUrl, enableServerSide }}>
      // Initialize dataLayer before GTM
      window.dataLayer = window.dataLayer || [];
      
      // Enhanced dataLayer with page context
      window.dataLayer.push({
        'event': 'page_view_enhanced',
        'page_title': document.title,
        'page_location': window.location.href,
        'page_path': window.location.pathname,
        'page_type': isPricingPage ? 'pricing' : isServicePage ? 'service' : isPlanPage ? 'plan' : isHomePage ? 'home' : 'other',
        'timestamp': Date.now(),
        'user_agent': navigator.userAgent,
        'screen_resolution': screen.width + 'x' + screen.height,
        'viewport_size': window.innerWidth + 'x' + window.innerHeight
      });

      // GTM initialization
      (function(w,d,s,l,i){
        w[l]=w[l]||[];w[l].push({'gtm.start': new Date().getTime(),event:'gtm.js'});
        var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
        j.async=true;
        
        // Use server-side GTM if configured
        if (enableServerSide && gtmServerUrl) {
          j.src = gtmServerUrl + '/gtm.js?id=' + i + dl;
        } else {
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        }
        
        j.crossOrigin = 'anonymous';
        f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer', gtmId);
    </script>
  </>
)}

<!-- GA4 Direct Implementation (fallback if GTM not available) -->
{ga4Id && !gtmId && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
    <script is:inline define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', ga4Id, {
        send_page_view: false, // We'll send custom page views
        anonymize_ip: true,
        allow_google_signals: true,
        allow_ad_personalization_signals: false // GDPR compliance
      });
      
      // Enhanced page view
      gtag('event', 'page_view', {
        page_title: document.title,
        page_location: window.location.href,
        page_path: window.location.pathname
      });
    </script>
  </>
)}

<!-- Facebook Pixel -->
{fbPixelId && (
  <script is:inline define:vars={{ fbPixelId }}>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    
    fbq('init', fbPixelId);
    fbq('track', 'PageView');
    
    // Enhanced Facebook tracking
    fbq('track', 'ViewContent', {
      content_type: 'website',
      content_category: isPricingPage ? 'pricing' : isServicePage ? 'service' : 'general'
    });
  </script>
)}

<!-- LinkedIn Insight Tag -->
{linkedInPartnerId && (
  <script is:inline define:vars={{ linkedInPartnerId }}>
    _linkedin_partner_id = linkedInPartnerId;
    window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
    window._linkedin_data_partner_ids.push(_linkedin_partner_id);
  </script>
)}

<!-- Hotjar Tracking -->
{hotjarId && (
  <script is:inline define:vars={{ hotjarId }}>
    (function(h,o,t,j,a,r){
      h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
      h._hjSettings={hjid:hotjarId,hjsv:6};
      a=o.getElementsByTagName('head')[0];
      r=o.createElement('script');r.async=1;
      r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;
      a.appendChild(r);
    })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
  </script>
)}

<!-- Microsoft Clarity -->
{clarityId && (
  <script is:inline define:vars={{ clarityId }}>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", clarityId);
  </script>
)}

<!-- Universal Event Tracking System -->
<script is:inline define:vars={{ currentUrl, isPricingPage, isServicePage, isPlanPage }}>
  // Universal Analytics Event Tracker
  window.ZMAnalytics = {
    // Track any event across all platforms
    track: function(eventName, eventData = {}) {
      const timestamp = Date.now();
      const enhancedData = {
        ...eventData,
        timestamp: timestamp,
        page_path: window.location.pathname,
        page_url: window.location.href,
        page_title: document.title,
        referrer: document.referrer,
        user_agent: navigator.userAgent
      };

      // GTM/GA4 tracking
      if (window.dataLayer) {
        window.dataLayer.push({
          event: eventName,
          ...enhancedData
        });
      }

      // Direct GA4 tracking (fallback)
      if (window.gtag) {
        window.gtag('event', eventName, enhancedData);
      }

      // Facebook Pixel tracking
      if (window.fbq) {
        const fbEventMap = {
          'form_submit': 'Lead',
          'consultation_booking': 'Schedule',
          'pricing_view': 'ViewContent',
          'plan_select': 'InitiateCheckout',
          'video_play': 'ViewContent',
          'download': 'ViewContent'
        };
        
        const fbEventName = fbEventMap[eventName] || 'CustomEvent';
        window.fbq('track', fbEventName, enhancedData);
      }

      // LinkedIn tracking
      if (window.lintrk) {
        window.lintrk('track', { conversion_id: eventName });
      }

      // Hotjar tracking
      if (window.hj) {
        window.hj('event', eventName);
      }

      // Analytics event tracked - eventName, enhancedData
    },

    // Track page views
    trackPageView: function(pagePath) {
      this.track('page_view', {
        page_path: pagePath || window.location.pathname,
        page_type: isPricingPage ? 'pricing' : isServicePage ? 'service' : isPlanPage ? 'plan' : 'other'
      });
    },

    // Track form submissions
    trackFormSubmit: function(formId, planType = null) {
      this.track('form_submit', {
        form_id: formId,
        form_type: 'contact',
        plan_type: planType,
        conversion: true
      });
    },

    // Track consultation bookings
    trackConsultationBooking: function(planType = null) {
      this.track('consultation_booking', {
        plan_type: planType,
        conversion: true,
        value: planType === 'scale' ? 5000 : planType === 'growth' ? 2500 : 1000
      });
    },

    // Track button clicks
    trackButtonClick: function(buttonText, buttonType, destination = null) {
      this.track('button_click', {
        button_text: buttonText,
        button_type: buttonType,
        destination: destination
      });
    },

    // Track video interactions
    trackVideoPlay: function(videoSrc, duration = null) {
      this.track('video_play', {
        video_src: videoSrc,
        video_duration: duration,
        engagement: true
      });
    },

    // Track external link clicks
    trackExternalLink: function(url, linkText) {
      this.track('external_link_click', {
        external_url: url,
        link_text: linkText,
        outbound: true
      });
    },

    // Track PDF downloads
    trackDownload: function(fileName, fileType = 'pdf') {
      this.track('file_download', {
        file_name: fileName,
        file_type: fileType,
        conversion: fileType === 'pdf'
      });
    },

    // Track pricing interactions
    trackPricingView: function(planType) {
      this.track('pricing_view', {
        plan_type: planType,
        page_type: 'pricing'
      });
    },

    // Track scroll depth
    trackScrollDepth: function(percentage) {
      this.track('scroll_depth', {
        scroll_percentage: percentage,
        engagement: true
      });
    }
  };

  // Auto-track page view on load
  window.addEventListener('load', function() {
    if (window.ZMAnalytics) {
      window.ZMAnalytics.trackPageView();
    }
  });
</script>

<!-- LinkedIn Insight Tag (async load) -->
{linkedInPartnerId && (
  <script async src="https://snap.licdn.com/li.lms-analytics/insight.min.js"></script>
)}

<!-- Facebook Pixel noscript -->
{fbPixelId && (
  <noscript>
    <img height="1" width="1" style="display:none" 
         src={`https://www.facebook.com/tr?id=${fbPixelId}&ev=PageView&noscript=1`} />
  </noscript>
)}

