---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import LeadMagnetSection from "../components/LeadMagnetSection.astro";
import ImplementationHierarchySection from "../components/ImplementationHierarchySection.astro";
import ChoiceSection from "../components/ChoiceSection.astro";
import Services from "../components/Services.astro";
import TrustSection from "../components/TrustSection.astro";
import CRMRegistrationCTA from "../components/CRMRegistrationCTA.astro";
import BackgroundSectionVideo from "../components/BackgroundSectionVideo.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";

// SEO Configuration for Homepage
const title = "ZeroMotion | AI-Powered Automation & CRM Solutions | Houma, LA";
const description = "Transform your business with AI-powered automation, CRM systems, and lead conversion tools. Never miss a lead with automated text-back, AI voice agents, and smart workflows. Serving Houma, Thibodaux, and Terrebonne Parish, Louisiana.";
const keywords = "business automation Houma LA, CRM systems Thibodaux Louisiana, AI voice agents Terrebonne Parish, missed call text-back Louisiana, lead conversion automation, ZeroMotion CRM Houma, AI-powered automation Louisiana";
const canonical = "/";
const ogImage = "/favico/android-chrome-512x512.png";

// Homepage Schema - Organization + WebSite
const homepageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "ZeroMotion Marketing",
    "url": "https://zeromotion.marketing",
    "logo": "https://zeromotion.marketing/favico/android-chrome-512x512.png",
    "description": "AI-powered automation platform specializing in CRM systems, missed call text-back, AI voice agents, and lead conversion automation for businesses in Louisiana.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houma",
      "addressRegion": "Louisiana",
      "addressCountry": "United States",
      "postalCode": "70360"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+1-985-303-2016",
      "contactType": "customer service",
      "availableLanguage": "English"
    },
    "sameAs": [
      "https://www.facebook.com/zeromotion",
      "https://www.linkedin.com/company/zeromotion",
      "https://twitter.com/zeromotion"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ZeroMotion Marketing",
    "url": "https://zeromotion.marketing",
    "description": "AI-powered automation and CRM solutions for Louisiana businesses",
    "publisher": {
      "@type": "Organization",
      "name": "ZeroMotion Marketing"
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://zeromotion.marketing/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
];
---

<BaseLayout {title} {description} {keywords} {canonical} {ogImage} schema={homepageSchema}>
  <main>
    <Hero />
    <!-- <LeadMagnetSection /> --><!-- Temporarily hidden until funnel is built out -->
    <ImplementationHierarchySection />
    <BackgroundSectionVideo
      src="/photos/homepage_hero.mp4"
      opacity={0.4}
      brightness={1.0}
      contrast={1.15}
    >
      <Services />
      <TestimonialsSection />
      <TrustSection />
      <CRMRegistrationCTA />
    </BackgroundSectionVideo>
  </main>
</BaseLayout>
