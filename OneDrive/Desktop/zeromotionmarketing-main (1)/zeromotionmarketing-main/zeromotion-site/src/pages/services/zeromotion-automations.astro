---
// ZEROMOTION-WEBDESIGN-COPY-ONLY-2025
import BaseLayout from "../../layouts/BaseLayout.astro";
import ModernBookingModal from "../../components/ModernBookingModal.astro";
import TextureVideoSection from "../../components/sections/TextureVideoSection.astro";
import DarkContentSection from "../../components/sections/DarkContentSection.astro";
import SEOInternalLinks from "../../components/SEOInternalLinks.astro";
import { getAlternatingTexture, getPreloadTextures } from "../../lib/textures.ts";

const base = "/pictures/web design page/";
const HERO_VIDEO = "/assets/implementation/14201828_1920_1080_30fps.mp4";

// Get alternating textures for seamless flow
const texture1 = getAlternatingTexture(0);
const texture2 = getAlternatingTexture(1);
const texture3 = getAlternatingTexture(2);
const texture4 = getAlternatingTexture(3);
const texture5 = getAlternatingTexture(4);

// Preload critical textures for performance
const preloadTextures = getPreloadTextures(3);

// SEO Configuration for ZeroMotion Automations Service Page
const title = "ZeroMotion Automations | Complete Business Automation Platform | ZeroMotion CRM";
const description = "Automate your entire business with ZeroMotion CRM. Review automation, smart booking, pipeline management, lead capture, appointment reminders, and more. Zero manual effort, maximum growth.";
const keywords = "business automation, CRM automation, lead automation, appointment automation, review automation, pipeline automation, smart booking, automated follow-ups";
const canonical = "/services/zeromotion-automations";
const ogImage = "/og-webdesign.png";

// ZeroMotion Automations Service Schema
const automationsSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "ZeroMotion Automations - Complete Business Automation Platform",
    "description": "Complete business automation platform including review automation, smart booking, pipeline management, lead capture, appointment reminders, and custom workflows powered by ZeroMotion CRM.",
    "provider": {
      "@type": "Organization",
      "name": "ZeroMotion Marketing",
      "url": "https://zeromotion.marketing"
    },
    "serviceType": "Business Automation Platform",
    "areaServed": [
      {
        "@type": "Country",
        "name": "United States"
      }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "ZeroMotion Automation Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Review Automation",
            "description": "Automated review requests and management"
          },
          "priceCurrency": "USD"
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Smart Booking & Scheduling",
            "description": "Intelligent appointment booking and calendar automation"
          },
          "priceCurrency": "USD"
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Pipeline Automation",
            "description": "Automated lead pipeline management and nurturing"
          },
          "priceCurrency": "USD"
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What can ZeroMotion Automations do for my business?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ZeroMotion Automations handles everything from lead capture and follow-ups to review requests, appointment scheduling, and pipeline management. It runs 24/7 without manual effort, freeing you to focus on serving customers."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need technical skills to use automations?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. We build and configure all automations for you. You just approve the workflows and let them run. Our team handles all the technical setup and ongoing optimization."
        }
      },
      {
        "@type": "Question",
        "name": "How is this different from other automation tools?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Most automation tools require you to build and maintain everything yourself. ZeroMotion Automations is done-for-you - we build, configure, and optimize everything. Plus, it's all integrated with your website, CRM, and AI agents in one platform."
        }
      }
    ]
  }
];
---

<BaseLayout {title} {description} {keywords} {canonical} {ogImage} schema={automationsSchema}>
  <!-- Preload critical videos and images for smooth experience -->
  <link rel="preload" as="video" href={HERO_VIDEO} type="video/mp4" crossorigin="anonymous" />
  <link rel="dns-prefetch" href="//zeromotion.marketing" />
  <meta name="video-quality" content="ultra-high" />
  <meta name="video-preload" content="auto" />
  {preloadTextures.map(texture => (
    <link rel="preload" as="video" href={texture} />
  ))}
  
  <!-- Preload critical PNG logos for instant loading -->
  <link rel="preload" as="image" href="/assets/implementation/godspeedbulldogs.png" />
  <link rel="preload" as="image" href="/assets/implementation/brisclothing.png" />
  <link rel="preload" as="image" href="/assets/implementation/maxline.png" />
  <link rel="preload" as="image" href="/assets/implementation/android-chrome-512x512.png" />
  <link rel="preload" as="image" href="/assets/implementation/55555.png" />
  
  <!-- Preload comparison section video -->
  <link rel="preload" as="video" href="/assets/implementation/12602693_1920_1080_30fps.mp4" type="video/mp4" crossorigin="anonymous" />
  
  <div class="web-design">
    <section class="hero" data-hero>
      <video
        src={HERO_VIDEO}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        class="hero-video-optimized uhd-video stable-hero-video"
        style="filter: brightness(0.85) contrast(1.25) saturate(1.4) hue-rotate(0deg); will-change: transform; opacity: 0.8;"
        width="3840"
        height="2160"
        onloadstart="this.style.visibility='visible'; this.style.imageRendering='optimizeQuality';"
        oncanplay="this.classList.add('loaded'); this.style.transform='translateZ(0)'; this.preload='auto';"
        onloadeddata="this.style.filter='brightness(0.85) contrast(1.25) saturate(1.4) hue-rotate(0deg) blur(0px)';"
        onloadedmetadata="this.style.opacity='0.8';"
        crossorigin="anonymous"
        disablepictureinpicture
        x-webkit-airplay="deny"
        aria-label="Ultra high-definition 4K hero video showcase"
        data-video-src={HERO_VIDEO}
      ></video>
      <div class="container-page" style="text-align: center;">
        <h1 class="h1" style="margin-bottom: 20px;">Automate Everything. Focus on Growth.</h1>
        <p class="sub" style="max-width: 800px; margin: 0 auto 30px auto;">
          ZeroMotion Automations handles your reviews, bookings, pipelines, follow-ups, and appointment reminders automatically. Built on ZeroMotion CRM, it runs 24/7 without you—zero manual effort, maximum conversion.
        </p>
        <div
          style="display:flex;gap:12px;justify-content:center;margin-top:18px"
        >
          <a
            class="btn btn-primary"
            href="/pricing"
            onclick="window.dataLayer&&dataLayer.push({event:'cta_click',label:'See Automation Plans'})"
            data-event="automations_plans_view"
            ><span class="btn-text-main">See Automation Plans</span></a
          >
          <a
            class="btn-ghost"
            href="#automation-features"
            onclick="window.dataLayer&&dataLayer.push({event:'cta_click',label:'Explore Automations'})"
            data-event="automations_features_view"
            ><span class="btn-text-main">Explore Automations</span></a
          >
        </div>
        <div style="opacity:.7;margin-top:14px">
          Automated • Intelligent • Always On
        </div>
      </div>
    </section>

    <!-- Unified texture section: Feature cards + Integration benefits -->
    <TextureVideoSection textureVideo={texture1}>
      <!-- Automation Categories Overview -->
      <div id="automation-features" class="comparison-section-modern" style="margin-bottom: var(--zm-gap-xl);">
        <div class="comparison-header" style="text-align: center; margin-bottom: 50px;">
          <h2 class="h2" style="color: #ffffff; margin-bottom: 20px; font-weight: 700;">
            Complete Automation Suite Built on ZeroMotion CRM
          </h2>
          <p class="sub" style="color: #e2e8f0; max-width: 700px; margin: 0 auto; opacity: 0.9; font-size: 1.1rem; line-height: 1.6;">
            From lead capture to customer retention—every workflow automated and optimized for growth
          </p>
        </div>
        
        <div class="modern-path-cards" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 30px; max-width: 1000px; margin: 0 auto; justify-content: center;">
          <!-- Lead & Customer Automations -->
          <div class="path-card starter-path" style="border: 2px solid rgba(34, 197, 94, 0.5); background: linear-gradient(135deg, rgba(34, 197, 94, 0.08), rgba(34, 197, 94, 0.03)); position: relative; border-radius: 20px; padding: 35px 25px; overflow: visible; backdrop-filter: blur(10px); transition: all 0.3s ease; min-height: 520px; display: flex; flex-direction: column;">
            <div class="path-badge" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #22c55e, #16a34a); color: white; padding: 6px 18px; border-radius: 20px; font-weight: bold; font-size: 12px; text-transform: uppercase; letter-spacing: 0.8px; box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);">
              🎯 LEAD AUTOMATION
            </div>

            <div style="text-align: center; margin-bottom: 25px;">
              <h3 class="h3" style="color: #22c55e; margin-bottom: 15px; font-weight: 700; font-size: 1.6rem;">Lead & Customer Automations</h3>
              <div class="pricing-compact" style="margin-bottom: 20px;">
                <div style="font-size: 1.8rem; font-weight: bold; color: #ffffff; line-height: 1; margin-bottom: 5px;">Capture & Convert</div>
                <div style="color: #e2e8f0; opacity: 0.8; font-size: 0.9rem;">24/7 Automated Lead Handling</div>
              </div>
            </div>

            <div class="path-description" style="background: rgba(0, 0, 0, 0.25); padding: 20px; border-radius: 12px; margin-bottom: 25px; flex-grow: 1;">
              <p style="color: #e2e8f0; line-height: 1.5; font-size: 0.95rem; margin: 0;">
                Every lead captured, nurtured, and converted automatically. Smart pipelines move prospects through your sales process while you focus on closing deals.
              </p>
            </div>

            <div class="path-features" style="margin-bottom: 25px;">
              <div class="feature-row" style="display: flex; align-items: center; margin-bottom: 10px; padding: 8px 0;">
                <span style="color: #22c55e; font-size: 1.1rem; margin-right: 12px; min-width: 20px;">✓</span>
                <span style="color: #e2e8f0; font-size: 0.9rem;">Missed call text-back automation</span>
              </div>
              <div class="feature-row" style="display: flex; align-items: center; margin-bottom: 10px; padding: 8px 0;">
                <span style="color: #22c55e; font-size: 1.1rem; margin-right: 12px; min-width: 20px;">✓</span>
                <span style="color: #e2e8f0; font-size: 0.9rem;">Smart pipeline management</span>
              </div>
              <div class="feature-row" style="display: flex; align-items: center; margin-bottom: 10px; padding: 8px 0;">
                <span style="color: #22c55e; font-size: 1.1rem; margin-right: 12px; min-width: 20px;">✓</span>
                <span style="color: #e2e8f0; font-size: 0.9rem;">Automated follow-up sequences</span>
              </div>
              <div class="feature-row" style="display: flex; align-items: center; margin-bottom: 10px; padding: 8px 0;">
                <span style="color: #22c55e; font-size: 1.1rem; margin-right: 12px; min-width: 20px;">✓</span>
                <span style="color: #e2e8f0; font-size: 0.9rem;">Lead scoring & prioritization</span>
              </div>
            </div>

            <div class="target-box" style="background: rgba(34, 197, 94, 0.12); padding: 15px; border-radius: 10px; margin-bottom: 20px; border-left: 3px solid #22c55e;">
              <p style="color: #22c55e; font-weight: 600; margin-bottom: 5px; font-size: 0.9rem;">Perfect for:</p>
              <p style="color: #e2e8f0; font-size: 0.85rem; line-height: 1.4; margin: 0;">Businesses that want to capture and convert every lead without manual follow-up</p>
            </div>

            <a href="/pricing" class="path-cta" style="background: linear-gradient(135deg, #22c55e, #16a34a); color: white; text-decoration: none; padding: 14px 20px; border-radius: 10px; font-weight: 600; font-size: 0.95rem; text-align: center; box-shadow: 0 6px 20px rgba(34, 197, 94, 0.3); transition: all 0.3s ease; margin-top: auto;">
              Explore Lead Automations →
            </a>
          </div>

          <!-- Booking & Review Automations -->
          <div class="path-card custom-path" style="border: 2px solid rgba(139, 92, 246, 0.6); background: linear-gradient(135deg, rgba(139, 92, 246, 0.12), rgba(139, 92, 246, 0.05)); position: relative; border-radius: 20px; padding: 35px 25px; overflow: visible; backdrop-filter: blur(10px); transition: all 0.3s ease; min-height: 520px; display: flex; flex-direction: column; box-shadow: 0 15px 35px rgba(139, 92, 246, 0.2);">
            <div class="path-badge" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #8b5cf6, #a855f7); color: white; padding: 6px 18px; border-radius: 20px; font-weight: bold; font-size: 12px; text-transform: uppercase; letter-spacing: 0.8px; box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);">
              📅 SMART SYSTEMS
            </div>

            <div style="text-align: center; margin-bottom: 25px;">
              <h3 class="h3" style="color: #8b5cf6; margin-bottom: 15px; font-weight: 700; font-size: 1.6rem;">Booking & Review Automations</h3>
              <div class="pricing-compact" style="margin-bottom: 20px;">
                <div style="font-size: 1.8rem; font-weight: bold; color: #ffffff; line-height: 1; margin-bottom: 5px;">Schedule & Build Trust</div>
                <div style="color: #e2e8f0; opacity: 0.8; font-size: 0.9rem;">Automated Scheduling & Reputation</div>
              </div>
            </div>

            <div class="path-description" style="background: rgba(0, 0, 0, 0.3); padding: 20px; border-radius: 12px; margin-bottom: 25px; flex-grow: 1;">
              <p style="color: #e2e8f0; line-height: 1.5; font-size: 0.95rem; margin: 0;">
                Smart booking that fills your calendar automatically. Review automation that builds your reputation on autopilot. "We missed you" saves that recover no-shows.
              </p>
            </div>

            <div class="path-features" style="margin-bottom: 25px;">
              <div class="feature-row" style="display: flex; align-items: center; margin-bottom: 10px; padding: 8px 0;">
                <span style="color: #8b5cf6; font-size: 1.1rem; margin-right: 12px; min-width: 20px;">✓</span>
                <span style="color: #e2e8f0; font-size: 0.9rem;">Smart booking & calendar sync</span>
              </div>
              <div class="feature-row" style="display: flex; align-items: center; margin-bottom: 10px; padding: 8px 0;">
                <span style="color: #8b5cf6; font-size: 1.1rem; margin-right: 12px; min-width: 20px;">✓</span>
                <span style="color: #e2e8f0; font-size: 0.9rem;">Automated review requests</span>
              </div>
              <div class="feature-row" style="display: flex; align-items: center; margin-bottom: 10px; padding: 8px 0;">
                <span style="color: #8b5cf6; font-size: 1.1rem; margin-right: 12px; min-width: 20px;">✓</span>
                <span style="color: #e2e8f0; font-size: 0.9rem;">Appointment reminders</span>
              </div>
              <div class="feature-row" style="display: flex; align-items: center; margin-bottom: 10px; padding: 8px 0;">
                <span style="color: #8b5cf6; font-size: 1.1rem; margin-right: 12px; min-width: 20px;">✓</span>
                <span style="color: #e2e8f0; font-size: 0.9rem;">"We missed you" no-show recovery</span>
              </div>
            </div>

            <div class="target-box" style="background: rgba(139, 92, 246, 0.12); padding: 15px; border-radius: 10px; margin-bottom: 20px; border-left: 3px solid #8b5cf6;">
              <p style="color: #8b5cf6; font-weight: 600; margin-bottom: 5px; font-size: 0.9rem;">Perfect for:</p>
              <p style="color: #e2e8f0; font-size: 0.85rem; line-height: 1.4; margin: 0;">Service businesses that need appointments filled and reputation managed automatically</p>
            </div>

            <a href="/pricing" class="path-cta" style="background: linear-gradient(135deg, #8b5cf6, #a855f7); color: white; text-decoration: none; padding: 14px 20px; border-radius: 10px; font-weight: 600; font-size: 0.95rem; text-align: center; box-shadow: 0 6px 20px rgba(139, 92, 246, 0.3); transition: all 0.3s ease; margin-top: auto;">
              Explore Booking & Review Automation →
            </a>
          </div>
        </div>
      </div>

      <!-- Integration benefits section -->
      <div id="integration-benefits" class="merged-integration-section">
        <h2 class="h2" style="color: #06b6d4; text-align: center; margin-bottom: 20px;">Why ZeroMotion Automations Work Better</h2>
        <p class="sub" style="text-align: center; margin-bottom: 50px; color: #e2e8f0;">Built on ZeroMotion CRM, every automation is integrated, intelligent, and optimized for your growth.</p>

        <div class="benefits-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 40px; margin: 40px 0; justify-content: center;">
          <div class="benefit-card card" style="text-align: center; position: relative; border: 2px solid rgba(6, 182, 212, 0.3); transition: all 0.3s ease;">
            <div class="benefit-icon" style="font-size: 3.5rem; color: #06b6d4; margin-bottom: 25px;">🔗</div>
            <h3 class="h3" style="color: #ffffff; margin-bottom: 20px;">Fully Integrated Platform</h3>
            <p style="color: #e2e8f0; line-height: 1.6;">Every automation works together inside ZeroMotion CRM. Website, lead capture, follow-ups, booking, reviews—all in one place.</p>
          </div>

          <div class="benefit-card card" style="text-align: center; position: relative; border: 2px solid rgba(6, 182, 212, 0.3); transition: all 0.3s ease;">
            <div class="benefit-icon" style="font-size: 3.5rem; color: #06b6d4; margin-bottom: 25px;">⚡</div>
            <h3 class="h3" style="color: #ffffff; margin-bottom: 20px;">Done-For-You Setup</h3>
            <p style="color: #e2e8f0; line-height: 1.6;">We build, configure, and optimize every automation for you. No technical skills needed—just approve your workflows and watch them run.</p>
          </div>

          <div class="benefit-card card" style="text-align: center; position: relative; border: 2px solid rgba(6, 182, 212, 0.3); transition: all 0.3s ease;">
            <div class="benefit-icon" style="font-size: 3.5rem; color: #06b6d4; margin-bottom: 25px;">🎯</div>
            <h3 class="h3" style="color: #ffffff; margin-bottom: 20px;">Optimized for Conversion</h3>
            <p style="color: #e2e8f0; line-height: 1.6;">Every workflow is built from proven templates and optimized for your industry. Maximum conversion with zero trial and error.</p>
          </div>
        </div>
      </div>
    </TextureVideoSection>

    <!-- Hero Video section: Custom Builds Engineered for Performance -->
    <section id="custom-builds" class="hero-video-section section">
      <div class="dev-luxury-section">
        <!-- Main headline and subhead -->
        <div class="dev-luxury-header" style="text-align: center; margin-bottom: 50px;">
          <h2 class="h2" style="color: #06b6d4; margin-bottom: 12px; font-size: 2.5rem; font-weight: 700;">Advanced Automation Workflows</h2>
          <p class="sub" style="color: #94a3b8; font-size: 1.2rem; margin-bottom: 24px; font-weight: 500;">Custom-Built for Your Business</p>
          <p class="sub" style="max-width: 800px; margin: 0 auto 20px auto;">
            Not every business needs the same automations. Sometimes you need custom workflows built specifically for your unique process — from complex multi-step pipelines to industry-specific automation sequences. Custom-built on ZeroMotion CRM, optimized for your business.
          </p>
          <p class="sub" style="margin-top: 20px; font-weight: bold; max-width: 800px; margin: 20px auto 0 auto;">
            What makes this different? You're not getting generic templates — you're working directly with our automation team. Every workflow is custom-designed for your business. We treat your automation like it's our own, making sure it feels natural, efficient, and built to scale. You'll never feel like just another template installation.
          </p>
        </div>

        <!-- 2-track grid: Custom Build and Astro Fast Build -->
        <div class="dev-luxury-grid">
          <div class="dev-luxury-content">
            <!-- Advanced Automation Features -->
            <div class="dev-luxury-bullets">
              <div class="dev-bullet">
                <span class="dev-bullet-icon">⚙️</span>
                <div>
                  <strong>Custom workflow design</strong> — Built specifically for your business process, not generic templates
                </div>
              </div>
              <div class="dev-bullet">
                <span class="dev-bullet-icon">🎯</span>
                <div>
                  <strong>Multi-step automation sequences</strong> — Complex pipelines that adapt to your customer journey
                </div>
              </div>
              <div class="dev-bullet">
                <span class="dev-bullet-icon">🔗</span>
                <div>
                  <strong>Third-party integrations</strong> — Connect to your existing tools and systems seamlessly
                </div>
              </div>
              <div class="dev-bullet">
                <span class="dev-bullet-icon">📊</span>
                <div>
                  <strong>Advanced analytics & reporting</strong> — Track every conversion point and optimize continuously
                </div>
              </div>
              <div class="dev-bullet">
                <span class="dev-bullet-icon">🤖</span>
                <div>
                  <strong>AI-powered decision logic</strong> — Smart routing and personalization based on lead behavior
                </div>
              </div>
              <div class="dev-bullet">
                <span class="dev-bullet-icon">👤</span>
                <div>
                  <strong>Direct automation specialist support</strong> — Your workflows aren't passed off to support tickets
                </div>
              </div>
            </div>

            <!-- ZeroMotion CRM Automation Capabilities -->
            <div class="dev-crm-wiring">
              <h3 class="h4">ZeroMotion CRM Advanced Capabilities</h3>
              <div class="crm-features">
                <span>Multi-Pipeline Management</span>
                <span>Conditional Logic</span>
                <span>Smart Routing</span>
                <span>Webhooks & API</span>
                <span>Custom Triggers</span>
                <span>A/B Testing</span>
                <span>Advanced Segmentation</span>
              </div>
            </div>

            <!-- Best for section -->
            <div class="dev-operators-row">
              <strong>Best for:</strong> Established businesses, complex sales processes, or companies with unique workflows who need automation built specifically for their operations, not one-size-fits-all templates.
            </div>

            <!-- CTAs -->
            <div class="dev-luxury-ctas">
              <a
                href="/pricing"
                class="btn-primary"
                aria-label="Request advanced automation quote"
                onclick="window.dataLayer&&dataLayer.push({event:'cta_click',label:'Request Advanced Automation Quote'})"
              >
                Request Advanced Automation Quote
              </a>
              <button
                type="button"
                class="btn-ghost"
                aria-label="Schedule automation consultation"
                onclick="openStrategistModal('automations-advanced'); window.dataLayer&&dataLayer.push({event:'cta_click',label:'Talk to Automation Specialist'})"
              >
                Talk to an Automation Specialist
              </button>
            </div>

            <!-- Closing line -->
            <div class="dev-closing-line">
              Whether you need standard automations to get started, or advanced custom workflows built for your unique process, ZeroMotion Automations makes sure your business runs on autopilot — capturing leads, booking appointments, and building your reputation while you focus on serving customers. And if you choose advanced automation, you're not just getting templates — you're getting workflows custom-designed for your success.
            </div>
          </div>

        </div>

      </div>

      <!-- Hero Video Background -->
      <video 
        src="/photos/homepage_hero.mp4" 
        autoplay 
        muted 
        loop 
        playsinline
        preload="auto"
        class="hero-background-video stable-hero-video"
        style="opacity: 0.8; filter: brightness(0.8) contrast(1.1) saturate(1.2); will-change: transform;"
        onloadstart="this.style.visibility='visible'"
        oncanplay="this.classList.add('loaded')"
        width="1920"
        height="1080"
        aria-hidden="true"
        role="img"
        aria-label="Background video showing ZeroMotion's development process"
      ></video>

      <!-- Overlay gradient for text readability -->
      <div class="hero-video-overlay"></div>
    </section>

    <!-- Website Development Process -->
    <section class="hero-video-section section">
