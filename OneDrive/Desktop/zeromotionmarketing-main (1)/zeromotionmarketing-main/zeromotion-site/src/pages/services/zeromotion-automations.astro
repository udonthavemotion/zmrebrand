    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      // Web Design Page - Advanced video optimization for background videos
      document.addEventListener('DOMContentLoaded', function() {
        const heroVideo = document.querySelector('.web-design .uhd-video');
        const comparisonVideo = document.querySelector('.web-design .comparison-background-video');
        const extendedVideo = document.querySelector('.web-design .extended-hero-background-video');

        // Helper function to optimize video loading
        function optimizeVideo(video, videoType) {
          if (!video) return;

          // Force maximum quality settings
          video.setAttribute('playsinline', 'true');
          video.setAttribute('webkit-playsinline', 'true');
          video.setAttribute('x5-playsinline', 'true');

          // Enhanced loading for quality
          video.addEventListener('loadstart', function() {
            this.style.imageRendering = 'optimizeQuality';
            this.style.visibility = 'visible';
          });

          video.addEventListener('canplay', function() {
            this.classList.add('loaded');
            this.style.transform = 'translateZ(0)';
            if (videoType === 'hero') {
              this.style.filter = 'brightness(0.85) contrast(1.25) saturate(1.4) hue-rotate(0deg) blur(0px)';
            } else if (videoType === 'comparison') {
              this.style.filter = 'brightness(0.75) contrast(1.15) saturate(1.3) hue-rotate(0deg) blur(0px)';
            } else {
              this.style.filter = 'brightness(0.8) contrast(1.1) saturate(1.2) hue-rotate(0deg) blur(0px)';
            }
            // Switch to auto preload for full video loading
            this.preload = 'auto';
          });

          video.addEventListener('loadeddata', function() {
            this.style.imageRendering = 'optimizeQuality';
            this.style.transform = 'translateZ(0) translate3d(0, 0, 0)';
          });

          video.addEventListener('play', function() {
            this.style.imageRendering = 'optimizeQuality';
          });

          // Handle quality degradation prevention
          video.addEventListener('waiting', function() {
            this.style.imageRendering = 'optimizeQuality';
          });

          // Ensure video loads on Vercel
          video.addEventListener('error', function() {
            console.warn(`${videoType} video failed to load, retrying...`);
            setTimeout(() => {
              this.load();
            }, 1000);
          });
        }

        // Optimize all videos
        optimizeVideo(heroVideo, 'hero');
        optimizeVideo(comparisonVideo, 'comparison');
        optimizeVideo(extendedVideo, 'extended');

        // Enhanced PNG logo loading for Vercel deployment
        const logoImages = document.querySelectorAll('.seamless-logo');
        logoImages.forEach((img, index) => {
          img.addEventListener('load', function() {
            this.style.opacity = '1';
            this.style.transform = 'scale(1)';
          });

          img.addEventListener('error', function() {
            console.warn(`Logo image failed to load: ${this.src}`);
            // Retry loading after a short delay
            setTimeout(() => {
              const originalSrc = this.src;
              this.src = '';
              this.src = originalSrc;
            }, 500 + (index * 100));
          });

          // Ensure images are visible when loaded
          if (img.complete && img.naturalHeight !== 0) {
            img.style.opacity = '1';
            img.style.transform = 'scale(1)';
          } else {
            img.style.opacity = '0';
            img.style.transform = 'scale(0.9)';
            img.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
          }
        });

        // Modern FAQ Accordion Functionality
        const faqItems = document.querySelectorAll('[data-faq-item]');
        
        faqItems.forEach(item => {
          const trigger = item.querySelector('[data-faq-trigger]');
          const content = item.querySelector('[data-faq-content]');
          
          if (trigger && content) {
            trigger.addEventListener('click', () => {
              const isActive = item.classList.contains('active');
              
              // Close all other FAQ items
              faqItems.forEach(otherItem => {
                if (otherItem !== item) {
                  otherItem.classList.remove('active');
                  const otherTrigger = otherItem.querySelector('[data-faq-trigger]');
                  if (otherTrigger) {
                    otherTrigger.setAttribute('aria-expanded', 'false');
                  }
                }
              });
              
              // Toggle current item
              if (isActive) {
                item.classList.remove('active');
                trigger.setAttribute('aria-expanded', 'false');
              } else {
                item.classList.add('active');
                trigger.setAttribute('aria-expanded', 'true');
                
                // Smooth scroll to ensure visibility on mobile
                setTimeout(() => {
                  const rect = item.getBoundingClientRect();
                  const isVisible = rect.top >= 0 && rect.bottom <= window.innerHeight;
                  
                  if (!isVisible) {
                    item.scrollIntoView({
                      behavior: 'smooth',
                      block: 'center'
                    });
                  }
                }, 200);
              }
            });

            // Keyboard accessibility
            trigger.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                trigger.click();
              }
            });
          }
        });
      });
      
      document.addEventListener(
        "submit",
        function (e) {
          var target = e.target;
          if (target && target.closest && target.closest("[data-gf-form]")) {
            window.dataLayer.push({
              event: "form_submit",
              label: "ZRM Web Design Form",
            });
          }
        },
        true,
      );
    </script>

