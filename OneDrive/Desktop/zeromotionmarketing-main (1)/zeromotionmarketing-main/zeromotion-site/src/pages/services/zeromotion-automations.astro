---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackgroundSectionVideo from "../../components/BackgroundSectionVideo.astro";
import LimitedSpotsAlert from "../../components/LimitedSpotsAlert.astro";
import ROICalculator from "../../components/ROICalculator.astro";

const title = "ZeroMotion Automations | Your Business, Running on Autopilot | ZeroMotion CRM";
const description = "Smart booking, review automation, pipeline management, appointment reminders—all working 24/7. Reclaim 15+ hours per week while booking 40% more jobs. Zero manual work.";
const keywords = "business automation Louisiana, CRM automation, appointment reminders, review automation, pipeline management, booking automation Houma, ZeroMotion CRM";
const canonical = "/services/zeromotion-automations";
const ogImage = "/favico/android-chrome-512x512.png";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "ZeroMotion Business Automations",
  "description": "Complete business automation system including smart booking, review requests, pipeline management, and appointment reminders",
  "provider": {
    "@type": "Organization",
    "name": "ZeroMotion Marketing",
    "url": "https://zeromotion.marketing"
  },
  "areaServed": {
    "@type": "State",
    "name": "Louisiana"
  },
  "audience": {
    "@type": "BusinessAudience",
    "audienceType": "Small Business Owners"
  }
};
---

<BaseLayout {title} {description} {keywords} {canonical} {ogImage} {schema}>
  <main>
    <BackgroundSectionVideo
      src="/photos/homepage_hero.mp4"
      opacity={0.6}
      brightness={0.9}
      contrast={1.15}
    >
      <!-- Hero Section -->
      <section class="section-padding text-center">
        <div class="container-page max-w-4xl mx-auto">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/20 border border-purple-500/30 text-purple-200 text-sm font-medium mb-6">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span>Complete Automation Suite</span>
          </div>

          <h1 class="h1 mb-6">Your Business, Running on Autopilot</h1>

          <p class="text-white/90 text-xl mb-8 leading-relaxed max-w-3xl mx-auto">
            You're stuck doing $15/hour tasks when you should be closing deals. ZeroMotion Automations handles booking, reminders, reviews, and follow-ups—24/7, without you lifting a finger.
          </p>

          <div class="flex justify-center mb-6">
            <LimitedSpotsAlert spotsLeft={7} planName="ZeroMotion Automations" />
          </div>

          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
            <button
              type="button"
              class="btn-primary btn-lg"
              onclick="openStrategistModal('automations-hero'); window.dataLayer&&dataLayer.push({event:'cta_click',location:'automations-hero',service:'automations'})"
            >
              <span class="btn-text-main">Book Free CRM Strategy Call</span>
            </button>
            <a href="/quiz" class="btn-ghost btn-lg">
              <span class="btn-text-main">Take Our Quiz</span>
            </a>
          </div>

          <!-- Quick Stats -->
          <div class="grid md:grid-cols-3 gap-6 mt-12">
            <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl p-6 hover:bg-white/10 transition-all">
              <div class="text-4xl font-bold text-primary mb-2">80%</div>
              <div class="text-white/70 text-sm">Reduction in Manual Tasks</div>
            </div>
            <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl p-6 hover:bg-white/10 transition-all">
              <div class="text-4xl font-bold text-primary mb-2">50%</div>
              <div class="text-white/70 text-sm">Fewer No-Shows</div>
            </div>
            <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl p-6 hover:bg-white/10 transition-all">
              <div class="text-4xl font-bold text-primary mb-2">3X</div>
              <div class="text-white/70 text-sm">More Reviews (No Asking)</div>
            </div>
          </div>
        </div>
      </section>

      <!-- The Problem -->
      <section class="section-padding">
        <div class="container-page max-w-4xl mx-auto text-center">
          <h2 class="h2 mb-6">You're Working IN Your Business, Not ON It</h2>
          <div class="space-y-6 text-lg text-white/80">
            <p>
              Every day, you're sending appointment reminders. Chasing down reviews. Following up with leads. Managing calendars. Texting customers.
            </p>
            <p class="text-2xl font-semibold text-primary">
              That's 10-15 hours per week you'll never get back.
            </p>
            <p>
              Meanwhile, your competitors are automating everything and focusing on growth. They're booking more jobs, getting more reviews, and converting more leads—while you're still manually texting appointment confirmations.
            </p>
            <p>
              <strong class="text-white">The brutal truth:</strong> If you're doing repetitive tasks manually in 2025, you're leaving money on the table.
            </p>
          </div>

          <div class="mt-12 bg-purple-500/10 border border-purple-500/30 rounded-xl p-8 backdrop-blur-sm">
            <h3 class="text-2xl font-bold text-primary mb-4">What Could You Do With 15 Extra Hours Per Week?</h3>
            <div class="grid md:grid-cols-3 gap-6 text-white/90 mt-6">
              <div>
                <div class="text-3xl mb-2">💰</div>
                <p class="font-semibold">Close More Deals</p>
                <p class="text-sm text-white/60">Focus on high-value sales instead of admin work</p>
              </div>
              <div>
                <div class="text-3xl mb-2">🏖️</div>
                <p class="font-semibold">Actually Take Time Off</p>
                <p class="text-sm text-white/60">Business runs smoothly even when you're gone</p>
              </div>
              <div>
                <div class="text-3xl mb-2">📈</div>
                <p class="font-semibold">Scale Your Business</p>
                <p class="text-sm text-white/60">Handle 2X the customers without hiring</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- What's Automated -->
      <section class="section-padding">
        <div class="container-page max-w-5xl mx-auto">
          <h2 class="h2 text-center mb-12">What ZeroMotion Automations Handles for You</h2>

          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-gradient-to-br from-purple-500/10 to-violet-500/10 border border-purple-500/20 rounded-xl p-8 backdrop-blur-sm">
              <div class="flex items-start gap-4 mb-4">
                <div class="text-4xl">📅</div>
                <div>
                  <h3 class="h3 mb-2">Smart Appointment Booking</h3>
                  <p class="text-white/70 leading-relaxed">
                    Customers book directly from SMS, email, or your website. Calendar syncs automatically. Conflicts prevented. Double-bookings impossible.
                  </p>
                </div>
              </div>
              <ul class="space-y-2 text-white/60 text-sm ml-14">
                <li>✓ Google Calendar & Outlook sync</li>
                <li>✓ Booking confirmations sent automatically</li>
                <li>✓ Buffer time between appointments</li>
                <li>✓ Team calendar management</li>
              </ul>
            </div>

            <div class="bg-gradient-to-br from-purple-500/10 to-violet-500/10 border border-purple-500/20 rounded-xl p-8 backdrop-blur-sm">
              <div class="flex items-start gap-4 mb-4">
                <div class="text-4xl">⏰</div>
                <div>
                  <h3 class="h3 mb-2">Appointment Reminders</h3>
                  <p class="text-white/70 leading-relaxed">
                    Automated SMS/email reminders sent 24 hours before appointments. Reduces no-shows by 50%+. Customers can confirm or reschedule with one click.
                  </p>
                </div>
              </div>
              <ul class="space-y-2 text-white/60 text-sm ml-14">
                <li>✓ 24-hour and 2-hour reminder options</li>
                <li>✓ One-click confirm/reschedule</li>
                <li>✓ Custom reminder messaging</li>
                <li>✓ Automatic follow-up for no-shows</li>
              </ul>
            </div>

            <div class="bg-gradient-to-br from-purple-500/10 to-violet-500/10 border border-purple-500/20 rounded-xl p-8 backdrop-blur-sm">
              <div class="flex items-start gap-4 mb-4">
                <div class="text-4xl">⭐</div>
                <div>
                  <h3 class="h3 mb-2">Automated Review Requests</h3>
                  <p class="text-white/70 leading-relaxed">
                    After every completed job, ZeroMotion automatically sends a review request. Timing is perfect, message is personalized, link goes straight to Google.
                  </p>
                </div>
              </div>
              <ul class="space-y-2 text-white/60 text-sm ml-14">
                <li>✓ Post-service review requests</li>
                <li>✓ Direct link to Google Business Profile</li>
                <li>✓ Custom message templates</li>
                <li>✓ Multi-platform review generation</li>
              </ul>
            </div>

            <div class="bg-gradient-to-br from-purple-500/10 to-violet-500/10 border border-purple-500/20 rounded-xl p-8 backdrop-blur-sm">
              <div class="flex items-start gap-4 mb-4">
                <div class="text-4xl">🔄</div>
                <div>
                  <h3 class="h3 mb-2">Pipeline Management</h3>
                  <p class="text-white/70 leading-relaxed">
                    Leads automatically enter your pipeline. Follow-up sequences trigger based on behavior. Hot leads flagged for immediate attention. Cold leads nurtured until they're ready.
                  </p>
                </div>
              </div>
              <ul class="space-y-2 text-white/60 text-sm ml-14">
                <li>✓ Auto lead assignment</li>
                <li>✓ Stage-based workflows</li>
                <li>✓ Smart lead scoring</li>
                <li>✓ Abandoned cart recovery</li>
              </ul>
            </div>

            <div class="bg-gradient-to-br from-purple-500/10 to-violet-500/10 border border-purple-500/20 rounded-xl p-8 backdrop-blur-sm">
              <div class="flex items-start gap-4 mb-4">
                <div class="text-4xl">💬</div>
                <div>
                  <h3 class="h3 mb-2">Two-Way SMS Conversations</h3>
                  <p class="text-white/70 leading-relaxed">
                    Customers text your business number, you respond from CRM. Full conversation history. Smart templates for common questions. Never lose context.
                  </p>
                </div>
              </div>
              <ul class="space-y-2 text-white/60 text-sm ml-14">
                <li>✓ Unified inbox for all SMS</li>
                <li>✓ Conversation history synced to CRM</li>
                <li>✓ Quick-reply templates</li>
                <li>✓ Team collaboration on messages</li>
              </ul>
            </div>

            <div class="bg-gradient-to-br from-purple-500/10 to-violet-500/10 border border-purple-500/20 rounded-xl p-8 backdrop-blur-sm">
              <div class="flex items-start gap-4 mb-4">
                <div class="text-4xl">📧</div>
                <div>
                  <h3 class="h3 mb-2">Lead Nurture Sequences</h3>
                  <p class="text-white/70 leading-relaxed">
                    Not every lead is ready to buy today. Automated nurture sequences keep you top-of-mind until they're ready. Email + SMS drip campaigns that actually convert.
                  </p>
                </div>
              </div>
              <ul class="space-y-2 text-white/60 text-sm ml-14">
                <li>✓ Pre-built campaign templates</li>
                <li>✓ Behavior-triggered sequences</li>
                <li>✓ Email + SMS multi-channel</li>
                <li>✓ A/B testing built-in</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- How It Works -->
      <section class="section-padding">
        <div class="container-page max-w-5xl mx-auto">
          <h2 class="h2 text-center mb-12">How ZeroMotion Automations Work</h2>

          <div class="grid md:grid-cols-4 gap-6">
            <div class="text-center">
              <div class="w-20 h-20 bg-purple-500/20 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-purple-500/30">
                <span class="text-3xl font-bold text-primary">1</span>
              </div>
              <h3 class="h3 mb-3">We Build Your Workflows</h3>
              <p class="text-white/70 leading-relaxed text-sm">
                We map your current processes and design custom automation workflows tailored to your business.
              </p>
            </div>

            <div class="text-center">
              <div class="w-20 h-20 bg-purple-500/20 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-purple-500/30">
                <span class="text-3xl font-bold text-primary">2</span>
              </div>
              <h3 class="h3 mb-3">Automations Launch</h3>
              <p class="text-white/70 leading-relaxed text-sm">
                We configure everything inside ZeroMotion CRM. You test, we refine, then we flip the switch.
              </p>
            </div>

            <div class="text-center">
              <div class="w-20 h-20 bg-purple-500/20 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-purple-500/30">
                <span class="text-3xl font-bold text-primary">3</span>
              </div>
              <h3 class="h3 mb-3">Your Business Runs Itself</h3>
              <p class="text-white/70 leading-relaxed text-sm">
                Leads captured. Appointments booked. Reminders sent. Reviews requested. All automatic.
              </p>
            </div>

            <div class="text-center">
              <div class="w-20 h-20 bg-purple-500/20 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-purple-500/30">
                <span class="text-3xl font-bold text-primary">4</span>
              </div>
              <h3 class="h3 mb-3">We Optimize Over Time</h3>
              <p class="text-white/70 leading-relaxed text-sm">
                Monthly performance reports. We tweak workflows to improve conversion, reduce no-shows, and maximize ROI.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Real Example -->
      <section class="section-padding">
        <div class="container-page max-w-3xl mx-auto">
          <div class="bg-gradient-to-br from-purple-500/20 to-violet-500/20 border border-purple-500/30 rounded-2xl p-8 backdrop-blur-sm">
            <h2 class="h2 text-center mb-6">Real Example: Thibodaux HVAC</h2>
            <div class="space-y-4 text-white/90">
              <p class="text-lg">
                <strong>Before ZeroMotion CRM:</strong> Owner spent 10 hours/week on follow-ups, reminders, and review requests. 20% no-show rate. 12 Google reviews total.
              </p>
              <p class="text-lg">
                <strong>After Automations:</strong> Zero hours spent on admin. No-show rate dropped to 8%. Generated 47 new reviews in 90 days. Booked 40% more jobs with the same traffic.
              </p>
              <div class="bg-black/30 rounded-lg p-6 mt-6 border border-purple-500/20">
                <p class="text-xl font-semibold text-primary mb-2">
                  "I got 15 hours per week back. Used that time to close deals instead of chasing reminders. Revenue up 35% in 3 months."
                </p>
                <p class="text-white/70 text-sm">
                  —Mike Thibodeaux, Owner
                </p>
              </div>
              <div class="grid grid-cols-3 gap-4 mt-8 text-center">
                <div>
                  <div class="text-3xl font-bold text-primary">15hrs</div>
                  <div class="text-sm text-white/60">Saved Per Week</div>
                </div>
                <div>
                  <div class="text-3xl font-bold text-primary">47</div>
                  <div class="text-sm text-white/60">Reviews in 90 Days</div>
                </div>
                <div>
                  <div class="text-3xl font-bold text-primary">40%</div>
                  <div class="text-sm text-white/60">More Jobs Booked</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- What You Get -->
      <section class="section-padding">
        <div class="container-page max-w-4xl mx-auto">
          <h2 class="h2 text-center mb-12">Everything Included in ZeroMotion Automations</h2>

          <div class="grid md:grid-cols-2 gap-4">
            {[
              "Smart appointment booking & calendar sync",
              "Automated appointment reminders (SMS + email)",
              "Post-service review request automation",
              "Pipeline management with auto-follow-ups",
              "Lead nurture email & SMS sequences",
              "Two-way SMS conversation tracking",
              "\"We missed you\" re-engagement campaigns",
              "Weekly performance & analytics reports",
              "Abandoned cart/quote recovery",
              "Birthday & anniversary campaigns",
              "Referral request automation",
              "Custom workflow design & setup"
            ].map(feature => (
              <div class="flex items-start gap-4 p-4 bg-white/5 border border-white/10 rounded-xl backdrop-blur-sm hover:bg-white/10 transition-all">
                <svg class="w-6 h-6 text-primary flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span class="text-white/90">{feature}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ROI Calculator -->
      <ROICalculator
        title="Calculate Your Automation ROI"
        subtitle="See how many hours you're spending on manual tasks—and how much revenue you'd gain with 24/7 automation."
      />

      <!-- Perfect For -->
      <section class="section-padding">
        <div class="container-page max-w-4xl mx-auto">
          <h2 class="h2 text-center mb-12">Perfect for Louisiana Service Businesses</h2>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {[
              { icon: "❄️", name: "HVAC Companies" },
              { icon: "🔧", name: "Plumbers" },
              { icon: "⚡", name: "Electricians" },
              { icon: "🏠", name: "Real Estate Agents" },
              { icon: "👨‍⚖️", name: "Law Firms" },
              { icon: "🏥", name: "Medical Practices" },
              { icon: "💇", name: "Salons & Spas" },
              { icon: "🚗", name: "Auto Repair" },
              { icon: "🏗️", name: "Contractors" }
            ].map(biz => (
              <div class="bg-white/5 border border-white/10 rounded-xl p-6 text-center hover:bg-white/10 transition-all backdrop-blur-sm">
                <div class="text-4xl mb-3">{biz.icon}</div>
                <div class="text-white font-medium">{biz.name}</div>
              </div>
            ))}
          </div>

          <p class="text-white/70 text-center mt-8 max-w-2xl mx-auto">
            Any appointment-based business in Louisiana that's tired of manual admin work. If you're sending reminders manually, you need automations.
          </p>
        </div>
      </section>

      <!-- Mid-Page CTA -->
      <section class="section-padding">
        <div class="container-page max-w-3xl mx-auto text-center">
          <div class="bg-gradient-to-br from-purple-600/20 to-violet-600/20 border border-purple-500/30 rounded-2xl p-12 backdrop-blur-sm">
            <h2 class="h2 mb-4">Reclaim Your Time. Grow Your Business.</h2>
            <p class="text-white/80 text-lg mb-8">
              Book a free CRM strategy call. We'll map your current workflow and show you exactly what we can automate.
            </p>
            <button
              type="button"
              class="btn-primary btn-lg"
              onclick="openStrategistModal('automations-mid'); window.dataLayer&&dataLayer.push({event:'cta_click',location:'automations-mid',service:'automations'})"
            >
              <span class="btn-text-main">Book Free CRM Strategy Call</span>
            </button>
            <p class="text-white/50 text-sm mt-4">
              30-minute call • Zero obligation • Custom automation strategy
            </p>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="section-padding">
        <div class="container-page max-w-3xl mx-auto">
          <h2 class="h2 text-center mb-12">Common Questions</h2>

          <div class="space-y-4">
            <details class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm hover:bg-white/10 transition-all group">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
                Do I need to learn how to build workflows myself?
                <svg class="w-5 h-5 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-white/70 mt-4 leading-relaxed">
                Nope. We build everything for you during onboarding. You tell us your process, we design the automations. Once live, they just run. You can adjust messaging anytime, but the technical setup is on us.
              </p>
            </details>

            <details class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm hover:bg-white/10 transition-all group">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
                What if my business process is unique?
                <svg class="w-5 h-5 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-white/70 mt-4 leading-relaxed">
                Every business is unique. That's why we custom-build workflows instead of using cookie-cutter templates. We map your exact process, then automate it step-by-step.
              </p>
            </details>

            <details class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm hover:bg-white/10 transition-all group">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
                How long does setup take?
                <svg class="w-5 h-5 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-white/70 mt-4 leading-relaxed">
                Initial setup takes 7-10 days. We schedule a 60-minute strategy call, build workflows, you test them, we refine, then launch. You'll see results immediately.
              </p>
            </details>

            <details class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm hover:bg-white/10 transition-all group">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
                Can I add more automations later?
                <svg class="w-5 h-5 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-white/70 mt-4 leading-relaxed">
                Absolutely. Start with core automations (booking, reminders, reviews), then add more as your business grows. We continuously optimize and suggest new automations based on performance.
              </p>
            </details>

            <details class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm hover:bg-white/10 transition-all group">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
                What if I need to pause or adjust an automation?
                <svg class="w-5 h-5 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-white/70 mt-4 leading-relaxed">
                You can pause any automation with one click. Need to adjust timing, messaging, or triggers? Just let us know or make the change yourself in the dashboard. Full control, always.
              </p>
            </details>

            <details class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm hover:bg-white/10 transition-all group">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
                Do automations work with my existing tools?
                <svg class="w-5 h-5 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-white/70 mt-4 leading-relaxed">
                Yes. ZeroMotion CRM integrates with Google Calendar, Outlook, Stripe, QuickBooks, and most major tools. We sync everything so your data flows seamlessly.
              </p>
            </details>
          </div>
        </div>
      </section>

      <!-- Pricing -->
      <section class="section-padding">
        <div class="container-page max-w-3xl mx-auto text-center">
          <h2 class="h2 mb-6">Simple, Transparent Pricing</h2>
          <p class="text-white/80 text-lg mb-8">
