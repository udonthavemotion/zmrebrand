    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      
      // Advanced video optimization for all background videos
      document.addEventListener('DOMContentLoaded', function() {
        const heroVideo = document.querySelector('.uhd-video');
        const comparisonVideo = document.querySelector('.comparison-background-video');
        const extendedVideo = document.querySelector('.extended-hero-background-video');
        const brandSystemVideo = document.querySelector('.brand-system-background-video');
        const unifiedIntegrationVideo = document.querySelector('.unified-integration-background-video');
        const integratedProcessVideo = document.querySelector('.integrated-process-background-video');
        const standaloneVideo = document.querySelector('.standalone-background-video');
        const finalCtaVideo = document.querySelector('.final-cta-background-video');
        const upgradeIncentiveVideo = document.querySelector('.upgrade-incentive-background-video');
        
        // Helper function to optimize video loading
        function optimizeVideo(video, videoType) {
          if (!video) return;
          
          // Force maximum quality settings
          video.setAttribute('playsinline', 'true');
          video.setAttribute('webkit-playsinline', 'true');
          video.setAttribute('x5-playsinline', 'true');
          
          // Enhanced loading for quality
          video.addEventListener('loadstart', function() {
            this.style.imageRendering = 'optimizeQuality';
            this.style.visibility = 'visible';
          });
          
          video.addEventListener('canplay', function() {
            this.classList.add('loaded');
            this.style.transform = 'translateZ(0)';
            if (videoType === 'hero') {
              this.style.filter = 'brightness(0.85) contrast(1.25) saturate(1.4) hue-rotate(0deg) blur(0px)';
            } else {
              this.style.filter = 'brightness(0.75) contrast(1.15) saturate(1.3) hue-rotate(0deg) blur(0px)';
            }
            // Switch to auto preload for full video loading
            this.preload = 'auto';
          });
          
          video.addEventListener('loadeddata', function() {
            this.style.imageRendering = 'optimizeQuality';
            this.style.transform = 'translateZ(0) translate3d(0, 0, 0)';
          });
          
          video.addEventListener('play', function() {
            this.style.imageRendering = 'optimizeQuality';
          });
          
          // Handle quality degradation prevention
          video.addEventListener('waiting', function() {
            this.style.imageRendering = 'optimizeQuality';
          });

          // Ensure video loads on Vercel
          video.addEventListener('error', function() {
            console.warn(`${videoType} video failed to load, retrying...`);
            setTimeout(() => {
              this.load();
            }, 1000);
          });
        }
        
        // Optimize all videos
        optimizeVideo(heroVideo, 'hero');
        optimizeVideo(comparisonVideo, 'comparison');
        optimizeVideo(extendedVideo, 'extended');
        optimizeVideo(brandSystemVideo, 'brand-system');
        optimizeVideo(unifiedIntegrationVideo, 'comparison');
        optimizeVideo(integratedProcessVideo, 'process');
        optimizeVideo(standaloneVideo, 'standalone');
        optimizeVideo(finalCtaVideo, 'final-cta');
        optimizeVideo(upgradeIncentiveVideo, 'upgrade-incentive');
        
        // Enhanced glass panel animations for all glass cards
        const allGlassCards = document.querySelectorAll('.glass-panel-card, .glass-process-card, .standalone-glass-card, .faq-glass-card');
        allGlassCards.forEach((panel, index) => {
          // Staggered animation on scroll
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                setTimeout(() => {
                  entry.target.style.opacity = '1';
                  entry.target.style.transform = 'translateY(0)';
                }, index * 80);
              }
            });
          }, { threshold: 0.1 });
          
          // Initial state
          panel.style.opacity = '0';
          panel.style.transform = 'translateY(30px)';
          panel.style.transition = 'all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
          
          observer.observe(panel);
        });
        
        // Special animation for final CTA panel
        const finalCtaPanel = document.querySelector('.final-cta-glass-panel');
        if (finalCtaPanel) {
          const ctaObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                setTimeout(() => {
                  entry.target.style.opacity = '1';
                  entry.target.style.transform = 'translateY(0) scale(1)';
                }, 200);
              }
            });
          }, { threshold: 0.1 });
          
          // Initial state
          finalCtaPanel.style.opacity = '0';
          finalCtaPanel.style.transform = 'translateY(40px) scale(0.95)';
          finalCtaPanel.style.transition = 'all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
          
          ctaObserver.observe(finalCtaPanel);
        }
      });

      // Enhanced PNG logo loading for Vercel deployment (Client Logo Showcase)
      const logoImages = document.querySelectorAll('.seamless-logo');
      logoImages.forEach((img, index) => {
