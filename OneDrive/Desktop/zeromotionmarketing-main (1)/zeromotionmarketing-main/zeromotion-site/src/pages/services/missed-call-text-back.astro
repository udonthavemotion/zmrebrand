  <!-- Optimized Video Loading Script -->
  <script>
    // Perfect video optimization system
    document.addEventListener('DOMContentLoaded', function() {
      // Intersection Observer for lazy video loading
      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const video = entry.target as HTMLVideoElement;
            
            // Start loading the video when it comes into view
            if (video.preload === 'none') {
              video.preload = 'metadata';
              
              // Add smooth fade-in when video is ready
              video.addEventListener('canplay', function(this: HTMLVideoElement) {
                this.style.visibility = 'visible';
                this.style.opacity = '0.8';
                this.classList.add('loaded');
              }, { once: true });
              
              // Ensure video plays smoothly
              video.addEventListener('loadeddata', function(this: HTMLVideoElement) {
                this.style.imageRendering = 'auto';
                this.style.filter = this.style.filter || 'brightness(0.75) contrast(1.15) saturate(1.3)';
              }, { once: true });
            }
            
            // Stop observing this video
            videoObserver.unobserve(video);
          }
        });
      }, {
        rootMargin: '100px 0px', // Start loading 100px before entering viewport
        threshold: 0.1
      });

      // Observe all lazy-loading videos
      document.querySelectorAll('video[data-intersection-video]').forEach(video => {
        videoObserver.observe(video);
      });

      // Enhanced hero video loading - immediate display
      const heroVideo = document.querySelector('.hero-video-optimized') as HTMLVideoElement;
      if (heroVideo) {
        // Force immediate loading and display for hero video
        heroVideo.preload = 'auto';
        heroVideo.style.visibility = 'visible';
        heroVideo.style.opacity = '0.8';
        
        // Ensure video displays immediately
        heroVideo.addEventListener('loadstart', function(this: HTMLVideoElement) {
          this.style.visibility = 'visible';
          this.style.opacity = '0.8';
          this.classList.add('loaded');
        }, { once: true });

        heroVideo.addEventListener('loadeddata', function(this: HTMLVideoElement) {
          this.style.visibility = 'visible';
          this.style.opacity = '0.8';
          this.classList.add('loaded');
        }, { once: true });

        heroVideo.addEventListener('canplay', function(this: HTMLVideoElement) {
          this.style.imageRendering = 'auto';
          this.style.visibility = 'visible';
          this.style.opacity = '0.8';
        }, { once: true });
        
        // Force immediate display
        setTimeout(() => {
          heroVideo.style.visibility = 'visible';
          heroVideo.style.opacity = '0.8';
          heroVideo.classList.add('loaded');
        }, 100);
      }

      // Performance optimization: Pause videos when not visible
      const pauseObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const video = entry.target as HTMLVideoElement;
          if (!entry.isIntersecting && !video.paused) {
            video.pause();
          } else if (entry.isIntersecting && video.paused) {
            video.play().catch(() => {}); // Ignore autoplay policy errors
          }
        });
      }, { threshold: 0.1 });

      // Apply pause optimization to all background videos
      setTimeout(() => {
        document.querySelectorAll('.optimized-background-video').forEach(video => {
          pauseObserver.observe(video);
        });
      }, 1000);
    });

    // Connection-aware video quality
    if ('connection' in navigator) {
      const connection = (navigator as any).connection;
      const updateVideoQuality = () => {
        const videos = document.querySelectorAll('.optimized-background-video') as NodeListOf<HTMLVideoElement>;
        
        if (connection.effectiveType === 'slow-2g' || connection.effectiveType === '2g') {
          // Reduce quality for slow connections
          videos.forEach(video => {
            video.style.filter = 'brightness(0.7) contrast(1.1) saturate(1.2) blur(1px)';
          });
        } else if (connection.effectiveType === '4g') {
          // Enhanced quality for fast connections
          videos.forEach(video => {
            video.style.filter = 'brightness(0.75) contrast(1.15) saturate(1.3) hue-rotate(0deg)';
          });
        }
      };

      connection.addEventListener('change', updateVideoQuality);
      updateVideoQuality();
    }
  </script>
