---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ModernBookingModal from "../../components/ModernBookingModal.astro";
import TextureVideoSection from "../../components/sections/TextureVideoSection.astro";
import DarkContentSection from "../../components/sections/DarkContentSection.astro";
import SEOInternalLinks from "../../components/SEOInternalLinks.astro";
import { getAlternatingTexture, getPreloadTextures } from "../../lib/textures.ts";

const base = "/pictures/web design page/";
const HERO_VIDEO = "/assets/implementation/5453622-uhd_3840_2160_24fps.mp4";

// Get alternating textures for seamless flow
const texture1 = getAlternatingTexture(0);
const texture2 = getAlternatingTexture(1);
const texture3 = getAlternatingTexture(2);
const texture4 = getAlternatingTexture(3);
const texture5 = getAlternatingTexture(4);

// Preload critical textures for performance
const preloadTextures = getPreloadTextures(3);

// SEO Configuration for Missed Call Text-Back Service Page
const title = "Missed Call Text-Back Automation | ZeroMotion CRM | Never Lose a Lead";
const description = "Instant SMS to missed callers. 24/7 automated response ensures you never lose a lead again. Zero manual effort, maximum conversion with ZeroMotion CRM automation.";
const keywords = "missed call text back, automated SMS response, lead capture automation, missed call automation, instant lead response, 24/7 lead follow-up, CRM automation";
const canonical = "/services/missed-call-text-back";
const ogImage = "/og-webdesign.png";

// Missed Call Text-Back Service Schema
const missedCallSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Missed Call Text-Back Automation",
    "description": "Instant SMS automation for missed calls. Never lose a lead with 24/7 automated text-back responses that capture and convert prospects immediately.",
    "provider": {
      "@type": "Organization",
      "name": "ZeroMotion Marketing",
      "url": "https://zeromotion.marketing"
    },
    "serviceType": "Lead Capture Automation",
    "areaServed": [
      {
        "@type": "Country",
        "name": "United States"
      }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Missed Call Automation Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Instant SMS Response",
            "description": "Automated text messages sent within seconds of a missed call"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "24/7 Lead Capture",
            "description": "Never miss a lead, even after hours or during busy times"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Custom Response Workflows",
            "description": "Personalized automated responses that match your brand voice"
          }
        }
      ]
    }
  }
];
---

<BaseLayout {title} {description} {keywords} {canonical} {ogImage} schema={missedCallSchema}>
  <!-- Optimized preloading strategy - Only preload hero video -->
  <link rel="preload" as="video" href={HERO_VIDEO} type="video/mp4" crossorigin="anonymous" />
  <link rel="dns-prefetch" href="//zeromotion.marketing" />
  <link rel="dns-prefetch" href="//assets" />
  <meta name="video-quality" content="ultra-high" />
  <meta name="video-optimization" content="enabled" />
  
  <!-- Preload first few critical textures only -->
  {preloadTextures.slice(0, 2).map(texture => (
    <link rel="preload" as="video" href={texture} />
  ))}
  
  <div class="brand-identity">
    <section class="hero" data-hero>
      <video 
        src={HERO_VIDEO} 
        autoplay 
        muted 
        loop 
        playsinline
        preload="metadata"
        class="hero-video-optimized uhd-video stable-hero-video"
        style="filter: brightness(0.85) contrast(1.25) saturate(1.4) hue-rotate(0deg);"
        width="3840"
        height="2160"
        onloadstart="this.style.visibility='visible'; this.style.imageRendering='auto'; this.style.opacity='0.8';"
        oncanplay="this.classList.add('loaded'); this.style.opacity='0.8'; this.preload='auto';"
        onloadeddata="this.style.visibility='visible'; this.style.opacity='0.8';"
        onloadedmetadata="this.style.opacity='0.8';"
        crossorigin="anonymous"
        disablepictureinpicture
        x-webkit-airplay="deny"
        aria-label="Ultra high-definition 4K brand identity design showcase"
        data-video-src={HERO_VIDEO}
      ></video>
      <div class="container-page" style="text-align: center;">
        <h1 class="h1" style="margin-bottom: 20px;">Never Lose a Lead to a Missed Call Again</h1>
        <p class="sub" style="max-width: 800px; margin: 0 auto 30px auto;">
          Instant SMS response to every missed call. 24/7 automated lead capture that turns missed opportunities into booked appointments—zero manual effort required.
        </p>
        <div
          style="display:flex;gap:12px;justify-content:center;margin-top:18px"
        >
          <a
            class="btn btn-primary"
            href="/pricing"
            onclick="window.dataLayer&&dataLayer.push({event:'cta_click',label:'See Plans with Missed Call Text-Back'})"
            data-event="missed_call_plans_view"
            ><span class="btn-text-main">See Plans with Missed Call Text-Back</span></a
          >
          <a
            class="btn-ghost"
            href="#how-it-works"
            onclick="window.dataLayer&&dataLayer.push({event:'cta_click',label:'How It Works'})"
            data-event="missed_call_how_it_works"
            ><span class="btn-text-main">How It Works</span></a
          >
        </div>
        <div style="opacity:.7;margin-top:14px">
          Instant • Automated • Always On
        </div>
      </div>
    </section>

    <!-- Unified Integration Benefits & Plan Overview with Video Background -->
    <section class="unified-integration-section section">
      <div class="unified-integration-content">
        <div class="container-page">
          
          <!-- Integration Benefits Top Section -->
          <div id="integration-benefits" class="integration-benefits-section" style="margin-bottom: 80px;">
            <div style="text-align: center; margin-bottom: 50px;">
              <h2 class="h2" style="color: #ffffff; margin-bottom: 20px;">Why Missed Call Text-Back Is Essential for Growth</h2>
              <p class="sub" style="color: #e2e8f0; max-width: 700px; margin: 0 auto;">Studies show 80% of callers won't leave a voicemail. Instant SMS response captures leads that would otherwise be lost forever.</p>
            </div>

            <div class="benefits-glass-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px; max-width: 1200px; margin: 0 auto;">
              <div class="glass-panel-card benefit-card">
                <div class="glass-panel-icon" style="font-size: 3.5rem; color: #8b5cf6; margin-bottom: 25px;">⚡</div>
                <h3 class="h3" style="color: #ffffff; margin-bottom: 20px; font-weight: 700;">Instant Lead Response</h3>
                <p style="color: #e2e8f0; line-height: 1.6;">Automated SMS sent within seconds of every missed call. No more lost leads because you were busy, after hours, or away from your phone.</p>
              </div>

              <div class="glass-panel-card benefit-card featured-panel">
                <div class="glass-panel-icon" style="font-size: 3.5rem; color: #8b5cf6; margin-bottom: 25px;">📈</div>
                <h3 class="h3" style="color: #ffffff; margin-bottom: 20px; font-weight: 700;">Higher Conversion Rates</h3>
                <p style="color: #e2e8f0; line-height: 1.6;">Fast response times increase conversion by up to 391%. Instant text-back shows professionalism and captures leads while they're hot.</p>
              </div>

              <div class="glass-panel-card benefit-card">
                <div class="glass-panel-icon" style="font-size: 3.5rem; color: #8b5cf6; margin-bottom: 25px;">🤖</div>
                <h3 class="h3" style="color: #ffffff; margin-bottom: 20px; font-weight: 700;">Zero Manual Effort</h3>
                <p style="color: #e2e8f0; line-height: 1.6;">Set it once, forget it forever. The system runs 24/7 without you lifting a finger—capturing leads while you sleep, serve customers, or live your life.</p>
              </div>
            </div>
          </div>

          <!-- Plan Integration Overview Bottom Section -->
          <div class="plan-integration-overview" id="how-it-works">
            <div style="text-align: center; margin-bottom: 50px;">
              <h2 class="h2" style="color: #ffffff; margin-bottom: 20px;">Missed Call Text-Back Included in Every Plan</h2>
              <p class="sub" style="color: #e2e8f0; max-width: 700px; margin: 0 auto;">From basic auto-response to advanced conversation AI—every plan captures your missed call leads</p>
            </div>
            
            <div class="plan-integration-modern-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 40px; max-width: 1400px; margin: 0 auto; padding: 20px 0;">
              <!-- Starter CRM - Subscription Model -->
              <div class="card plan-card subscription-focus" style="border: 3px solid rgba(34, 197, 94, 0.6); background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(34, 197, 94, 0.05)); position: relative; text-align: center; padding: 40px 30px 60px 30px; border-radius: 25px; overflow: visible; margin-bottom: 20px;">
                <div class="model-indicator" style="position: absolute; top: -15px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #22c55e, #16a34a); color: white; padding: 8px 20px; border-radius: 20px; font-weight: bold; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">
                  🔄 SUBSCRIPTION MODEL
                </div>
                
                <h3 class="h2" style="color: #22c55e; margin-bottom: 25px; font-weight: 700;">Starter CRM Websites</h3>
                <div class="pricing-highlight" style="background: rgba(0, 0, 0, 0.4); padding: 25px; border-radius: 15px; margin-bottom: 30px;">
                  <div style="font-size: 2.2rem; font-weight: bold; color: #ffffff; line-height: 1;">Custom Quote</div>
                  <div style="color: #22c55e; font-weight: 600; margin: 8px 0;">Limited Availability</div>
                  <div style="font-size: 1.8rem; font-weight: bold; color: #22c55e;">Apply Today</div>
                  <div style="color: #e2e8f0; opacity: 0.8; font-size: 0.9rem; margin-top: 10px;">
                    <strong style="color: #22c55e;">Built inside ZeroMotion CRM</strong> (ZRM platform)
                  </div>
                </div>
                
                <div class="model-description" style="background: rgba(0, 0, 0, 0.3); padding: 25px; border-radius: 15px; margin-bottom: 30px;">
                  <p style="color: #e2e8f0; line-height: 1.6; font-size: 1rem;">
                    Basic missed call text-back automation. Instant SMS sent to every missed caller with your custom message and contact info.
                  </p>
                </div>

                <div class="plan-value" style="background: rgba(34, 197, 94, 0.15); padding: 20px; border-radius: 15px; margin: 25px 0; border-left: 4px solid #22c55e;">
                  <p style="font-weight: bold; color: #22c55e; margin-bottom: 8px; font-size: 1rem;">Perfect for:</p>
                  <p style="color: #e2e8f0; font-size: 0.95rem; line-height: 1.5; margin: 0;">Small businesses that can't afford to miss a single lead and want instant automated response without complexity.</p>
                </div>
                
                <a
                  class="btn-primary subscription-cta"
                  href="/plans/starter"
                  onclick="window.dataLayer&&dataLayer.push({event:'cta_click',label:'Learn More About Starter Complete'})"
                  data-event="brand_plan_comparison_view"
                  style="background: linear-gradient(135deg, #22c55e, #16a34a); width: calc(100% - 20px); padding: 18px; font-weight: 700; font-size: 1.1rem; border-radius: 12px; text-transform: none; transition: all 0.3s ease; position: absolute; bottom: 15px; left: 50%; transform: translateX(-50%); box-shadow: 0 8px 25px rgba(34, 197, 94, 0.4); z-index: 10;"
                  >🚀 Claim Your Spot Today</a
                >
              </div>
              
              <!-- Growth Marketing - Featured Plan -->
              <div class="card plan-card featured-panel project-focus" style="border: 3px solid rgba(139, 92, 246, 0.8); background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(139, 92, 246, 0.08)); position: relative; text-align: center; padding: 40px 30px 60px 30px; border-radius: 25px; box-shadow: 0 25px 50px rgba(139, 92, 246, 0.25); overflow: visible; margin-bottom: 20px;">
                <div class="popular-badge" style="position: absolute; top: -18px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #f59e0b, #d97706); color: white; padding: 10px 25px; border-radius: 25px; font-weight: bold; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 5px 15px rgba(245, 158, 11, 0.4);">
                  ⭐ MOST POPULAR
                </div>
                <div class="model-indicator" style="position: absolute; top: 15px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #8b5cf6, #a855f7); color: white; padding: 6px 18px; border-radius: 15px; font-weight: bold; font-size: 11px; text-transform: uppercase; letter-spacing: 1px;">
                  💎 GROWTH MODEL
                </div>
                
                <h3 class="h2" style="color: #8b5cf6; margin: 45px 0 25px 0; font-weight: 700;">Growth Marketing + Brand Integration</h3>
                <div class="pricing-highlight" style="background: rgba(0, 0, 0, 0.5); padding: 30px; border-radius: 15px; margin-bottom: 30px; border: 2px solid rgba(139, 92, 246, 0.3);">
                  <div style="font-size: 2.2rem; font-weight: bold; color: #ffffff; line-height: 1;">Custom Quote</div>
                  <div style="color: #8b5cf6; font-weight: 600; margin: 8px 0;">Most Popular</div>
                  <div style="font-size: 1.5rem; color: #8b5cf6; font-weight: 600;">Request Quote →</div>
                  <div style="color: #e2e8f0; opacity: 0.9; font-size: 0.9rem; margin-top: 12px;">
                    <strong style="color: #8b5cf6;">Complete rebrand + marketing integration</strong>
                  </div>
                </div>
                
                <div class="model-description" style="background: rgba(0, 0, 0, 0.4); padding: 25px; border-radius: 15px; margin-bottom: 30px;">
                  <p style="color: #e2e8f0; line-height: 1.6; font-size: 1rem;">
                    Advanced missed call automation with custom workflows, smart routing, and follow-up sequences. Automatically schedule callbacks and send personalized follow-ups based on lead behavior.
                  </p>
                </div>

                <div class="plan-value" style="background: rgba(139, 92, 246, 0.15); padding: 20px; border-radius: 15px; margin: 25px 0; border-left: 4px solid #8b5cf6;">
                  <p style="font-weight: bold; color: #8b5cf6; margin-bottom: 8px; font-size: 1rem;">Perfect for:</p>
                  <p style="color: #e2e8f0; font-size: 0.95rem; line-height: 1.5; margin: 0;">Growing businesses that need sophisticated lead capture with custom workflows and intelligent follow-up automation.</p>
                </div>
                
                <a
                  class="btn-primary custom-cta"
                  href="/plans/growth"
                  onclick="window.dataLayer&&dataLayer.push({event:'cta_click',label:'Learn More About Growth Complete'})"
                  data-event="brand_plan_comparison_view"
                  style="background: linear-gradient(135deg, #8b5cf6, #a855f7); width: calc(100% - 20px); padding: 18px; font-weight: 700; font-size: 1.1rem; border-radius: 12px; text-transform: none; transition: all 0.3s ease; position: absolute; bottom: 15px; left: 50%; transform: translateX(-50%); box-shadow: 0 8px 25px rgba(139, 92, 246, 0.4); z-index: 10;"
                  >💎 Learn More About Growth Complete</a
                >
              </div>
              
              <!-- Scale & Dominate - Enterprise Focus -->
              <div class="card plan-card enterprise-focus" style="border: 3px solid rgba(245, 158, 11, 0.6); background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(245, 158, 11, 0.05)); position: relative; text-align: center; padding: 40px 30px 60px 30px; border-radius: 25px; overflow: visible; margin-bottom: 20px;">
                <div class="model-indicator" style="position: absolute; top: -15px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #f59e0b, #d97706); color: white; padding: 8px 20px; border-radius: 20px; font-weight: bold; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">
                  🚀 COMPLETE SYSTEM
                </div>
                
                <h3 class="h2" style="color: #f59e0b; margin-bottom: 25px; font-weight: 700;">Scale & Dominate + Premium Brand Strategy</h3>
                <div class="pricing-highlight" style="background: rgba(0, 0, 0, 0.4); padding: 25px; border-radius: 15px; margin-bottom: 30px;">
                  <div style="font-size: 2rem; font-weight: bold; color: #ffffff; line-height: 1;">Custom Quote</div>
                  <div style="color: #f59e0b; font-weight: 600; margin: 8px 0;">Enterprise Level</div>
                  <div style="color: #e2e8f0; opacity: 0.8; font-size: 0.9rem; margin-top: 10px;">
                    <strong style="color: #f59e0b;">Premium brand strategy + market leadership</strong>
                  </div>
                </div>
                
                <div class="model-description" style="background: rgba(0, 0, 0, 0.3); padding: 25px; border-radius: 15px; margin-bottom: 30px;">
                  <p style="color: #e2e8f0; line-height: 1.6; font-size: 1rem;">
                    Enterprise-grade missed call handling with AI voice agents, multi-location routing, priority escalation, and advanced analytics. Fully integrated with your existing systems and CRM.
                  </p>
                </div>

                <div class="plan-value" style="background: rgba(245, 158, 11, 0.15); padding: 20px; border-radius: 15px; margin: 25px 0; border-left: 4px solid #f59e0b;">
                  <p style="font-weight: bold; color: #f59e0b; margin-bottom: 8px; font-size: 1rem;">Perfect for:</p>
                  <p style="color: #e2e8f0; font-size: 0.95rem; line-height: 1.5; margin: 0;">Established businesses and enterprises that need enterprise-level lead capture with AI-powered conversations and advanced routing.</p>
                </div>
                
                <a
                  class="btn-primary enterprise-cta"
                  href="/plans/scale"
                  onclick="window.dataLayer&&dataLayer.push({event:'cta_click',label:'Learn More About Scale Complete'})"
                  data-event="brand_plan_comparison_view"
                  style="background: linear-gradient(135deg, #f59e0b, #d97706); width: calc(100% - 20px); padding: 18px; font-weight: 700; font-size: 1.1rem; border-radius: 12px; text-transform: none; transition: all 0.3s ease; position: absolute; bottom: 15px; left: 50%; transform: translateX(-50%); box-shadow: 0 8px 25px rgba(245, 158, 11, 0.4); z-index: 10;"
                  >🚀 Learn More About Scale Complete</a
                >
              </div>
            </div>
          </div>
          
        </div>
      </div>
      
      <!-- Shared Video Background - Optimized -->
      <video 
        src="/assets/implementation/12602693_1920_1080_30fps.mp4" 
        autoplay 
        muted 
        loop 
        playsinline
        preload="none"
        class="optimized-background-video unified-integration-background-video stable-hero-video"
        style="filter: brightness(0.75) contrast(1.15) saturate(1.3) hue-rotate(0deg);"
        onloadstart="this.style.visibility='visible'; this.style.imageRendering='auto';"
        oncanplay="this.classList.add('loaded'); this.style.opacity='0.8';"
        onloadeddata="this.style.visibility='visible';"
        width="1920"
        height="1080"
        crossorigin="anonymous"
        disablepictureinpicture
        x-webkit-airplay="deny"
        aria-hidden="true"
        role="img"
        aria-label="Background video for brand identity integration section"
        data-intersection-video="true"
      ></video>
      
      <!-- Overlay gradient for text readability -->
      <div class="unified-integration-video-overlay"></div>
    </section>

    <!-- Enhanced Brand System Components with Glass Panel Design -->
    <section class="brand-system-hero-section section">
      <div class="brand-system-content">
        <div class="container-page">
          <div style="text-align: center; margin-bottom: 50px;">
            <h2 class="h2" style="margin-bottom: 20px; color: #ffffff;">Complete Missed Call Automation System</h2>
            <p class="sub" style="color: #e2e8f0; max-width: 700px; margin: 0 auto;">Every feature designed to capture, engage, and convert leads from missed calls—automatically and intelligently</p>
          </div>
          
          <!-- Glass Panel Grid -->
          <div class="glass-panel-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px; max-width: 1200px; margin: 0 auto;">
            
            <!-- Instant SMS Response Glass Panel -->
            <div class="glass-panel-card">
              <div class="glass-panel-icon" style="font-size: 3rem; color: #8b5cf6; margin-bottom: 25px;">📱</div>
              <h3 class="h3" style="color: #ffffff; margin-bottom: 20px; font-weight: 700;">Instant SMS Response</h3>
              <p style="color: #e2e8f0; line-height: 1.6; margin-bottom: 25px;">Automated text messages sent within seconds of every missed call. Custom messages that match your brand voice and capture lead information.</p>
              <div class="glass-panel-features">
                <div class="feature-item">✓ Sub-60 second response time</div>
                <div class="feature-item">✓ Custom message templates</div>
                <div class="feature-item">✓ Brand voice personalization</div>
                <div class="feature-item">✓ Click-to-schedule links</div>
              </div>
            </div>

            <!-- Smart Lead Capture Glass Panel -->
            <div class="glass-panel-card featured-panel">
              <div class="glass-panel-icon" style="font-size: 3rem; color: #8b5cf6; margin-bottom: 25px;">🎯</div>
              <h3 class="h3" style="color: #ffffff; margin-bottom: 20px; font-weight: 700;">Smart Lead Capture</h3>
              <p style="color: #e2e8f0; line-height: 1.6; margin-bottom: 25px;">Automatically capture caller information, source tracking, and lead intent. All data flows directly into your CRM for instant follow-up.</p>
              <div class="glass-panel-features">
                <div class="feature-item">✓ Automatic contact creation</div>
                <div class="feature-item">✓ Call source tracking</div>
                <div class="feature-item">✓ Lead intent detection</div>
                <div class="feature-item">✓ CRM integration</div>
              </div>
            </div>

            <!-- 24/7 Automation Glass Panel -->
            <div class="glass-panel-card">
              <div class="glass-panel-icon" style="font-size: 3rem; color: #8b5cf6; margin-bottom: 25px;">🌙</div>
              <h3 class="h3" style="color: #ffffff; margin-bottom: 20px; font-weight: 700;">24/7 Always-On Automation</h3>
              <p style="color: #e2e8f0; line-height: 1.6; margin-bottom: 25px;">Never miss an after-hours lead again. The system works while you sleep, capturing weekend and evening prospects automatically.</p>
              <div class="glass-panel-features">
                <div class="feature-item">✓ After-hours lead capture</div>
                <div class="feature-item">✓ Weekend automation</div>
                <div class="feature-item">✓ Holiday coverage</div>
                <div class="feature-item">✓ Busy-line backup</div>
              </div>
            </div>

            <!-- Custom Workflows Glass Panel -->
            <div class="glass-panel-card">
              <div class="glass-panel-icon" style="font-size: 3rem; color: #8b5cf6; margin-bottom: 25px;">⚙️</div>
              <h3 class="h3" style="color: #ffffff; margin-bottom: 20px; font-weight: 700;">Custom Follow-Up Workflows</h3>
              <p style="color: #e2e8f0; line-height: 1.6; margin-bottom: 25px;">Multi-step automated sequences that nurture leads through personalized follow-ups based on their behavior and response patterns.</p>
              <div class="glass-panel-features">
                <div class="feature-item">✓ Multi-step sequences</div>
                <div class="feature-item">✓ Behavior-based triggers</div>
                <div class="feature-item">✓ Smart scheduling</div>
                <div class="feature-item">✓ Priority escalation</div>
              </div>
            </div>

            <!-- Analytics & Reporting Glass Panel -->
            <div class="glass-panel-card">
              <div class="glass-panel-icon" style="font-size: 3rem; color: #8b5cf6; margin-bottom: 25px;">📊</div>
              <h3 class="h3" style="color: #ffffff; margin-bottom: 20px; font-weight: 700;">Real-Time Analytics</h3>
              <p style="color: #e2e8f0; line-height: 1.6; margin-bottom: 25px;">Track missed call patterns, response rates, and conversion metrics. Know exactly how many leads you're capturing and converting.</p>
              <div class="glass-panel-features">
                <div class="feature-item">✓ Missed call tracking</div>
                <div class="feature-item">✓ Response rate metrics</div>
                <div class="feature-item">✓ Conversion analytics</div>
                <div class="feature-item">✓ ROI reporting</div>
              </div>
            </div>

            <!-- Integration Hub Glass Panel -->
            <div class="glass-panel-card">
