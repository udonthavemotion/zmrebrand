---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackgroundSectionVideo from "../../components/BackgroundSectionVideo.astro";
import LimitedSpotsAlert from "../../components/LimitedSpotsAlert.astro";
import ROICalculator from "../../components/ROICalculator.astro";

const title = "Missed Call Text-Back | Never Lose a Lead Again | ZeroMotion CRM";
const description = "Instant SMS to every missed caller. 24/7 automated response that captures leads while you're busy, after hours, or away from your phone. Zero manual effort, maximum conversion for Louisiana businesses.";
const keywords = "missed call text back, automated SMS response Louisiana, lead capture system, missed call automation Houma, never lose leads, ZeroMotion CRM";
const canonical = "/services/missed-call-text-back";
const ogImage = "/favico/android-chrome-512x512.png";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Missed Call Text-Back Service",
  "description": "Automated SMS response system that captures leads from missed calls 24/7",
  "provider": {
    "@type": "Organization",
    "name": "ZeroMotion Marketing",
    "url": "https://zeromotion.marketing"
  },
  "areaServed": {
    "@type": "State",
    "name": "Louisiana"
  },
  "audience": {
    "@type": "BusinessAudience",
    "audienceType": "Small Business Owners"
  }
};
---

<BaseLayout {title} {description} {keywords} {canonical} {ogImage} {schema}>
  <main>
    <BackgroundSectionVideo
      src="/photos/homepage_hero.mp4"
      opacity={0.6}
      brightness={0.9}
      contrast={1.15}
    >
      <!-- Hero Section -->
      <section class="section-padding text-center">
        <div class="container-page max-w-4xl mx-auto">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/20 border border-purple-500/30 text-purple-200 text-sm font-medium mb-6">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
            </svg>
            <span>Most Popular CRM Feature</span>
          </div>

          <h1 class="h1 mb-6">How Many Customers Called While You Were Busy?</h1>

          <p class="text-white/90 text-xl mb-8 leading-relaxed max-w-3xl mx-auto">
            Every missed call is a lead that went to your competitor. ZeroMotion CRM sends instant SMS to every caller you miss—capturing leads 24/7, even after hours.
          </p>

          <div class="flex justify-center mb-6">
            <LimitedSpotsAlert spotsLeft={5} planName="Missed Call Text-Back" />
          </div>

          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
            <button
              type="button"
              class="btn-primary btn-lg"
              onclick="openStrategistModal('missed-call-hero'); window.dataLayer&&dataLayer.push({event:'cta_click',location:'missed-call-hero',service:'missed-call-text-back'})"
            >
              <span class="btn-text-main">Book Free CRM Strategy Call</span>
            </button>
            <a href="/quiz" class="btn-ghost btn-lg">
              <span class="btn-text-main">Take Our Quiz</span>
            </a>
          </div>

          <!-- Quick Stats -->
          <div class="grid md:grid-cols-3 gap-6 mt-12">
            <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl p-6 hover:bg-white/10 transition-all">
              <div class="text-4xl font-bold text-primary mb-2">100%</div>
              <div class="text-white/70 text-sm">Calls Captured</div>
            </div>
            <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl p-6 hover:bg-white/10 transition-all">
              <div class="text-4xl font-bold text-primary mb-2">&lt;60s</div>
              <div class="text-white/70 text-sm">Response Time</div>
            </div>
            <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-xl p-6 hover:bg-white/10 transition-all">
              <div class="text-4xl font-bold text-primary mb-2">24/7</div>
              <div class="text-white/70 text-sm">Always Active</div>
            </div>
          </div>
        </div>
      </section>

      <!-- The Problem -->
      <section class="section-padding">
        <div class="container-page max-w-4xl mx-auto text-center">
          <h2 class="h2 mb-6">The Reality: You're Bleeding Money</h2>
          <div class="space-y-6 text-lg text-white/80">
            <p>
              You're on a job site. You're with a customer. You're at lunch. Your phone rings. You can't answer.
            </p>
            <p class="text-2xl font-semibold text-primary">
              That caller just booked with your competitor.
            </p>
            <p>
              Studies show <strong class="text-white">80% of callers won't leave a voicemail</strong>. They'll just move on to the next business in Google. That's 8 out of 10 potential customers—gone.
            </p>
            <p>
              If you're missing even <strong class="text-white">5 calls a week</strong>, that's 20+ leads per month walking straight to your competition.
            </p>
          </div>

          <div class="mt-12 bg-red-500/10 border border-red-500/30 rounded-xl p-8 backdrop-blur-sm">
            <h3 class="text-2xl font-bold text-red-400 mb-4">Do the Math:</h3>
            <div class="space-y-3 text-white/90">
              <p>20 missed calls/month × $500 average job = <strong class="text-primary text-2xl">$10,000/month lost</strong></p>
              <p class="text-sm text-white/60">That's $120,000 per year walking out the door because you were busy running your business.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- How It Works -->
      <section class="section-padding">
        <div class="container-page max-w-5xl mx-auto">
          <h2 class="h2 text-center mb-12">How Missed Call Text-Back Works</h2>

          <div class="grid md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="w-20 h-20 bg-purple-500/20 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-purple-500/30">
                <span class="text-3xl font-bold text-primary">1</span>
              </div>
              <h3 class="h3 mb-3">They Call, You Miss It</h3>
              <p class="text-white/70 leading-relaxed">
                Customer calls but you're with another client, in a meeting, or after hours. Phone rings, no answer.
              </p>
            </div>

            <div class="text-center">
              <div class="w-20 h-20 bg-purple-500/20 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-purple-500/30">
                <span class="text-3xl font-bold text-primary">2</span>
              </div>
              <h3 class="h3 mb-3">Instant SMS Sent</h3>
              <p class="text-white/70 leading-relaxed">
                Within 60 seconds, ZeroMotion CRM automatically texts them: "Hey! Sorry I missed your call. What can I help you with?"
              </p>
            </div>

            <div class="text-center">
              <div class="w-20 h-20 bg-purple-500/20 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-purple-500/30">
                <span class="text-3xl font-bold text-primary">3</span>
              </div>
              <h3 class="h3 mb-3">Lead Captured</h3>
              <p class="text-white/70 leading-relaxed">
                They respond, book directly via calendar link, or enter your pipeline. You reply when you're free. No lead lost ever again.
              </p>
            </div>
          </div>

          <div class="mt-12 text-center">
            <div class="inline-block bg-white/5 border border-white/10 rounded-xl p-8 backdrop-blur-sm">
              <h4 class="text-xl font-semibold text-white mb-4">Example Automated Message:</h4>
              <div class="bg-black/30 rounded-lg p-6 text-left max-w-md mx-auto border border-purple-500/20">
                <p class="text-white/90 mb-4">
                  "Hi! This is [Your Business]. Sorry we missed your call—we're either with a customer or it's after hours. What can we help you with?"
                </p>
                <p class="text-white/70 text-sm mb-4">
                  "Or click here to book directly on our calendar: [booking link]"
                </p>
                <p class="text-white/50 text-xs italic">
                  Sent automatically within 60 seconds of every missed call
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Features -->
      <section class="section-padding">
        <div class="container-page max-w-4xl mx-auto">
          <h2 class="h2 text-center mb-12">What's Included</h2>

          <div class="grid md:grid-cols-2 gap-4">
            {[
              "Custom SMS templates in your brand voice",
              "Smart scheduling (respects business hours + holidays)",
              "Two-way SMS conversation tracking in CRM",
              "Calendar link integration for instant booking",
              "Pipeline auto-entry for every missed call",
              "Works with your existing phone number",
              "Real-time alerts and SMS reporting",
              "Unlimited missed call responses"
            ].map(feature => (
              <div class="flex items-start gap-4 p-4 bg-white/5 border border-white/10 rounded-xl backdrop-blur-sm hover:bg-white/10 transition-all">
                <svg class="w-6 h-6 text-primary flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span class="text-white/90">{feature}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Why It Works -->
      <section class="section-padding">
        <div class="container-page max-w-4xl mx-auto">
          <h2 class="h2 text-center mb-12">Why This Works So Well</h2>

          <div class="grid md:grid-cols-2 gap-8">
            <div class="bg-gradient-to-br from-purple-500/10 to-violet-500/10 border border-purple-500/20 rounded-xl p-8 backdrop-blur-sm">
              <div class="text-4xl mb-4">📱</div>
              <h3 class="h3 mb-4">People Prefer Texting</h3>
              <p class="text-white/80 leading-relaxed">
                75% of consumers prefer text over phone calls for quick questions. Your missed call text gives them exactly what they want—instant response, no phone tag.
              </p>
            </div>

            <div class="bg-gradient-to-br from-purple-500/10 to-violet-500/10 border border-purple-500/20 rounded-xl p-8 backdrop-blur-sm">
              <div class="text-4xl mb-4">⚡</div>
              <h3 class="h3 mb-4">Speed Wins Deals</h3>
              <p class="text-white/80 leading-relaxed">
                Harvard Business Review: Companies that respond within 1 hour are 7X more likely to qualify the lead. Your auto-text responds in under 60 seconds, every time.
              </p>
            </div>

            <div class="bg-gradient-to-br from-purple-500/10 to-violet-500/10 border border-purple-500/20 rounded-xl p-8 backdrop-blur-sm">
              <div class="text-4xl mb-4">🌙</div>
              <h3 class="h3 mb-3">After-Hours Gold Mine</h3>
              <p class="text-white/80 leading-relaxed">
                30% of calls happen outside business hours. Without missed call text-back, those are 100% lost. With it, you capture them all—even while you sleep.
              </p>
            </div>

            <div class="bg-gradient-to-br from-purple-500/10 to-violet-500/10 border border-purple-500/20 rounded-xl p-8 backdrop-blur-sm">
              <div class="text-4xl mb-4">🎯</div>
              <h3 class="h3 mb-4">Zero Manual Work</h3>
              <p class="text-white/80 leading-relaxed">
                Set it once, forget it forever. No apps to check, no reminders to set. Every missed call gets texted automatically. You just reply when you're free.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Real Example -->
      <section class="section-padding">
        <div class="container-page max-w-3xl mx-auto">
          <div class="bg-gradient-to-br from-purple-500/20 to-violet-500/20 border border-purple-500/30 rounded-2xl p-8 backdrop-blur-sm">
            <h2 class="h2 text-center mb-6">Real Example: Martinez Plumbing (Houma)</h2>
            <div class="space-y-4 text-white/90">
              <p class="text-lg">
                <strong>Before ZeroMotion CRM:</strong> Missing 15-20 calls per week. Booking rate: 40%. Lots of voicemails never returned.
              </p>
              <p class="text-lg">
                <strong>After Missed Call Text-Back:</strong> 100% of calls captured. Booking rate jumped to 85% in the first month.
              </p>
              <div class="bg-black/30 rounded-lg p-6 mt-6 border border-purple-500/20">
                <p class="text-xl font-semibold text-primary mb-2">
                  "We went from losing 60+ leads a month to capturing every single one. Game changer."
                </p>
                <p class="text-white/70 text-sm">
                  —Sarah Martinez, Owner
                </p>
              </div>
              <div class="grid grid-cols-3 gap-4 mt-8 text-center">
                <div>
                  <div class="text-3xl font-bold text-primary">60+</div>
                  <div class="text-sm text-white/60">Leads/Month Saved</div>
                </div>
                <div>
                  <div class="text-3xl font-bold text-primary">85%</div>
                  <div class="text-sm text-white/60">New Booking Rate</div>
                </div>
                <div>
                  <div class="text-3xl font-bold text-primary">$0</div>
                  <div class="text-sm text-white/60">Manual Effort</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ROI Calculator -->
      <ROICalculator
        title="Calculate Your Missed Call ROI"
        subtitle="See exactly how many leads you're losing to missed calls—and what instant SMS response could recover."
      />

      <!-- Perfect For -->
      <section class="section-padding">
        <div class="container-page max-w-4xl mx-auto">
          <h2 class="h2 text-center mb-12">Perfect for Louisiana Service Businesses</h2>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {[
              { icon: "🔧", name: "Plumbers" },
              { icon: "❄️", name: "HVAC Contractors" },
              { icon: "⚡", name: "Electricians" },
              { icon: "🏠", name: "Real Estate Agents" },
              { icon: "👨‍⚖️", name: "Attorneys" },
              { icon: "🚗", name: "Auto Repair Shops" },
              { icon: "🏗️", name: "General Contractors" },
              { icon: "🪟", name: "Window & Door Installers" },
              { icon: "🌳", name: "Landscapers" }
            ].map(biz => (
              <div class="bg-white/5 border border-white/10 rounded-xl p-6 text-center hover:bg-white/10 transition-all backdrop-blur-sm">
                <div class="text-4xl mb-3">{biz.icon}</div>
                <div class="text-white font-medium">{biz.name}</div>
              </div>
            ))}
          </div>

          <p class="text-white/70 text-center mt-8 max-w-2xl mx-auto">
            Any business in Houma, Thibodaux, or Terrebonne Parish that takes calls from customers. If you're missing calls, you're losing money.
          </p>
        </div>
      </section>

      <!-- Mid-Page CTA -->
      <section class="section-padding">
        <div class="container-page max-w-3xl mx-auto text-center">
          <div class="bg-gradient-to-br from-purple-600/20 to-violet-600/20 border border-purple-500/30 rounded-2xl p-12 backdrop-blur-sm">
            <h2 class="h2 mb-4">See Exactly How Many Leads You're Losing</h2>
            <p class="text-white/80 text-lg mb-8">
              Book a free CRM strategy call. We'll audit your current call volume and show you the revenue walking out the door every month.
            </p>
            <button
              type="button"
              class="btn-primary btn-lg"
              onclick="openStrategistModal('missed-call-mid'); window.dataLayer&&dataLayer.push({event:'cta_click',location:'missed-call-mid',service:'missed-call-text-back'})"
            >
              <span class="btn-text-main">Book Free CRM Strategy Call</span>
            </button>
            <p class="text-white/50 text-sm mt-4">
              30-minute call • Zero pressure • Louisiana businesses only
            </p>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="section-padding">
        <div class="container-page max-w-3xl mx-auto">
          <h2 class="h2 text-center mb-12">Common Questions</h2>

          <div class="space-y-4">
            <details class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm hover:bg-white/10 transition-all group">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
                Does this work with my existing phone number?
                <svg class="w-5 h-5 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-white/70 mt-4 leading-relaxed">
                Yes. ZeroMotion CRM integrates with your existing business line. No need to change numbers or confuse customers. Missed call text-back works seamlessly in the background.
              </p>
            </details>

            <details class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm hover:bg-white/10 transition-all group">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
                What if I'm just on another call, not actually unavailable?
                <svg class="w-5 h-5 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-white/70 mt-4 leading-relaxed">
                Perfect use case. The text says "Sorry we missed your call" (not "we're closed"). Customer gets instant acknowledgment, you finish your current call, then reply. Much better than making them wait on hold or leave voicemail.
              </p>
            </details>

            <details class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm hover:bg-white/10 transition-all group">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
                Can I customize the message text?
                <svg class="w-5 h-5 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-white/70 mt-4 leading-relaxed">
                100%. We'll write templates in your brand voice during onboarding. You can adjust anytime. Add calendar links, pricing info, FAQs—whatever makes sense for your business.
              </p>
            </details>

            <details class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm hover:bg-white/10 transition-all group">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
                What's the SMS cost?
                <svg class="w-5 h-5 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-white/70 mt-4 leading-relaxed">
                Billed at carrier cost (typically $0.01-0.03 per message). Most businesses spend $20-40/month total. That's nothing compared to the leads you'll capture.
              </p>
            </details>

            <details class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm hover:bg-white/10 transition-all group">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
                How fast does it really send?
                <svg class="w-5 h-5 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-white/70 mt-4 leading-relaxed">
                Under 60 seconds, usually within 30. Fast enough that the customer is often still looking at their phone when your text arrives.
              </p>
            </details>

            <details class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm hover:bg-white/10 transition-all group">
              <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
                Does it work after hours and on weekends?
                <svg class="w-5 h-5 text-primary transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-white/70 mt-4 leading-relaxed">
                Yes. You can set business hours if you want (e.g., different message after 6pm), or run it 24/7. Either way, you're capturing leads while competitors are missing them.
              </p>
            </details>
          </div>
        </div>
      </section>

      <!-- Pricing -->
      <section class="section-padding">
        <div class="container-page max-w-3xl mx-auto text-center">
          <h2 class="h2 mb-6">Simple, Transparent Pricing</h2>
          <p class="text-white/80 text-lg mb-8">
            Missed Call Text-Back is included in all ZeroMotion CRM plans starting at <strong class="text-primary">$97/month</strong>. SMS usage billed at carrier cost (typically $20-40/month for most businesses).
          </p>
          <a href="/pricing" class="btn-primary btn-lg inline-flex">
            <span class="btn-text-main">See All Plans</span>
          </a>
          <p class="text-white/50 text-sm mt-4">
            Every plan includes unlimited missed call responses • No per-lead fees • Cancel anytime
          </p>
        </div>
      </section>

      <!-- Final CTA -->
      <section class="section-padding">
        <div class="container-page max-w-3xl mx-auto text-center">
          <h2 class="h2 mb-6">Stop Losing Leads Today</h2>
          <p class="text-white/80 text-lg mb-8">
            Book a free 30-minute CRM strategy call. We'll show you exactly how many leads you're losing and how to capture every single one.
          </p>
          <button
            type="button"
            class="btn-primary btn-lg"
            onclick="openStrategistModal('missed-call-cta'); window.dataLayer&&dataLayer.push({event:'cta_click',location:'missed-call-cta',service:'missed-call-text-back'})"
          >
            <span class="btn-text-main">Book Free CRM Strategy Call</span>
          </button>
          <p class="text-white/50 text-sm mt-4">
            Free consultation • No obligation • Louisiana businesses only
          </p>
        </div>
      </section>
    </BackgroundSectionVideo>
  </main>
</BaseLayout>
