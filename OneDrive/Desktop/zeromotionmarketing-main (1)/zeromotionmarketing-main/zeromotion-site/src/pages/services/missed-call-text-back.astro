    <style>
      /* =================================
         PERFECT VIDEO OPTIMIZATION SYSTEM
         ================================= */
      
      /* Base optimized video class - prevents stretching and pixelation */
      .optimized-background-video {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100vw;
        height: 100vh;
        min-width: 100%;
        min-height: 100%;
        object-fit: cover;
        object-position: center center;
        z-index: -1;
        pointer-events: none;
        
        /* Perfect centering and scaling to prevent stretching */
        transform: translate(-50%, -50%) scale(1.01);
        -webkit-transform: translate(-50%, -50%) scale(1.01);
        
        /* High-quality rendering */
        image-rendering: -webkit-optimize-contrast;
        image-rendering: optimize-contrast;
        image-rendering: auto;
        
        /* GPU acceleration */
        will-change: transform, opacity;
        transform-style: preserve-3d;
        -webkit-transform-style: preserve-3d;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        
        /* Smooth loading */
        visibility: hidden;
        opacity: 0;
        transition: opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                    visibility 0.1s ease-in;
      }
      
      /* Hero Video Optimization - Perfect 4K handling */
      .hero-video-optimized {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
        z-index: -1;
        pointer-events: none;
        
        /* Force immediate display */
        visibility: visible !important;
        opacity: 0.8 !important;
        
        /* Simple GPU acceleration */
        transform: translateZ(0);
        -webkit-transform: translateZ(0);
        
        /* High quality rendering */
        image-rendering: -webkit-optimize-contrast;
        image-rendering: optimize-contrast;
        image-rendering: auto;
        
        /* Optimized filters */
        filter: brightness(0.85) contrast(1.25) saturate(1.4) hue-rotate(0deg);
        
        /* Remove transitions that might cause issues */
        transition: none;
      }
      
      /* 4K UHD Video Specific Optimizations */
      .uhd-video {
        /* Enhanced quality for 4K content */
        image-rendering: -webkit-optimize-contrast;
        image-rendering: optimize-contrast;
        image-rendering: high-quality;
        
        /* Better compression handling */
        color-rendering: optimizeQuality;
        shape-rendering: geometricPrecision;
        text-rendering: geometricPrecision;
        
        /* Optimized for high-resolution displays */
        filter: brightness(0.85) contrast(1.25) saturate(1.4) hue-rotate(0deg) blur(0px);
        
        /* Enhanced performance for 4K - Same as other optimized videos */
        transform: translate3d(0, 0, 0) translateZ(0);
        -webkit-transform: translate3d(0, 0, 0) translateZ(0);
        transform-style: preserve-3d;
        -webkit-transform-style: preserve-3d;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        perspective: 1000px;
        -webkit-perspective: 1000px;
        
        /* Fast loading optimizations */
        visibility: hidden; /* Hide until loaded to prevent flicker */
        background: transparent;
        transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                    visibility 0.1s ease-in,
                    filter 0.3s ease-out;
        
        /* Performance hints */
        will-change: transform, filter, opacity;
        image-orientation: from-image;
      }
      
      /* Stable loading states - Hero video shows immediately */
      .stable-hero-video {
        visibility: visible !important;
        opacity: 0.8 !important;
        background: transparent;
        transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                    visibility 0.1s ease-in;
      }
      
      .stable-hero-video.loaded {
        visibility: visible;
        image-rendering: -webkit-optimize-contrast;
        image-rendering: optimize-contrast;
        filter: brightness(0.85) contrast(1.25) saturate(1.4) hue-rotate(0deg) blur(0px) !important;
      }
      
      /* Prevent flickering during load */
      .stable-hero-video:not(.loaded) {
        opacity: 0 !important;
        filter: brightness(0.5) contrast(0.8) saturate(0.8) blur(2px);
      }
      
