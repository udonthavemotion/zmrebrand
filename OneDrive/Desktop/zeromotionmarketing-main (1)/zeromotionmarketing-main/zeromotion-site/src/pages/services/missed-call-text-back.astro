      /* =================================
         CLIENT LOGO SHOWCASE STYLING
         ================================= */
      
      /* Client Logo Showcase Container */
      .client-logo-showcase {
        padding: 40px 20px;
      }
      
      /* Logo Grid Layout */
      .logo-showcase-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        max-width: 800px;
        margin: 0 auto;
        justify-items: center;
      }
      
      /* Second row with 2 logos centered properly */
      .logo-showcase-item:nth-child(4) {
        grid-column: 1;
        grid-row: 2;
        justify-self: center;
        margin-left: 50%;
      }
      
      .logo-showcase-item:nth-child(5) {
        grid-column: 3;
        grid-row: 2;
        justify-self: center;
        margin-right: 50%;
      }
      
      /* Logo Item Animation */
      .logo-showcase-item {
        opacity: 0;
        transform: translateY(30px);
        animation: fadeInUp 0.8s ease-out forwards;
        text-align: center;
        transition: all 0.3s ease;
      }
      
      .logo-showcase-item:nth-child(1) { animation-delay: 0.1s; }
      .logo-showcase-item:nth-child(2) { animation-delay: 0.2s; }
      .logo-showcase-item:nth-child(3) { animation-delay: 0.3s; }
      .logo-showcase-item:nth-child(4) { animation-delay: 0.4s; }
      .logo-showcase-item:nth-child(5) { animation-delay: 0.5s; }
      
      /* Seamless Logo Styling - All Same Size */
      .seamless-logo {
        width: 140px;
        height: 140px;
        object-fit: contain;
        object-position: center;
        margin-bottom: 25px;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        cursor: default;
        /* Pure transparent PNG - seamless integration */
      }
      
      /* Clickable logo gets pointer cursor */
      .clickable-logo {
        cursor: pointer;
      }
      
      /* Logo Link Styling */
      .logo-link {
        display: block;
        text-decoration: none;
        color: inherit;
        transition: all 0.4s ease;
      }
      
      .logo-link:hover {
        text-decoration: none;
      }
      
      /* Bounce and White Glow Effect on Hover */
      .logo-showcase-item:hover .seamless-logo,
      .logo-link:hover .seamless-logo {
        transform: translateY(-20px) scale(1.15);
        filter: drop-shadow(0 0 25px rgba(255, 255, 255, 0.9)) 
                drop-shadow(0 0 50px rgba(255, 255, 255, 0.6)) 
                drop-shadow(0 20px 40px rgba(0, 0, 0, 0.4));
        animation: logoBounce 0.7s ease-out;
      }
      
      /* Special hover effect for clickable logo */
      .logo-link:hover .clickable-logo {
        filter: drop-shadow(0 0 30px rgba(139, 92, 246, 0.8)) 
                drop-shadow(0 0 60px rgba(139, 92, 246, 0.4)) 
                drop-shadow(0 20px 40px rgba(0, 0, 0, 0.4));
      }
      
      .logo-info {
        opacity: 0.7;
        transform: translateY(5px);
        transition: all 0.4s ease;
        text-align: center;
      }
      
      .logo-showcase-item:hover .logo-info,
      .logo-link:hover .logo-info {
        opacity: 1;
        transform: translateY(-5px);
      }
      
      .logo-title {
        display: block;
        font-weight: 700;
        color: #ffffff;
        font-size: 1.2rem;
        margin-bottom: 0;
        text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
        letter-spacing: 0.5px;
      }
      
      /* Bounce Animation */
      @keyframes logoBounce {
        0% { transform: translateY(-20px) scale(1.15); }
        25% { transform: translateY(-35px) scale(1.2); }
        50% { transform: translateY(-15px) scale(1.12); }
        75% { transform: translateY(-25px) scale(1.18); }
        100% { transform: translateY(-20px) scale(1.15); }
      }
      
      /* Fade In Up Animation */
      @keyframes fadeInUp {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      /* Client Portfolio CTA Button Styling */
      .client-portfolio-cta-btn {
        display: inline-block;
        padding: 15px 30px;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        border-radius: 12px;
        border: none;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        text-align: center;
        line-height: 1.2;
        letter-spacing: 0.5px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
      }
      
      .client-portfolio-cta-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(139, 92, 246, 0.4);
        text-decoration: none;
      }
      
      /* Mobile Responsiveness for Logo Showcase */
      @media (max-width: 768px) {
        .logo-showcase-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 35px;
          max-width: 450px;
        }
        
        /* Reset grid positioning for mobile */
