---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ModernBookingModal from "../../components/ModernBookingModal.astro";
import TextureVideoSection from "../../components/sections/TextureVideoSection.astro";
import DarkContentSection from "../../components/sections/DarkContentSection.astro";
import { getAlternatingTexture, getPreloadTextures } from "../../lib/textures.ts";

// Texture videos for alternating sections
const texture1 = getAlternatingTexture(0);
const texture2 = getAlternatingTexture(1);
const texture3 = getAlternatingTexture(2);
const texture4 = getAlternatingTexture(3);
const preloadTextures = getPreloadTextures(4);

// Hero video
const HERO_VIDEO = "/pictures/web design page/webpage.mp4";

// Cache-busting for images
const cacheVersion = Date.now();

// Page metadata
const pageTitle = "Automation Operating System | ZeroMotion Marketing | Louisiana's Business Automation Platform";
const pageDescription = "Louisiana's automation operating system powered by ZeroMotion CRM. The foundation technology that connects missed call text-back, AI agents, and complete business automation.";
const pageKeywords = "business automation platform Louisiana, automation operating system, ZeroMotion CRM platform, AI automation, automated workflows, business automation technology";

// Structured data for automation platform
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Automation Operating System - Business Automation Platform",
  "description": pageDescription,
  "provider": {
    "@type": "Organization",
    "name": "ZeroMotion Marketing",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houma",
      "addressRegion": "Louisiana",
      "addressCountry": "US"
    }
  },
  "areaServed": "Louisiana",
  "serviceType": "Business Automation Platform Technology"
};
---

<BaseLayout 
  title={pageTitle}
  description={pageDescription}
  ogImage="/og-webdesign.png"
>
  <!-- Hero Section -->
  <section class="relative h-screen flex items-center justify-center overflow-hidden bg-black text-white">
    <!-- Video Background - Enhanced for bright, colorful display -->
    <div class="absolute inset-0 z-0">
      <video 
        autoplay 
        muted 
        loop 
        playsinline 
        preload="auto"
        class="w-full h-full object-cover stable-crm-video"
        style="filter: brightness(0.85) contrast(1.15) saturate(1.2); will-change: transform; opacity: 0.75;"
        aria-hidden="true"
        onloadstart="this.style.visibility='visible'"
        oncanplay="this.classList.add('loaded')"
      >
        <source src={HERO_VIDEO} type="video/mp4" />
      </video>
    </div>
    
    <!-- Workflow Overlay -->
    <div class="absolute inset-0 z-5 opacity-20">
      <div class="w-full h-full bg-gradient-to-br from-purple-600/30 to-transparent"></div>
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 opacity-30">
        <img 
          src={`/assets/zeromotion_workflow_1_lead_capture.png?v=${cacheVersion}`} 
          alt="Lead capture workflow" 
          class="w-full h-full object-contain"
          loading="eager"
        />
      </div>
    </div>
    
    <!-- Content -->
    <div class="relative z-10 container mx-auto px-6 text-center">
      <h1 class="h1 mb-6 max-w-5xl mx-auto">
        Your Business's <span class="text-purple-400">Automation Operating System</span>
      </h1>
      <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-4xl mx-auto">
        Powered by ZeroMotion CRM + AI. The foundation technology that connects missed call text-back, AI voice agents, and complete automation—so your business runs on autopilot.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                 <ModernBookingModal
           plan="crm"
           triggerText="See the Automation Platform"
         />
        <a href="#ecosystem" class="btn-ghost" data-event="automation_ecosystem_scroll">See How It All Connects</a>
      </div>

      <p class="text-sm text-purple-300 mt-6">
        Zero Motion = Zero Manual Effort • Maximum Conversion
      </p>
    </div>
  </section>

  <!-- Automation Foundation Section -->
  <TextureVideoSection textureVideo={texture1}>
    <div class="crm-superiority-section">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="h2 mb-6">The Automation Brain That Runs Your Business</h2>
          <p class="sub mb-8">ZeroMotion CRM is the nervous system connecting all your automation services</p>

          <ul class="space-y-4 text-lg">
            <li class="flex items-start gap-3">
              <span class="text-purple-400 text-xl">🚀</span>
              <span><strong>Missed Call Capture</strong> — Instantly captures missed calls and routes to AI text-back</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-purple-400 text-xl">⚡</span>
              <span><strong>AI Agent Integration</strong> — Powers voice and chat agents with real-time customer data</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-purple-400 text-xl">🎯</span>
              <span><strong>Workflow Automation</strong> — Triggers multi-channel sequences automatically</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-purple-400 text-xl">🔒</span>
              <span><strong>Unified Dashboard</strong> — Monitor all automation services from one control center</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-purple-400 text-xl">📊</span>
              <span><strong>Automation Analytics</strong> — Track ROI across all connected services</span>
            </li>
          </ul>
        </div>
        
        <div class="crm-visual-container">
          <img
            src="/assets/crm-main-dashboard.png"
            alt="ZeroMotion CRM dashboard showing lead management and automation features"
            loading="lazy"
            class="crm-main-image"
          />
          
          <!-- Floating CRM Automation Screenshot -->
          <div class="crm-automation-popup">
            <img
              src="/assets/crm-automation-screenshot.png"
              alt="ZeroMotion CRM automation workflow interface showing advanced pipeline management"
              loading="lazy"
              class="crm-popup-image-seamless"
            />
          </div>
        </div>
      </div>
    </div>
  </TextureVideoSection>

  <!-- Automation Ecosystem Workflow -->
  <section class="hero-video-section section" id="ecosystem">
    <div class="ecosystem-workflow-section">
      <h2 class="h2 mb-6 text-center" style="color: #8b5cf6;">How the Automation Operating System Connects Everything</h2>
      <p class="sub mb-12 text-center" style="color: #e2e8f0;">CRM is the central nervous system that powers your complete automation ecosystem</p>

      <div class="workflow-diagram">
        <div class="grid md:grid-cols-4 gap-8 mb-12">
          <!-- Step 1: Lead Enters -->
          <div class="workflow-step card">
            <div class="workflow-number">1</div>
            <div class="workflow-icon">📞</div>
            <h4 class="text-lg font-bold text-purple-400 mb-2">Lead Enters</h4>
            <p class="text-gray-300 text-sm">Customer calls, fills form, or messages</p>
          </div>

          <!-- Step 2: CRM Captures -->
          <div class="workflow-step card highlighted-step">
            <div class="workflow-number">2</div>
            <div class="workflow-icon">🧠</div>
            <h4 class="text-lg font-bold text-purple-400 mb-2">CRM Brain Activates</h4>
            <p class="text-gray-300 text-sm">Instantly captures and routes to automation</p>
          </div>

          <!-- Step 3: Automation Triggers -->
          <div class="workflow-step card">
            <div class="workflow-number">3</div>
            <div class="workflow-icon">⚡</div>
            <h4 class="text-lg font-bold text-purple-400 mb-2">Services Engage</h4>
            <p class="text-gray-300 text-sm">AI agents + missed call text-back activate</p>
          </div>

          <!-- Step 4: Conversion -->
          <div class="workflow-step card">
            <div class="workflow-number">4</div>
            <div class="workflow-icon">🎯</div>
            <h4 class="text-lg font-bold text-purple-400 mb-2">Auto Conversion</h4>
            <p class="text-gray-300 text-sm">Lead → Customer, automatically</p>
          </div>
        </div>

        <!-- Service Integration Grid -->
        <div class="grid md:grid-cols-3 gap-8">
          <div class="service-integration-card card">
            <div class="integration-icon mb-4">
              <span class="text-4xl">📲</span>
            </div>
            <h4 class="text-xl font-bold text-purple-400 mb-3">Missed Call Text-Back</h4>
            <p class="text-gray-300 mb-4">CRM detects missed calls instantly and triggers automated SMS response within seconds. No lead left behind.</p>
            <div class="integration-tech">
              <span class="tech-badge">CRM Trigger</span>
              <span class="tech-badge">AI SMS</span>
            </div>
          </div>

          <div class="service-integration-card card">
            <div class="integration-icon mb-4">
              <span class="text-4xl">🤖</span>
            </div>
            <h4 class="text-xl font-bold text-purple-400 mb-3">AI Voice + Chat Agents</h4>
            <p class="text-gray-300 mb-4">CRM feeds real-time customer data to AI agents for personalized conversations and intelligent routing.</p>
            <div class="integration-tech">
              <span class="tech-badge">CRM Data</span>
              <span class="tech-badge">AI Context</span>
            </div>
          </div>

          <div class="service-integration-card card">
            <div class="integration-icon mb-4">
              <span class="text-4xl">🔄</span>
            </div>
            <h4 class="text-xl font-bold text-purple-400 mb-3">ZeroMotion Automations</h4>
            <p class="text-gray-300 mb-4">CRM powers multi-channel workflows, email sequences, and automated nurture campaigns that convert leads.</p>
            <div class="integration-tech">
              <span class="tech-badge">CRM Workflows</span>
              <span class="tech-badge">Auto Sequences</span>
            </div>
          </div>
        </div>

        <div class="ecosystem-cta text-center mt-12">
          <p class="text-xl text-purple-300 mb-6">
            Without CRM as your foundation, these services can't communicate. With it, they work as one unified automation machine.
          </p>
          <ModernBookingModal
            plan="crm"
            triggerText="See the Ecosystem in Action"
          />
        </div>
      </div>
    </div>

    <!-- Hero Video Background -->
    <video
      src="/photos/homepage_hero.mp4"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      class="hero-background-video stable-hero-video"
      style="opacity: 0.8; filter: brightness(0.8) contrast(1.1) saturate(1.2); will-change: transform;"
      onloadstart="this.style.visibility='visible'"
      oncanplay="this.classList.add('loaded')"
      width="1920"
      height="1080"
      aria-hidden="true"
      role="img"
      aria-label="Background video showing ZeroMotion's automation ecosystem"
    ></video>

    <!-- Overlay gradient for text readability -->
    <div class="hero-video-overlay"></div>
  </section>

  <!-- Automation Transformation Timeline -->
  <section class="hero-video-section section">
    <div class="implementation-hierarchy">
      <h2 class="h2" style="color: #8b5cf6; text-align: center; margin-bottom: 20px;">Your 6-Week Automation Transformation</h2>
      <p class="sub" style="text-align: center; margin-bottom: 50px; color: #e2e8f0;">From manual chaos to complete automation in strategic phases</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="card text-center">
          <div class="w-24 h-24 mx-auto mb-6 relative">
            <img
              src={`/assets/implementation/week1-2-foundation-v2.png?v=${cacheVersion}`}
              alt="Foundation setup phase - ZeroMotion agency dashboard"
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <h3 class="h3 mb-3 text-purple-400">Week 1-2</h3>
          <h4 class="text-lg font-bold mb-2">Automation Foundation</h4>
          <p class="text-gray-300 text-sm">Deploy CRM operating system, connect lead capture, and activate basic automations.</p>
        </div>

        <div class="card text-center">
          <div class="w-24 h-24 mx-auto mb-6 relative">
            <img
              src={`/assets/implementation/week3-4-automation-v2.png?v=${cacheVersion}`}
              alt="AI integration phase - ZeroMotion opportunities pipeline dashboard"
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <h3 class="h3 mb-3 text-purple-400">Week 3-4</h3>
          <h4 class="text-lg font-bold mb-2">AI Integration</h4>
          <p class="text-gray-300 text-sm">Integrate AI voice agents, missed call text-back, and intelligent routing.</p>
        </div>

        <div class="card text-center">
          <div class="w-24 h-24 mx-auto mb-6 relative">
            <img
              src={`/assets/implementation/week5-6-communication-v2.png?v=${cacheVersion}`}
              alt="Full automation phase - ZeroMotion agency communication dashboard"
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <h3 class="h3 mb-3 text-purple-400">Week 5-6</h3>
          <h4 class="text-lg font-bold mb-2">Complete Automation</h4>
          <p class="text-gray-300 text-sm">Multi-channel workflows, payment processing, and ecosystem integration.</p>
        </div>

        <div class="card text-center">
          <div class="w-24 h-24 mx-auto mb-6 relative">
            <img
              src={`/assets/implementation/week7-full-operation-v2.png?v=${cacheVersion}`}
              alt="Optimization phase - ZeroMotion digital presence dashboard with mobile and tablet views"
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <h3 class="h3 mb-3 text-purple-400">Week 7+</h3>
          <h4 class="text-lg font-bold mb-2">Growth Optimization</h4>
          <p class="text-gray-300 text-sm">AI tuning, analytics refinement, and scaling automation for growth.</p>
        </div>
      </div>
    </div>
    
    <!-- Hero Video Background -->
    <video 
      src="/photos/homepage_hero.mp4" 
      autoplay 
      muted 
      loop 
      playsinline
      preload="auto"
      class="hero-background-video stable-hero-video"
      style="opacity: 0.8; filter: brightness(0.8) contrast(1.1) saturate(1.2); will-change: transform;"
      onloadstart="this.style.visibility='visible'"
      oncanplay="this.classList.add('loaded')"
      width="1920"
      height="1080"
      aria-hidden="true"
      role="img"
      aria-label="Background video showing ZeroMotion's CRM implementation process"
    ></video>
    
    <!-- Overlay gradient for text readability -->
    <div class="hero-video-overlay"></div>
  </section>

  <!-- CRM Features Showcase -->
  <section class="hero-video-section section">
    <div class="crm-features-section">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="order-2 md:order-1">
          <div class="crm-isometric-container">
            <img
              src="/assets/zeromotion-crm-isometric.png"
              alt="ZeroMotion CRM platform isometric view showing automation features"
              class="crm-isometric-image float-animation"
              loading="lazy"
            />
          </div>
        </div>
        
        <div class="order-1 md:order-2">
          <h2 class="h2 mb-6">Automation Capabilities Powered by CRM</h2>
          <p class="sub mb-8">Six core technologies that enable your complete automation ecosystem</p>

          <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-6">
            <div class="space-y-4">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-xl">📝</span>
              </div>
              <h4 class="text-xl font-bold text-purple-400">Instant Missed Call Capture</h4>
              <p class="text-gray-300">Automatically detects missed calls and routes to AI text-back within 60 seconds—24/7 lead response.</p>
            </div>

            <div class="space-y-4">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-xl">🔄</span>
              </div>
              <h4 class="text-xl font-bold text-purple-400">AI-Powered Multi-Channel Nurture</h4>
              <p class="text-gray-300">Automated SMS, email, and voice sequences that convert prospects into customers intelligently.</p>
            </div>

            <div class="space-y-4">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-xl">📊</span>
              </div>
              <h4 class="text-xl font-bold text-purple-400">Automated Deal Progression</h4>
              <p class="text-gray-300">AI scoring and automated pipeline movement—leads advance automatically based on behavior.</p>
            </div>

            <div class="space-y-4">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-xl">💳</span>
              </div>
              <h4 class="text-xl font-bold text-purple-400">Integrated Payment Automation</h4>
              <p class="text-gray-300">Stripe integration triggers automated receipts, invoicing, and revenue tracking workflows.</p>
            </div>

            <div class="space-y-4">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-xl">📅</span>
              </div>
              <h4 class="text-xl font-bold text-purple-400">Smart Booking with AI Conflict Resolution</h4>
              <p class="text-gray-300">Automated appointment scheduling with AI-powered time optimization and reminder sequences.</p>
            </div>

            <div class="space-y-4">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-xl">💬</span>
              </div>
              <h4 class="text-xl font-bold text-purple-400">Communication Automation Hub</h4>
              <p class="text-gray-300">Central control for all automated messaging—SMS, email, voice, and chat in one platform.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Hero Video Background -->
    <video 
      src="/photos/homepage_hero.mp4" 
      autoplay 
      muted 
      loop 
      playsinline
      preload="auto"
      class="hero-background-video stable-hero-video"
      style="opacity: 0.8; filter: brightness(0.8) contrast(1.1) saturate(1.2); will-change: transform;"
      onloadstart="this.style.visibility='visible'"
      oncanplay="this.classList.add('loaded')"
      width="1920"
      height="1080"
      aria-hidden="true"
      role="img"
      aria-label="Background video showing ZeroMotion's CRM features"
    ></video>
    
    <!-- Overlay gradient for text readability -->
    <div class="hero-video-overlay"></div>
  </section>

  <!-- Automation Platform Comparison -->
  <section class="hero-video-section section">
    <div class="comparison-section">
      <h2 class="h2" style="color: #8b5cf6; text-align: center; margin-bottom: 20px;">Why the Automation Operating System Dominates</h2>
      <p class="sub" style="text-align: center; margin-bottom: 40px; color: #e2e8f0;">See the difference between manual work, generic tools, and complete automation platform</p>
      
      <div class="table-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 0 -1rem;">
        <table class="comparison-table" style="width: 100%; border-collapse: collapse; background: rgba(0, 0, 0, 0.4); border-radius: 15px; overflow: hidden; margin: 0 1rem;">
          <thead>
            <tr>
              <th style="background: linear-gradient(45deg, #8b5cf6, #a855f7); color: white; padding: 20px; text-align: left; font-weight: bold;">Capability</th>
              <th style="background: linear-gradient(45deg, #ef4444, #dc2626); color: white; padding: 20px; text-align: center; font-weight: bold;">Manual Work</th>
              <th style="background: linear-gradient(45deg, #f59e0b, #d97706); color: white; padding: 20px; text-align: center; font-weight: bold;">Disconnected Tools</th>
              <th style="background: linear-gradient(45deg, #10b981, #059669); color: white; padding: 20px; text-align: center; font-weight: bold;">Automation Platform</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="feature-name" style="padding: 16px; font-weight: bold; color: #ffffff; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Missed Call Response</td>
              <td data-label="Manual Work" style="padding: 16px; text-align: center; color: #fca5a5; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Hours/Never</td>
              <td data-label="Disconnected Tools" style="padding: 16px; text-align: center; color: #fde68a; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Manual SMS</td>
              <td data-label="Automation Platform" style="padding: 16px; text-align: center; color: #86efac; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Auto AI Text-Back (60s)</td>
            </tr>
            <tr>
              <td class="feature-name" style="padding: 16px; font-weight: bold; color: #ffffff; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">AI Agent Integration</td>
              <td data-label="Manual Work" style="padding: 16px; text-align: center; color: #fca5a5; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">None</td>
              <td data-label="Disconnected Tools" style="padding: 16px; text-align: center; color: #fde68a; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Separate Systems</td>
              <td data-label="Automation Platform" style="padding: 16px; text-align: center; color: #86efac; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Unified AI + CRM Data</td>
            </tr>
            <tr>
              <td class="feature-name" style="padding: 16px; font-weight: bold; color: #ffffff; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Workflow Automation</td>
              <td data-label="Manual Work" style="padding: 16px; text-align: center; color: #fca5a5; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">All Manual</td>
              <td data-label="Disconnected Tools" style="padding: 16px; text-align: center; color: #fde68a; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Limited Automation</td>
              <td data-label="Automation Platform" style="padding: 16px; text-align: center; color: #86efac; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Complete Ecosystem</td>
            </tr>
            <tr>
              <td class="feature-name" style="padding: 16px; font-weight: bold; color: #ffffff; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Service Integration</td>
              <td data-label="Manual Work" style="padding: 16px; text-align: center; color: #fca5a5; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">None</td>
              <td data-label="Disconnected Tools" style="padding: 16px; text-align: center; color: #fde68a; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Manual Data Transfer</td>
              <td data-label="Automation Platform" style="padding: 16px; text-align: center; color: #86efac; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">All Services Connected</td>
            </tr>
            <tr>
              <td class="feature-name" style="padding: 16px; font-weight: bold; color: #ffffff; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Time Saved</td>
              <td data-label="Manual Work" style="padding: 16px; text-align: center; color: #fca5a5; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">0 Hours</td>
              <td data-label="Disconnected Tools" style="padding: 16px; text-align: center; color: #fde68a; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">5 Hours/Week</td>
              <td data-label="Automation Platform" style="padding: 16px; text-align: center; color: #86efac; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">15+ Hours/Week</td>
            </tr>
            <tr class="result-row" style="background: rgba(139, 92, 246, 0.15); font-weight: bold; font-size: 1.1rem;">
              <td class="feature-name" style="padding: 16px; font-weight: bold; color: #8b5cf6;">Result</td>
              <td data-label="Manual Work" style="padding: 16px; text-align: center; font-weight: bold; color: #ef4444;">Overwhelmed & Losing</td>
              <td data-label="Disconnected Tools" style="padding: 16px; text-align: center; font-weight: bold; color: #f59e0b;">Fragmented Progress</td>
              <td data-label="Automation Platform" style="padding: 16px; text-align: center; font-weight: bold; color: #10b981;">Zero Motion Success</td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <div class="text-center mt-8">
