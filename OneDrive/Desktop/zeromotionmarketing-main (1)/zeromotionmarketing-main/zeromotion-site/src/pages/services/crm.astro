---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ModernBookingModal from "../../components/ModernBookingModal.astro";
import TextureVideoSection from "../../components/sections/TextureVideoSection.astro";
import DarkContentSection from "../../components/sections/DarkContentSection.astro";
import { getAlternatingTexture, getPreloadTextures } from "../../lib/textures.ts";

// Texture videos for alternating sections
const texture1 = getAlternatingTexture(0);
const texture2 = getAlternatingTexture(1);
const texture3 = getAlternatingTexture(2);
const texture4 = getAlternatingTexture(3);
const preloadTextures = getPreloadTextures(4);

// Hero video
const HERO_VIDEO = "/pictures/web design page/webpage.mp4";

// Cache-busting for images
const cacheVersion = Date.now();

// Page metadata
const pageTitle = "CRM Automation Services | ZeroMotion Marketing | Louisiana's Advanced Business Platform";
const pageDescription = "Louisiana's most advanced CRM automation platform. AI-powered lead management, instant follow-up, and business automation for growing companies.";
const pageKeywords = "CRM automation Louisiana, business automation, lead management, sales automation, Louisiana CRM, business software, AI automation";

// Structured data for CRM service
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "CRM Automation Services",
  "description": pageDescription,
  "provider": {
    "@type": "Organization",
    "name": "ZeroMotion Marketing",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Houma",
      "addressRegion": "Louisiana",
      "addressCountry": "US"
    }
  },
  "areaServed": "Louisiana",
  "serviceType": "CRM Automation and Business Process Management"
};
---

<BaseLayout 
  title={pageTitle}
  description={pageDescription}
  ogImage="/og-webdesign.png"
>
  <!-- Hero Section -->
  <section class="relative h-screen flex items-center justify-center overflow-hidden bg-black text-white">
    <!-- Video Background - Enhanced for bright, colorful display -->
    <div class="absolute inset-0 z-0">
      <video 
        autoplay 
        muted 
        loop 
        playsinline 
        preload="auto"
        class="w-full h-full object-cover stable-crm-video"
        style="filter: brightness(0.85) contrast(1.15) saturate(1.2); will-change: transform; opacity: 0.75;"
        aria-hidden="true"
        onloadstart="this.style.visibility='visible'"
        oncanplay="this.classList.add('loaded')"
      >
        <source src={HERO_VIDEO} type="video/mp4" />
      </video>
    </div>
    
    <!-- Workflow Overlay -->
    <div class="absolute inset-0 z-5 opacity-20">
      <div class="w-full h-full bg-gradient-to-br from-purple-600/30 to-transparent"></div>
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 opacity-30">
        <img 
          src={`/assets/zeromotion_workflow_1_lead_capture.png?v=${cacheVersion}`} 
          alt="Lead capture workflow" 
          class="w-full h-full object-contain"
          loading="eager"
        />
      </div>
    </div>
    
    <!-- Content -->
    <div class="relative z-10 container mx-auto px-6 text-center">
      <h1 class="h1 mb-6 max-w-5xl mx-auto">
        A Modern CRM That <span class="text-purple-400">Automates Your Growth</span>
      </h1>
      <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-4xl mx-auto">
        Built on ZeroMotion CRM, enhanced with AI, and engineered for modern businesses. Stop losing leads to slow follow-up—automate your way to market leadership.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                 <ModernBookingModal 
           plan="crm"
           triggerText="Book One-on-One CRM Demo"
         />
        <a href="#features" class="btn-ghost" data-event="crm_features_scroll">See CRM Features</a>
      </div>
      
      <p class="text-sm text-purple-300 mt-6">
        AI-powered • Built for real operators
      </p>
    </div>
  </section>

  <!-- CRM Superiority Section -->
  <TextureVideoSection textureVideo={texture1}>
    <div class="crm-superiority-section">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="h2 mb-6">More Than CRM—It's Your Competitive Advantage</h2>
          <p class="sub mb-8">While competitors manually chase leads, you dominate with automation</p>
          
          <ul class="space-y-4 text-lg">
            <li class="flex items-start gap-3">
              <span class="text-purple-400 text-xl">🚀</span>
              <span><strong>Instant Lead Response</strong> — AI responds within 60 seconds, 24/7</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-purple-400 text-xl">⚡</span>
              <span><strong>Pipeline Automation</strong> — Leads automatically sorted, scored, and nurtured</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-purple-400 text-xl">🎯</span>
              <span><strong>Smart Booking</strong> — Calendars, payments, and follow-ups run themselves</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-purple-400 text-xl">🔒</span>
              <span><strong>Industry-Focused</strong> — Built for growing businesses across all sectors</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-purple-400 text-xl">📊</span>
              <span><strong>Real-Time Insights</strong> — Know your ROI, not just your vanity metrics</span>
            </li>
          </ul>
        </div>
        
        <div class="crm-visual-container">
          <img
            src="/assets/crm-main-dashboard.png"
            alt="ZeroMotion CRM dashboard showing lead management and automation features"
            loading="lazy"
            class="crm-main-image"
          />
          
          <!-- Floating CRM Automation Screenshot -->
          <div class="crm-automation-popup">
            <img
              src="/assets/crm-automation-screenshot.png"
              alt="ZeroMotion CRM automation workflow interface showing advanced pipeline management"
              loading="lazy"
              class="crm-popup-image-seamless"
            />
          </div>
        </div>
      </div>
    </div>
  </TextureVideoSection>

  <!-- CRM Implementation Hierarchy -->
  <section class="hero-video-section section">
    <div class="implementation-hierarchy">
      <h2 class="h2" style="color: #8b5cf6; text-align: center; margin-bottom: 20px;">CRM Implementation That Scales With Your Business</h2>
      <p class="sub" style="text-align: center; margin-bottom: 50px; color: #e2e8f0;">From setup to market domination in strategic phases</p>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="card text-center">
          <div class="w-24 h-24 mx-auto mb-6 relative">
            <img 
              src={`/assets/implementation/week1-2-foundation-v2.png?v=${cacheVersion}`} 
              alt="Foundation setup phase - ZeroMotion agency dashboard" 
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <h3 class="h3 mb-3 text-purple-400">Week 1-2</h3>
          <h4 class="text-lg font-bold mb-2">Foundation Setup</h4>
          <p class="text-gray-300 text-sm">CRM configuration, lead capture forms, and basic automation workflows.</p>
        </div>
        
        <div class="card text-center">
          <div class="w-24 h-24 mx-auto mb-6 relative">
            <img 
              src={`/assets/implementation/week3-4-automation-v2.png?v=${cacheVersion}`} 
              alt="Automation implementation phase - ZeroMotion opportunities pipeline dashboard" 
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <h3 class="h3 mb-3 text-purple-400">Week 3-4</h3>
          <h4 class="text-lg font-bold mb-2">Automation Implementation</h4>
          <p class="text-gray-300 text-sm">Advanced pipelines, email sequences, and AI-powered lead scoring.</p>
        </div>
        
        <div class="card text-center">
          <div class="w-24 h-24 mx-auto mb-6 relative">
            <img 
              src={`/assets/implementation/week5-6-communication-v2.png?v=${cacheVersion}`} 
              alt="Communication hub phase - ZeroMotion agency communication dashboard" 
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <h3 class="h3 mb-3 text-purple-400">Week 5-6</h3>
          <h4 class="text-lg font-bold mb-2">Communication Hub</h4>
          <p class="text-gray-300 text-sm">SMS automation, appointment booking, and integrated payment processing.</p>
        </div>
        
        <div class="card text-center">
          <div class="w-24 h-24 mx-auto mb-6 relative">
            <img 
              src={`/assets/implementation/week7-full-operation-v2.png?v=${cacheVersion}`} 
              alt="Full operation phase - ZeroMotion digital presence dashboard with mobile and tablet views" 
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <h3 class="h3 mb-3 text-purple-400">Week 7+</h3>
          <h4 class="text-lg font-bold mb-2">Full Operation</h4>
          <p class="text-gray-300 text-sm">Complete automation, analytics integration, and ongoing optimization.</p>
        </div>
      </div>
    </div>
    
    <!-- Hero Video Background -->
    <video 
      src="/photos/homepage_hero.mp4" 
      autoplay 
      muted 
      loop 
      playsinline
      preload="auto"
      class="hero-background-video stable-hero-video"
      style="opacity: 0.8; filter: brightness(0.8) contrast(1.1) saturate(1.2); will-change: transform;"
      onloadstart="this.style.visibility='visible'"
      oncanplay="this.classList.add('loaded')"
      width="1920"
      height="1080"
      aria-hidden="true"
      role="img"
      aria-label="Background video showing ZeroMotion's CRM implementation process"
    ></video>
    
    <!-- Overlay gradient for text readability -->
    <div class="hero-video-overlay"></div>
  </section>

  <!-- CRM Features Showcase -->
  <section class="hero-video-section section">
    <div class="crm-features-section">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="order-2 md:order-1">
          <div class="crm-isometric-container">
            <img
              src="/assets/zeromotion-crm-isometric.png"
              alt="ZeroMotion CRM platform isometric view showing automation features"
              class="crm-isometric-image float-animation"
              loading="lazy"
            />
          </div>
        </div>
        
        <div class="order-1 md:order-2">
          <h2 class="h2 mb-6">CRM Features That Drive Business Growth</h2>
          <p class="sub mb-8">Six core capabilities that transform how you capture and convert leads</p>
          
          <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-6">
            <div class="space-y-4">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-xl">📝</span>
              </div>
              <h4 class="text-xl font-bold text-purple-400">Lead Capture</h4>
              <p class="text-gray-300">Smart forms that integrate with everything—websites, social media, and offline touchpoints.</p>
            </div>
            
            <div class="space-y-4">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-xl">🔄</span>
              </div>
              <h4 class="text-xl font-bold text-purple-400">Auto Follow-up</h4>
              <p class="text-gray-300">SMS and email sequences that convert prospects into customers automatically.</p>
            </div>
            
            <div class="space-y-4">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-xl">📊</span>
              </div>
              <h4 class="text-xl font-bold text-purple-400">Pipeline Tracking</h4>
              <p class="text-gray-300">Visual sales pipeline with deal progression and revenue forecasting.</p>
            </div>
            
            <div class="space-y-4">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-xl">💳</span>
              </div>
              <h4 class="text-xl font-bold text-purple-400">Payment Processing</h4>
              <p class="text-gray-300">Stripe integration for instant transactions and automated billing cycles.</p>
            </div>
            
            <div class="space-y-4">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-xl">📅</span>
              </div>
              <h4 class="text-xl font-bold text-purple-400">Calendar Booking</h4>
              <p class="text-gray-300">Automated appointment scheduling with confirmation and reminder workflows.</p>
            </div>
            
            <div class="space-y-4">
              <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center">
                <span class="text-xl">💬</span>
              </div>
              <h4 class="text-xl font-bold text-purple-400">SMS Automation</h4>
              <p class="text-gray-300">Compliant messaging workflows that nurture leads into sales.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Hero Video Background -->
    <video 
      src="/photos/homepage_hero.mp4" 
      autoplay 
      muted 
      loop 
      playsinline
      preload="auto"
      class="hero-background-video stable-hero-video"
      style="opacity: 0.8; filter: brightness(0.8) contrast(1.1) saturate(1.2); will-change: transform;"
      onloadstart="this.style.visibility='visible'"
      oncanplay="this.classList.add('loaded')"
      width="1920"
      height="1080"
      aria-hidden="true"
      role="img"
      aria-label="Background video showing ZeroMotion's CRM features"
    ></video>
    
    <!-- Overlay gradient for text readability -->
    <div class="hero-video-overlay"></div>
  </section>

  <!-- Integration Superiority Comparison -->
  <section class="hero-video-section section">
    <div class="comparison-section">
      <h2 class="h2" style="color: #8b5cf6; text-align: center; margin-bottom: 20px;">Why ZeroMotion CRM Dominates the Competition</h2>
      <p class="sub" style="text-align: center; margin-bottom: 40px; color: #e2e8f0;">See the difference between manual processes, generic CRM, and ZeroMotion automation</p>
      
      <div class="table-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 0 -1rem;">
        <table class="comparison-table" style="width: 100%; border-collapse: collapse; background: rgba(0, 0, 0, 0.4); border-radius: 15px; overflow: hidden; margin: 0 1rem;">
          <thead>
            <tr>
              <th style="background: linear-gradient(45deg, #8b5cf6, #a855f7); color: white; padding: 20px; text-align: left; font-weight: bold;">Features</th>
              <th style="background: linear-gradient(45deg, #ef4444, #dc2626); color: white; padding: 20px; text-align: center; font-weight: bold;">Manual Processes</th>
              <th style="background: linear-gradient(45deg, #f59e0b, #d97706); color: white; padding: 20px; text-align: center; font-weight: bold;">Generic CRM</th>
              <th style="background: linear-gradient(45deg, #10b981, #059669); color: white; padding: 20px; text-align: center; font-weight: bold;">ZeroMotion CRM</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="feature-name" style="padding: 16px; font-weight: bold; color: #ffffff; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Lead Response Time</td>
              <td data-label="Manual Processes" style="padding: 16px; text-align: center; color: #fca5a5; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Hours to Days</td>
              <td data-label="Generic CRM" style="padding: 16px; text-align: center; color: #fde68a; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Basic Notifications</td>
              <td data-label="ZeroMotion CRM" style="padding: 16px; text-align: center; color: #86efac; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">60 Seconds (AI-Powered)</td>
            </tr>
            <tr>
              <td class="feature-name" style="padding: 16px; font-weight: bold; color: #ffffff; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Follow-up Automation</td>
              <td data-label="Manual Processes" style="padding: 16px; text-align: center; color: #fca5a5; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Manual Emails/Calls</td>
              <td data-label="Generic CRM" style="padding: 16px; text-align: center; color: #fde68a; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Basic Sequences</td>
              <td data-label="ZeroMotion CRM" style="padding: 16px; text-align: center; color: #86efac; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Advanced Multi-Channel</td>
            </tr>
            <tr>
              <td class="feature-name" style="padding: 16px; font-weight: bold; color: #ffffff; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Business Integration</td>
              <td data-label="Manual Processes" style="padding: 16px; text-align: center; color: #fca5a5; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">None</td>
              <td data-label="Generic CRM" style="padding: 16px; text-align: center; color: #fde68a; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Generic Templates</td>
              <td data-label="ZeroMotion CRM" style="padding: 16px; text-align: center; color: #86efac; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Industry-Focused Setup</td>
            </tr>
            <tr>
              <td class="feature-name" style="padding: 16px; font-weight: bold; color: #ffffff; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">AI Enhancement</td>
              <td data-label="Manual Processes" style="padding: 16px; text-align: center; color: #fca5a5; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">None</td>
              <td data-label="Generic CRM" style="padding: 16px; text-align: center; color: #fde68a; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Basic Automation</td>
              <td data-label="ZeroMotion CRM" style="padding: 16px; text-align: center; color: #86efac; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Predictive Analytics</td>
            </tr>
            <tr>
              <td class="feature-name" style="padding: 16px; font-weight: bold; color: #ffffff; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Business Growth Impact</td>
              <td data-label="Manual Processes" style="padding: 16px; text-align: center; color: #fca5a5; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Limited</td>
              <td data-label="Generic CRM" style="padding: 16px; text-align: center; color: #fde68a; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Moderate Improvement</td>
              <td data-label="ZeroMotion CRM" style="padding: 16px; text-align: center; color: #86efac; border-bottom: 1px solid rgba(139, 92, 246, 0.2);">Explosive Growth</td>
            </tr>
            <tr class="result-row" style="background: rgba(139, 92, 246, 0.15); font-weight: bold; font-size: 1.1rem;">
              <td class="feature-name" style="padding: 16px; font-weight: bold; color: #8b5cf6;">Result</td>
              <td data-label="Manual Processes" style="padding: 16px; text-align: center; font-weight: bold; color: #ef4444;">Loses Deals</td>
              <td data-label="Generic CRM" style="padding: 16px; text-align: center; font-weight: bold; color: #f59e0b;">Manages Contacts</td>
              <td data-label="ZeroMotion CRM" style="padding: 16px; text-align: center; font-weight: bold; color: #10b981;">Dominates Market</td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <div class="text-center mt-8">
        <ModernBookingModal 
          plan="crm"
          triggerText="See CRM Demo"
        />
      </div>
    </div>
    
    <!-- Hero Video Background -->
    <video 
      src="/photos/homepage_hero.mp4" 
      autoplay 
      muted 
      loop 
      playsinline
      preload="auto"
      class="hero-background-video stable-hero-video"
      style="opacity: 0.8; filter: brightness(0.8) contrast(1.1) saturate(1.2); will-change: transform;"
      onloadstart="this.style.visibility='visible'"
      oncanplay="this.classList.add('loaded')"
      width="1920"
      height="1080"
      aria-hidden="true"
      role="img"
      aria-label="Background video showing ZeroMotion's CRM comparison"
    ></video>
    
    <!-- Overlay gradient for text readability -->
    <div class="hero-video-overlay"></div>
  </section>

  <!-- Pricing & Plans Integration -->
  <TextureVideoSection textureVideo={texture3}>
    <div class="pricing-integration-section">
      <h2 class="h2 mb-6 text-center">CRM Integration Across All Growth Stages</h2>
      <p class="sub mb-12 text-center">How our automation platform enhances your business at every level</p>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="card pkg system-card">
          <h3 class="h3 text-purple-400 mb-4">Starter CRM</h3>
          <div class="price mb-4">Custom Quote • Entry Level</div>
          <p class="text-sm text-gray-400 mb-6">Perfect for new businesses</p>
          
          <ul class="space-y-3 mb-8">
            <li>✓ Basic CRM setup & lead capture</li>
            <li>✓ Auto-SMS responses</li>
            <li>✓ Simple email sequences</li>
            <li>✓ Contact management</li>
            <li>✓ Basic reporting</li>
          </ul>
          
          <a
            href="/pricing"
            class="btn-primary"
            data-event="crm_starter_plan_view"
          >
            View Pricing
          </a>
        </div>
        
        <div class="card pkg system-card popular-card" style="border-color: rgba(139, 92, 246, 0.8); box-shadow: 0 15px 30px rgba(139, 92, 246, 0.2);">
          <span class="badge" style="position: absolute; top: -15px; left: 50%; transform: translateX(-50%); background: linear-gradient(45deg, #8b5cf6, #a855f7); color: white; padding: 8px 20px; border-radius: 20px; font-weight: bold; font-size: 14px; white-space: nowrap;">Most Popular for Growing Businesses</span>
          <h3 class="h3 text-purple-400 mb-4">Growth CRM</h3>
          <div class="price mb-4">Custom Quote • Most Popular</div>
          <p class="text-sm text-gray-400 mb-6">For expanding operations</p>
          
          <ul class="space-y-3 mb-8">
            <li>✓ Advanced automation & funnels</li>
            <li>✓ Multi-channel campaigns</li>
            <li>✓ Pipeline management</li>
            <li>✓ Advanced reporting & analytics</li>
            <li>✓ Team collaboration tools</li>
          </ul>
          
          <a
            href="/pricing"
            class="btn-primary"
            data-event="crm_growth_plan_view"
          >
            View Pricing
          </a>
        </div>
        
        <div class="card pkg system-card">
          <h3 class="h3 text-purple-400 mb-4">Scale CRM</h3>
          <div class="price mb-4">Custom Quote • Enterprise</div>
          <p class="text-sm text-gray-400 mb-6">Enterprise solutions for market leaders</p>
          
          <ul class="space-y-3 mb-8">
            <li>✓ Enterprise CRM & AI chatbots</li>
            <li>✓ Predictive analytics</li>
            <li>✓ Custom integrations</li>
            <li>✓ Multi-location management</li>
            <li>✓ Dedicated success manager</li>
          </ul>
          
          <a
            href="/pricing"
            class="btn-primary"
            data-event="crm_scale_plan_view"
          >
            View Pricing
          </a>
        </div>
      </div>
    </div>
  </TextureVideoSection>

  <!-- Modern Business Focus -->
  <DarkContentSection background="rgba(139, 92, 246, 0.06)">
    <div class="louisiana-focus-section">
      <h2 class="h2" style="color: #8b5cf6; text-align: center; margin-bottom: 20px;">Built for Modern Business Culture</h2>
      <p class="sub" style="text-align: center; margin-bottom: 50px; color: #e2e8f0;">Why growing companies choose ZeroMotion CRM over generic solutions</p>
      
      <div class="grid md:grid-cols-2 gap-12">
        <div class="space-y-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-xl">🏠</span>
            </div>
            <div>
              <h4 class="text-xl font-bold text-purple-400 mb-2">Business Expertise</h4>
              <p class="text-gray-300">Built for modern business culture. We understand how companies operate and what drives results in competitive markets.</p>
            </div>
