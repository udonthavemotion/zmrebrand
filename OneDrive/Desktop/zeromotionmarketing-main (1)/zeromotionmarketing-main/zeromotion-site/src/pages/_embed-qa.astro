---
import GHLForm from "../components/GHLForm.astro";
import GHLCalendar from "../components/GHLCalendar.astro";
const FB = import.meta.env.PUBLIC_GHL_FORM_BASE;
const CB = import.meta.env.PUBLIC_GHL_CAL_BASE;
const FID = import.meta.env.PUBLIC_GHL_FORM_ID;
const CID = import.meta.env.PUBLIC_GHL_CALENDAR_ID;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Embed QA - ZeroMotion</title>
    <style>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
        background: #0d0d1a;
        color: #ffffff;
      }
      h1 {
        color: #8b5cf6;
        border-bottom: 2px solid #8b5cf6;
        padding-bottom: 10px;
      }
      ul {
        background: #1a1a2e;
        padding: 20px;
        border-radius: 8px;
        margin: 20px 0;
      }
      li {
        margin: 8px 0;
        word-break: break-all;
      }
      .embed-section {
        margin: 40px 0;
        padding: 20px;
        background: #1a1a2e;
        border-radius: 12px;
        border: 1px solid rgba(139, 92, 246, 0.3);
      }
      .embed-section h2 {
        color: #8b5cf6;
        margin-top: 0;
      }
    </style>
  </head>
  <body>
    <h1>Embed QA</h1>
    <ul>
      <li><strong>FORM_BASE:</strong> {FB}</li>
      <li><strong>CAL_BASE:</strong> {CB}</li>
      <li><strong>FORM_ID:</strong> {FID}</li>
      <li><strong>CAL_ID:</strong> {CID || "(not set)"}</li>
    </ul>
    
    <div class="embed-section">
      <h2>ZRM Form Embed</h2>
      <GHLForm />
    </div>
    
    <div class="embed-section">
      <h2>ZRM Calendar Embed</h2>
      <GHLCalendar />
    </div>
  </body>
</html>
