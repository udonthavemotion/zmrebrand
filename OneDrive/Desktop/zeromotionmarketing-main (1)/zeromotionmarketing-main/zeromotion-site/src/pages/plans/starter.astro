---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ModernBookingModal from "../../components/ModernBookingModal.astro";

const title = "Starter Website Plan | ZeroMotion Marketing";
const description = "Get online fast with a professional website. Perfect for barbershops, detailers, local food spots. AI-built, mobile-first, includes hosting, SSL, analytics, and Google Business Profile connection. Request a custom quote.";
const ogImage = "/og-webdesign.png";
---

<BaseLayout {title} {description} {ogImage}>
  <!-- Canonical URL -->
  <link slot="head" rel="canonical" href="https://zeromotion.marketing/plans/starter" />
  <main>
    <!-- Hero Section -->
    <section
      id="starter-hero"
      class="relative isolate overflow-hidden bg-black min-h-[70svh] sm:min-h-[78svh] grid place-items-center"
      aria-labelledby="starter-title"
    >
      <video
        class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover stable-plan-video"
        style="filter: brightness(0.75) contrast(1.1) saturate(1.15); will-change: transform;"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        onloadstart="this.style.visibility='visible'"
        oncanplay="this.classList.add('loaded')"
      >
        <source src="/assets/textures/9461-219710531_small.mp4" type="video/mp4" />
      </video>
      <!-- Workflow Image Overlay -->
      <div class="pointer-events-none absolute inset-0 -z-10 opacity-10">
        <img
          src="/assets/zeromotion_workflow_1_lead_capture.png"
          alt=""
          class="w-full h-full object-cover object-center"
        />
      </div>
      <div
        class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-black/80 via-transparent to-black/60"
      >
      </div>
      <div class="relative container-page text-center">
        <h1 id="starter-title" class="h1 mb-6">Starter Website: live fast, look legit, start converting.</h1>
        <div class="mb-6">
          <span class="text-3xl sm:text-4xl font-bold text-primary">Custom Quote</span>
        </div>
        <p class="text-white/85 max-w-2xl mx-auto text-lg mb-8">
          Get online fast with a professional website and local SEO foundation that drives real results. Now includes brand consistency and smart automation to maximize your investment.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <button
            type="button"
            class="btn-primary"
            onclick="openLeadModal('starter-plan'); window.dataLayer&&dataLayer.push({event:'cta_click',label:'Start Starter'})"
          >
            Start Starter
          </button>
          <button
            type="button"
            class="btn-ghost"
            onclick="openStrategistModal('starter-plan'); window.dataLayer&&dataLayer.push({event:'cta_click',label:'Talk to Strategist'})"
          >
            Talk to a Strategist
          </button>
        </div>
      </div>
    </section>

    <!-- What's Included Section -->
    <section class="section-padding bg-black/20">
      <div class="container-page">
        <div class="text-center mb-12 reveal">
          <h2 class="h2 mb-4">What's Included</h2>
          <p class="text-white/70 max-w-2xl mx-auto">
            Everything you need to establish a professional online presence and start converting visitors into customers.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">1–3 page AI-built site</h3>
              <p class="text-white/70">Mobile-first, speed-optimized website built with AI assistance for maximum performance.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Hosting/CDN, SSL, domain connection</h3>
              <p class="text-white/70">Fast, secure hosting with SSL certificate and seamless domain connection included.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Basic analytics & heatmaps</h3>
              <p class="text-white/70">Track visitor behavior and performance with essential analytics and heatmap data.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Google Business Profile connection</h3>
              <p class="text-white/70">Seamless integration with your Google Business Profile for local visibility.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">1 light update/month</h3>
              <p class="text-white/70">Monthly maintenance and light content updates to keep your site fresh and current.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Brand Foundation Included Section -->
    <section class="section-padding bg-black/20" data-event="view_starter_enhanced_features">
      <div class="container-page">
        <div class="text-center mb-12 reveal">
          <h2 class="h2 mb-4">Brand Foundation Included</h2>
          <p class="text-white/70 max-w-2xl mx-auto">
            Professional branding that makes your business look established and trustworthy from day one.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2m-9 0h10m-9 0V1m10 3V1m0 3l1 1v16a2 2 0 01-2 2H6a2 2 0 01-2-2V5l1-1z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Professional logo refresh</h3>
              <p class="text-white/70">Ensure your website represents your business professionally from the first impression.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Basic brand guidelines</h3>
              <p class="text-white/70">Consistent colors, fonts, and messaging across all your business materials.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0-9v9"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Brand-consistent website design</h3>
              <p class="text-white/70">Every page element matches your professional brand for cohesive customer experience.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Smart Automation Included Section -->
    <section class="section-padding">
      <div class="container-page">
        <div class="text-center mb-12 reveal">
          <h2 class="h2 mb-4">Smart Automation Included</h2>
          <p class="text-white/70 max-w-2xl mx-auto">
            AI-powered tools that work 24/7 to capture and nurture your leads automatically.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Intelligent contact form</h3>
              <p class="text-white/70">Automatically captures and organizes leads with smart qualification scoring.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Google My Business optimization</h3>
              <p class="text-white/70">Smart posting and review management that keeps your local presence active.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Basic lead notifications</h3>
              <p class="text-white/70">Instant alerts when someone contacts you, so you never miss an opportunity.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Integration Benefits Section -->
    <section class="section-padding bg-black/20" data-event="starter_integration_benefits">
      <div class="container-page">
        <div class="text-center mb-12 reveal">
          <h2 class="h2 mb-4">Why Starter Website + Brand Foundation Works Better</h2>
          <p class="text-white/70 max-w-2xl mx-auto">
            Integrated solutions deliver superior results compared to buying services separately.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-16">
          <div class="card reveal">
            <div class="p-6 text-center">
              <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-3">Professional Consistency</h3>
              <p class="text-white/70">Your website, business cards, and social media all match for a cohesive professional brand.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6 text-center">
              <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-3">Smart Lead Capture</h3>
              <p class="text-white/70">Every website visitor becomes a potential customer with intelligent automation systems.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6 text-center">
              <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-3">Growth Ready</h3>
              <p class="text-white/70">Easy upgrade path to Growth Marketing when you're ready to scale your business.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Perfect For Section -->
    <section class="section-padding">
      <div class="container-page">
        <div class="text-center mb-12 reveal">
          <h2 class="h2 mb-4">Perfect for</h2>
          <p class="text-white/70 max-w-2xl mx-auto">
            Ideal for local businesses and single-operator professionals who need to establish a professional online presence quickly.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
          <div class="text-center reveal">
            <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.5a1.5 1.5 0 011.5 1.5v1a1.5 1.5 0 01-1.5 1.5H9m0-5v5m0-5a1.5 1.5 0 00-1.5-1.5H6a1.5 1.5 0 00-1.5 1.5v5a1.5 1.5 0 001.5 1.5h1.5"/>
              </svg>
            </div>
            <h3 class="font-semibold text-white">Barbershops</h3>
          </div>

          <div class="text-center reveal">
            <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 7.172V5L8 4z"/>
              </svg>
            </div>
            <h3 class="font-semibold text-white">Auto Detailers</h3>
          </div>

          <div class="text-center reveal">
            <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
            </div>
            <h3 class="font-semibold text-white">Local Food Spots</h3>
          </div>

          <div class="text-center reveal">
            <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <h3 class="font-semibold text-white">Single-Operator Pros</h3>
          </div>
        </div>
      </div>
    </section>

    <!-- Upgrade Path Section -->
    <section class="section-padding bg-black/20" data-event="starter_upgrade_interest">
      <div class="container-page">
        <div class="text-center mb-12 reveal">
          <h2 class="h2 mb-4">Upgrade Path</h2>
          <p class="text-white/70 max-w-2xl mx-auto">
            Ready for advanced features like online booking, reviews, and lead magnets? Upgrade to Growth for complete marketing automation.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-12">
          <div class="card reveal">
            <div class="p-6">
              <h3 class="font-semibold text-white mb-3">Online Booking</h3>
              <p class="text-white/70 mb-4">Let customers book appointments directly from your website with automated confirmations and reminders.</p>
              <span class="text-primary text-sm font-medium">Available in Growth →</span>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <h3 class="font-semibold text-white mb-3">Reviews Widget</h3>
              <p class="text-white/70 mb-4">Showcase your best customer reviews directly on your website to build trust and credibility.</p>
              <span class="text-primary text-sm font-medium">Available in Growth →</span>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <h3 class="font-semibold text-white mb-3">Lead Magnet</h3>
              <p class="text-white/70 mb-4">Capture more leads with valuable content offers like guides, discounts, or free consultations.</p>
              <span class="text-primary text-sm font-medium">Available in Growth →</span>
            </div>
          </div>
        </div>

        <div class="text-center reveal">
          <p class="text-white/80 mb-6 text-lg">
            These features are included in our Growth plan, which adds complete marketing automation with funnels, SMS sequences, and review management.
          </p>
          <a
            href="/plans/growth"
            class="btn-primary"
            onclick="window.dataLayer&&dataLayer.push({event:'cta_click',label:'Upgrade to Growth'})"
          >
            Upgrade to Growth
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="section-padding" id="faq">
      <div class="container-page">
        <div class="text-center mb-12 reveal">
          <h2 class="h2 mb-4">Frequently Asked Questions</h2>
          <p class="text-white/70 max-w-2xl mx-auto">
            Common questions about the Starter plan and our process.
          </p>
        </div>

        <div class="max-w-4xl mx-auto">
          <div class="space-y-4 reveal">
            <div class="card">
              <details class="group">
                <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                  <h3 class="font-semibold text-white group-hover:text-primary transition-colors">
                    How fast can you launch?
                  </h3>
                  <svg 
                    class="w-5 h-5 text-white/60 group-hover:text-primary transition-all duration-200 group-open:rotate-180" 
                    fill="none" 
                    stroke="currentColor" 
                    viewBox="0 0 24 24"
                  >
                    <path 
                      stroke-linecap="round" 
                      stroke-linejoin="round" 
                      stroke-width="2" 
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>
                <div class="px-6 pb-6 pt-0">
                  <p class="text-white/80 leading-relaxed">
                    5–10 business days after intake. We use AI-assisted design and development to deliver professional websites quickly without compromising quality.
                  </p>
                </div>
              </details>
            </div>

            <div class="card">
              <details class="group">
                <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                  <h3 class="font-semibold text-white group-hover:text-primary transition-colors">
                    Can I add pages later?
                  </h3>
                  <svg 
                    class="w-5 h-5 text-white/60 group-hover:text-primary transition-all duration-200 group-open:rotate-180" 
                    fill="none" 
                    stroke="currentColor" 
                    viewBox="0 0 24 24"
                  >
                    <path 
                      stroke-linecap="round" 
                      stroke-linejoin="round" 
                      stroke-width="2" 
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>
                <div class="px-6 pb-6 pt-0">
                  <p class="text-white/80 leading-relaxed">
                    Yes! You can add pages through add-ons or upgrade to Growth for more comprehensive website management and expansion capabilities.
                  </p>
