---
const title = "Redirecting to Pricing...";
const description = "Redirecting to our pricing page.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content="{description}">
  <meta http-equiv="refresh" content="0; url=/pricing">
  <script>
    window.location.href = '/pricing';
  </script>
</head>
<body>
  <p>Redirecting to <a href="/pricing">pricing page</a>...</p>
</body>
</html>