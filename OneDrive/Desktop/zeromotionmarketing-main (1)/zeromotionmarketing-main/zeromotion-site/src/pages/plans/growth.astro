---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ModernBookingModal from "../../components/ModernBookingModal.astro";

const title = "Growth Marketing Plan | ZeroMotion Marketing";
const description = "Complete marketing automation for growing businesses. Includes funnels, ZRM CRM integration, GBP optimization, social posts, review workflows, and monthly reporting. Perfect for Louisiana businesses ready to scale. Request a custom quote.";
const ogImage = "/og-webdesign.png";
---

<BaseLayout {title} {description} {ogImage}>
  <!-- Canonical URL -->
  <link slot="head" rel="canonical" href="https://zeromotion.marketing/plans/growth" />
  <main>
    <!-- Hero Section -->
    <section
      id="growth-hero"
      class="relative isolate overflow-hidden bg-black min-h-[70svh] sm:min-h-[78svh] grid place-items-center"
      aria-labelledby="growth-title"
    >
      <video
        class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover stable-plan-video"
        style="filter: brightness(0.75) contrast(1.1) saturate(1.15); will-change: transform;"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        onloadstart="this.style.visibility='visible'"
        oncanplay="this.classList.add('loaded')"
      >
        <source src="/assets/textures/9461-219710531_small.mp4" type="video/mp4" />
      </video>
      <!-- Workflow Image Overlay -->
      <div class="pointer-events-none absolute inset-0 -z-10 opacity-10">
        <img
          src="/assets/zeromotion_workflow_2_automation.png"
          alt=""
          class="w-full h-full object-cover object-center"
        />
      </div>
      <div
        class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-black/80 via-transparent to-black/60"
      >
      </div>
      <div class="relative container-page text-center">
        <h1 id="growth-title" class="h1 mb-6">Growth Marketing: funnels + automation that make phones ring.</h1>
        <div class="mb-6">
          <span class="text-3xl sm:text-4xl font-bold text-primary">Custom Quote</span>
        </div>
        <p class="text-white/85 max-w-2xl mx-auto text-lg mb-8">
          Complete marketing automation with funnels, ZRM CRM integration, and content management. Now includes brand-consistent marketing materials and AI automation that convert better and build stronger customer relationships.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <button
            type="button"
            class="btn-primary"
            onclick="openLeadModal('growth-plan'); window.dataLayer&&dataLayer.push({event:'cta_click',label:'Start Growth'})"
          >
            Start Growth
          </button>
          <button
            type="button"
            class="btn-ghost"
            onclick="openStrategistModal('growth-plan'); window.dataLayer&&dataLayer.push({event:'cta_click',label:'Talk to Strategist'})"
          >
            Talk to a Strategist
          </button>
        </div>
      </div>
    </section>

    <!-- What's Included Section -->
    <section class="section-padding bg-black/20">
      <div class="container-page">
        <div class="text-center mb-12 reveal">
          <h2 class="h2 mb-4">What's Included</h2>
          <p class="text-white/70 max-w-2xl mx-auto">
            Everything you need for comprehensive marketing automation and lead generation that actually converts.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Funnel + lead forms</h3>
              <p class="text-white/70">Custom-built sales funnels with optimized lead capture forms that convert visitors into customers.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">SMS/email sequences in ZRM CRM</h3>
              <p class="text-white/70">Automated follow-up sequences that nurture leads through SMS and email until they convert.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">GBP optimization + weekly posts</h3>
              <p class="text-white/70">Complete Google Business Profile optimization with weekly posts to maintain local search visibility.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2m-9 0h10m-9 0a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V6a2 2 0 00-2-2"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">4–8 monthly social posts</h3>
              <p class="text-white/70">Templated, AI-assisted social media content to maintain consistent brand presence across platforms.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Reputation workflow</h3>
              <p class="text-white/70">Automated review request system that helps build your online reputation and credibility.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Monthly dashboard & call tracking</h3>
              <p class="text-white/70">Comprehensive monthly reports with call tracking to measure ROI and campaign performance.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Brand Integration Included Section -->
    <section class="section-padding" data-event="view_growth_enhanced_features">
      <div class="container-page">
        <div class="text-center mb-12 reveal">
          <h2 class="h2 mb-4">Brand Integration Included</h2>
          <p class="text-white/70 max-w-2xl mx-auto">
            Professional branding that ensures every marketing touchpoint reinforces your business identity and builds trust.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Brand-consistent funnel design</h3>
              <p class="text-white/70">Every step of your funnel reinforces your professional brand and builds customer confidence.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Branded email templates</h3>
              <p class="text-white/70">All automated emails match your brand voice and style, creating consistent messaging across all touchpoints.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2m-9 0h10m-9 0a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V6a2 2 0 00-2-2"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Social media brand consistency</h3>
              <p class="text-white/70">Posts and content maintain professional brand standards across all social platforms.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Advanced AI Automation Section -->
    <section class="section-padding bg-black/20" data-event="growth_ai_interest">
      <div class="container-page">
        <div class="text-center mb-12 reveal">
          <h2 class="h2 mb-4">Advanced AI Automation</h2>
          <p class="text-white/70 max-w-2xl mx-auto">
            Intelligent systems that work 24/7 to qualify leads, personalize communication, and maximize conversions.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Smart lead qualification</h3>
              <p class="text-white/70">AI identifies your best prospects automatically by analyzing behavior patterns and engagement signals.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Intelligent follow-up sequences</h3>
              <p class="text-white/70">AI personalizes messages based on lead behavior, timing responses for maximum engagement.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="w-12 h-12 bg-primary/20 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3a4 4 0 118 0v4M5 21h14a2 2 0 002-2v-7a2 2 0 00-2-2H5a2 2 0 00-2 2v7a2 2 0 002 2z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-2">Automated appointment booking</h3>
              <p class="text-white/70">AI handles scheduling while you focus on closing deals, with smart availability matching and confirmations.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ROI Enhancement Section -->
    <section class="section-padding" data-event="growth_roi_benefits">
      <div class="container-page">
        <div class="text-center mb-12 reveal">
          <h2 class="h2 mb-4">Why Brand + Marketing + AI Delivers 40% Better ROI</h2>
          <p class="text-white/70 max-w-2xl mx-auto">
            Integrated solutions create compounding value that standalone services simply can't match.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-16">
          <div class="card reveal">
            <div class="p-6 text-center">
              <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-3">Higher Conversion Rates</h3>
              <p class="text-white/70">Brand-consistent funnels convert 40% better than generic ones, with AI optimization continuously improving performance.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6 text-center">
              <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-3">Better Lead Quality</h3>
              <p class="text-white/70">AI qualification means you only talk to serious prospects, saving time and increasing close rates.</p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6 text-center">
              <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
                </svg>
              </div>
              <h3 class="font-semibold text-white mb-3">More Closed Deals</h3>
              <p class="text-white/70">Professional branding builds trust that closes more sales, with AI ensuring every lead gets perfect follow-up.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Deliverables Section -->
    <section class="section-padding">
      <div class="container-page">
        <div class="text-center mb-12 reveal">
          <h2 class="h2 mb-4">What You Get</h2>
          <p class="text-white/70 max-w-2xl mx-auto">
            Complete marketing infrastructure with detailed documentation and training for your team.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-16">
          <div class="card reveal">
            <div class="p-6">
              <div class="flex items-center mb-4">
                <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
                <h3 class="font-semibold text-white">Nurture Sequences</h3>
              </div>
              <p class="text-white/70">
                Custom-built email and SMS sequences that automatically follow up with leads, providing value and guiding them toward conversion.
              </p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="flex items-center mb-4">
                <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3a4 4 0 118 0v4M5 21h14a2 2 0 002-2v-7a2 2 0 00-2-2H5a2 2 0 00-2 2v7a2 2 0 002 2z"/>
                  </svg>
                </div>
                <h3 class="font-semibold text-white">Booking Flows</h3>
              </div>
              <p class="text-white/70">
                Streamlined appointment booking system integrated with your calendar, with automated confirmations and reminder sequences.
              </p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="flex items-center mb-4">
                <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                  </svg>
                </div>
                <h3 class="font-semibold text-white">Pipelines/Tags</h3>
              </div>
              <p class="text-white/70">
                Organized lead management system with automated tagging and pipeline stages to track every prospect's journey.
              </p>
            </div>
          </div>

          <div class="card reveal">
            <div class="p-6">
              <div class="flex items-center mb-4">
                <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                </div>
                <h3 class="font-semibold text-white">SOP Loom Videos</h3>
              </div>
              <p class="text-white/70">
                Step-by-step video training showing you how to manage your new systems, update content, and maximize results.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="section-padding bg-black/20" id="faq">
      <div class="container-page">
        <div class="text-center mb-12 reveal">
          <h2 class="h2 mb-4">Frequently Asked Questions</h2>
          <p class="text-white/70 max-w-2xl mx-auto">
            Common questions about the Growth plan and what to expect.
          </p>
        </div>

        <div class="max-w-4xl mx-auto">
          <div class="space-y-4 reveal">
            <div class="card">
              <details class="group">
                <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                  <h3 class="font-semibold text-white group-hover:text-primary transition-colors">
                    Do you integrate with my current site?
                  </h3>
                  <svg
                    class="w-5 h-5 text-white/60 group-hover:text-primary transition-all duration-200 group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>
                <div class="px-6 pb-6 pt-0">
                  <p class="text-white/80 leading-relaxed">
                    Yes. We connect forms, chat, and calendars seamlessly with your existing website to ensure smooth lead flow and booking automation.
                  </p>
                </div>
              </details>
            </div>

            <div class="card">
              <details class="group">
                <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                  <h3 class="font-semibold text-white group-hover:text-primary transition-colors">
                    How soon will I see leads?
                  </h3>
                  <svg
                    class="w-5 h-5 text-white/60 group-hover:text-primary transition-all duration-200 group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>
                <div class="px-6 pb-6 pt-0">
                  <p class="text-white/80 leading-relaxed">
                    Typically 2–4 weeks post-setup as sequences go live. We'll start seeing data immediately, but the full automation effect builds over the first month.
                  </p>
                </div>
              </details>
            </div>

            <div class="card">
              <details class="group">
                <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                  <h3 class="font-semibold text-white group-hover:text-primary transition-colors">
                    Can you manage my reviews?
                  </h3>
                  <svg
