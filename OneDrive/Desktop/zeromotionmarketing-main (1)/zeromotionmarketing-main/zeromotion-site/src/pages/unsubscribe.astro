---
import BaseLayout from "../layouts/BaseLayout.astro";
import { processUnsubscribe } from "../server/email";

export const prerender = false;

export async function getStaticPaths() {
  return [];
}

const { url } = Astro;
const searchParams = url.searchParams;
const subscriberId = searchParams.get('id');
const campaignId = searchParams.get('campaign');
const action = searchParams.get('action') || 'unsubscribe';
const email = searchParams.get('email') || '';

let result: any = null;
let error: string | null = null;

if (subscriberId && campaignId) {
  try {
    result = await processUnsubscribe({
      subscriberId,
      campaignId,
      action: action as 'unsubscribe' | 'resubscribe',
      email,
      reason: searchParams.get('reason') || undefined
    });
  } catch (err) {
    error = err instanceof Error ? err.message : 'An error occurred processing your request';
  }
}
---

<BaseLayout title="Email Unsubscribe — ZeroMotion" description="Unsubscribe from ZeroMotion Marketing emails. We respect your privacy and will honor your unsubscribe request immediately.">
  <main class="section-padding">
    <div class="container-page max-w-2xl">
      <div class="card p-8 text-center">
        {result ? (
          <>
            <div class="text-6xl mb-6">✅</div>
            <h1 class="h2 mb-4 text-primary">
              {action === 'unsubscribe' ? 'Successfully Unsubscribed' : 'Successfully Resubscribed'}
            </h1>
            <p class="text-white/85 mb-6 text-lg">
              {action === 'unsubscribe'
                ? 'You have been successfully unsubscribed from our marketing emails. You will no longer receive promotional communications from ZeroMotion Marketing.'
                : 'You have been successfully resubscribed to our marketing emails. Welcome back!'
              }
            </p>

            <div class="bg-primary/10 p-6 rounded-lg mb-6">
              <h3 class="h4 mb-3 text-primary">What happens next?</h3>
              <ul class="text-white/85 space-y-2 text-left">
                <li>• Your unsubscribe request has been processed immediately</li>
                <li>• You will receive a confirmation email within 24 hours</li>
                <li>• All future marketing emails will be stopped</li>
                <li>• You can resubscribe at any time using the link in our emails</li>
                <li>• Your contact information remains secure and private</li>
              </ul>
            </div>

            <div class="space-y-4">
              <p class="text-white/75 text-sm">
                <strong>Subscriber ID:</strong> {subscriberId}<br>
                <strong>Campaign ID:</strong> {campaignId}<br>
                <strong>Processed:</strong> {new Date().toLocaleString()}
              </p>

              <div class="flex gap-4 justify-center">
                <a href="/" class="btn-primary">Return to Website</a>
                <a href="/contact" class="btn-ghost">Contact Support</a>
              </div>
            </div>
          </>
        ) : error ? (
          <>
            <div class="text-6xl mb-6">⚠️</div>
            <h1 class="h2 mb-4 text-red-400">Unsubscribe Error</h1>
            <p class="text-white/85 mb-6 text-lg">
              We encountered an error processing your unsubscribe request. Please try again or contact us directly.
            </p>

            <div class="bg-red-500/10 p-6 rounded-lg mb-6 border border-red-500/30">
              <p class="text-red-300 mb-4"><strong>Error Details:</strong></p>
              <p class="text-white/85">{error}</p>
            </div>

            <div class="space-y-4">
              <h3 class="h4 text-primary">Alternative Unsubscribe Methods</h3>
              <ul class="text-white/85 space-y-2 text-left">
                <li>• Reply to any marketing email with "UNSUBSCRIBE" in the subject line</li>
                <li>• Contact us directly at zeromotionmarketing@gmail.com</li>
                <li>• Call us at (985) 217-0368</li>
                <li>• Use the unsubscribe link in any marketing email you receive</li>
              </ul>
            </div>
          </>
        ) : (
          <>
            <div class="text-6xl mb-6">📧</div>
            <h1 class="h2 mb-4 text-primary">Email Unsubscribe</h1>
            <p class="text-white/85 mb-6 text-lg">
              Manage your email preferences for ZeroMotion Marketing communications.
            </p>

            <form method="GET" class="space-y-6 text-left">
              <div>
                <label for="subscriberId" class="block text-white/90 mb-2">Subscriber ID</label>
                <input
                  type="text"
                  id="subscriberId"
                  name="id"
                  value={subscriberId || ''}
                  required
                  class="w-full p-3 bg-surface border border-primary/30 rounded-lg text-white"
                  placeholder="Enter your subscriber ID"
                />
              </div>

              <div>
                <label for="campaignId" class="block text-white/90 mb-2">Campaign ID (Optional)</label>
                <input
                  type="text"
                  id="campaignId"
                  name="campaign"
                  value={campaignId || ''}
                  class="w-full p-3 bg-surface border border-primary/30 rounded-lg text-white"
                  placeholder="Enter campaign ID if known"
                />
              </div>

              <div>
                <label for="email" class="block text-white/90 mb-2">Email Address</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  value={email}
                  required
                  class="w-full p-3 bg-surface border border-primary/30 rounded-lg text-white"
                  placeholder="your@email.com"
                />
              </div>

              <div>
                <label for="action" class="block text-white/90 mb-2">Action</label>
                <select
                  id="action"
                  name="action"
                  class="w-full p-3 bg-surface border border-primary/30 rounded-lg text-white"
                >
                  <option value="unsubscribe" selected>Unsubscribe from marketing emails</option>
                  <option value="resubscribe">Resubscribe to marketing emails</option>
                </select>
              </div>

              <div>
                <label for="reason" class="block text-white/90 mb-2">Reason (Optional)</label>
                <select
                  id="reason"
                  name="reason"
                  class="w-full p-3 bg-surface border border-primary/30 rounded-lg text-white"
                >
                  <option value="">Please select a reason</option>
                  <option value="too-frequent">Emails too frequent</option>
                  <option value="not-relevant">Content not relevant</option>
                  <option value="changed-mind">Changed my mind</option>
                  <option value="privacy-concerns">Privacy concerns</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <button type="submit" class="btn-primary w-full">
                Submit Request
              </button>
            </form>

            <div class="mt-8 pt-6 border-t border-primary/20">
              <h3 class="h4 mb-4 text-primary">Need Help?</h3>
              <p class="text-white/75 text-sm mb-4">
                If you're having trouble unsubscribing or have questions about your email preferences:
              </p>
              <div class="text-left text-white/75 text-sm">
                <p><strong>Email:</strong> zeromotionmarketing@gmail.com</p>
                <p><strong>Phone:</strong> (985) 217-0368</p>
                <p><strong>Address:</strong> Houma, Louisiana, USA</p>
              </div>
            </div>
          </>
        )}
      </div>

      <!-- CAN-SPAM Compliance Information -->
      <div class="card p-6 mt-8 bg-primary/5 border-primary/20">
        <h3 class="h4 mb-4 text-primary">CAN-SPAM Compliance</h3>
        <p class="text-white/75 text-sm mb-4">
          ZeroMotion Marketing is fully compliant with the CAN-SPAM Act of 2003. All unsubscribe requests are processed immediately and honored without question.
        </p>
        <ul class="text-white/75 text-sm space-y-1">
          <li>• ✅ Clear unsubscribe mechanism provided</li>
          <li>• ✅ Business contact information included</li>
          <li>• ✅ Physical mailing address provided</li>
          <li>• ✅ One-click unsubscribe supported</li>
          <li>• ✅ No deceptive subject lines</li>
          <li>• ✅ Commercial email properly identified</li>
        </ul>
      </div>

      <!-- Additional Compliance Links -->
      <div class="flex flex-wrap gap-4 justify-center mt-8 text-sm">
        <a href="/privacy" class="text-primary hover:underline">Privacy Policy</a>
        <span class="text-white/40">•</span>
        <a href="/terms" class="text-primary hover:underline">Terms of Service</a>
        <span class="text-white/40">•</span>
        <a href="/cookies" class="text-primary hover:underline">Cookie Policy</a>
        <span class="text-white/40">•</span>
        <a href="/disclaimer" class="text-primary hover:underline">Legal Disclaimer</a>
      </div>
    </div>
  </main>
</BaseLayout>
