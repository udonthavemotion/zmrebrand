---
import BaseLayout from "../layouts/BaseLayout.astro";
import { reportError } from "../../sentry.client.config.js";

// Report 404 to Sentry for analytics
if (typeof window !== 'undefined') {
  reportError(new Error('404 Page Not Found'), {
    page: new URL(window.location.href).pathname,
    referrer: document.referrer,
    userAgent: navigator.userAgent
  });
}

const currentPath = Astro.url.pathname;
---

<BaseLayout title="Page Not Found | ZeroMotion Marketing" description="Sorry, we couldn't find the page you're looking for. Explore our digital marketing services instead.">
  <div class="min-h-screen bg-gradient-to-br from-ink via-ink to-purple-900/20 flex items-center justify-center px-4">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Animated 404 Display -->
      <div class="relative mb-12">
        <div class="text-8xl md:text-9xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-primary to-purple-400 mb-4 animate-pulse">
          404
        </div>
        <div class="absolute inset-0 text-8xl md:text-9xl font-bold text-primary/10 blur-sm">
          404
        </div>

        <!-- Floating particles animation -->
        <div class="absolute inset-0 pointer-events-none">
          <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-primary/30 rounded-full animate-bounce" style="animation-delay: 0s;"></div>
          <div class="absolute top-1/3 right-1/4 w-1 h-1 bg-purple-400/40 rounded-full animate-bounce" style="animation-delay: 0.5s;"></div>
          <div class="absolute bottom-1/4 left-1/3 w-1.5 h-1.5 bg-primary/20 rounded-full animate-bounce" style="animation-delay: 1s;"></div>
        </div>
      </div>

      <!-- Error Message -->
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        Oops! Page Not Found
      </h1>

      <p class="text-xl text-text-muted mb-8 max-w-2xl mx-auto leading-relaxed">
        The page you're looking for doesn't exist or has been moved.
        But don't worry – we're here to help you find what you need for your digital marketing success.
      </p>

      <!-- Current Path Display -->
      <div class="bg-surface/50 backdrop-blur-sm border border-border rounded-lg p-4 mb-8 max-w-md mx-auto">
        <p class="text-sm text-text-muted mb-2">Requested path:</p>
        <code class="text-primary font-mono text-sm break-all">{currentPath}</code>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12">
        <a
          href="/"
          class="btn-primary inline-flex items-center gap-2 group"
          data-track="404-home-click"
        >
          <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          Back to Home
        </a>

        <a
          href="/services"
          class="inline-flex items-center gap-2 px-6 py-3 bg-surface/50 hover:bg-surface/70 text-white border border-border rounded-lg transition-all duration-300 group"
          data-track="404-services-click"
        >
          <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
          View Services
        </a>

        <a
          href="/pricing"
          class="inline-flex items-center gap-2 px-6 py-3 bg-surface/50 hover:bg-surface/70 text-white border border-border rounded-lg transition-all duration-300 group"
          data-track="404-pricing-click"
        >
          <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
          </svg>
          View Pricing
        </a>
      </div>

      <!-- Popular Pages -->
      <div class="bg-surface/30 backdrop-blur-sm border border-border rounded-xl p-8 max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-6">Popular Pages</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a
            href="/services/web-design"
            class="flex items-center gap-3 p-4 bg-surface/50 hover:bg-surface/70 rounded-lg transition-all duration-300 group"
            data-track="404-web-design-click"
          >
            <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center group-hover:bg-primary/30 transition-colors">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div class="text-left">
              <div class="font-semibold text-white">Web Design</div>
              <div class="text-sm text-text-muted">Custom websites</div>
            </div>
          </a>


          <a
            href="/services/crm"
            class="flex items-center gap-3 p-4 bg-surface/50 hover:bg-surface/70 rounded-lg transition-all duration-300 group"
            data-track="404-crm-click"
          >
            <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center group-hover:bg-primary/30 transition-colors">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <div class="text-left">
              <div class="font-semibold text-white">CRM Setup</div>
              <div class="text-sm text-text-muted">ZRM CRM automation</div>
            </div>
          </a>

          <a
            href="/services/brand-identity"
            class="flex items-center gap-3 p-4 bg-surface/50 hover:bg-surface/70 rounded-lg transition-all duration-300 group"
            data-track="404-branding-click"
          >
            <div class="w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center group-hover:bg-primary/30 transition-colors">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z"></path>
              </svg>
            </div>
            <div class="text-left">
              <div class="font-semibold text-white">Brand Identity</div>
              <div class="text-sm text-text-muted">Logo & branding</div>
            </div>
          </a>
        </div>
      </div>

      <!-- Contact CTA -->
      <div class="mt-12 text-center">
        <p class="text-text-muted mb-4">Need help finding something specific?</p>
        <a
          href="/about"
          class="inline-flex items-center gap-2 text-primary hover:text-white transition-colors duration-300"
          data-track="404-contact-click"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
          Contact Us
        </a>
      </div>
    </div>
  </div>

  <script>
    // Track 404 page interactions
    document.addEventListener('DOMContentLoaded', () => {
      const trackClicks = (selector, eventName) => {
        document.querySelectorAll(selector).forEach(el => {
          el.addEventListener('click', () => {
            if (window.gtag) {
              window.gtag('event', 'click', {
                event_category: '404_page',
                event_label: eventName,
                page_location: window.location.href
              });
            }
          });
        });
      };

      trackClicks('[data-track="404-home-click"]', 'back_to_home');
      trackClicks('[data-track="404-services-click"]', 'view_services');
      trackClicks('[data-track="404-pricing-click"]', 'view_pricing');
      trackClicks('[data-track="404-web-design-click"]', 'web_design_link');
      trackClicks('[data-track="404-crm-click"]', 'crm_link');
      trackClicks('[data-track="404-branding-click"]', 'branding_link');
      trackClicks('[data-track="404-contact-click"]', 'contact_link');
    });
  </script>
</BaseLayout>
