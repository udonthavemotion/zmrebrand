---
import BaseLayout from "../layouts/BaseLayout.astro";
import { reportError } from "../../sentry.client.config.js";

// Report 500 error to Sentry for analytics
if (typeof window !== 'undefined') {
  reportError(new Error('500 Server Error'), {
    page: new URL(window.location.href).pathname,
    timestamp: new Date().toISOString(),
    userAgent: navigator.userAgent
  });
}
---

<BaseLayout title="Server Error | ZeroMotion Marketing" description="We're experiencing technical difficulties. Our team has been notified and is working to resolve this issue.">
  <div class="min-h-screen bg-gradient-to-br from-red-900/20 via-ink to-purple-900/20 flex items-center justify-center px-4">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Animated 500 Display -->
      <div class="relative mb-12">
        <div class="text-8xl md:text-9xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-orange-400 mb-4 animate-pulse">
          500
        </div>
        <div class="absolute inset-0 text-8xl md:text-9xl font-bold text-red-400/10 blur-sm">
          500
        </div>

        <!-- Error particles animation -->
        <div class="absolute inset-0 pointer-events-none">
          <div class="absolute top-1/4 left-1/4 w-3 h-3 bg-red-400/20 rounded-full animate-ping" style="animation-delay: 0s;"></div>
          <div class="absolute top-1/3 right-1/4 w-2 h-2 bg-orange-400/30 rounded-full animate-ping" style="animation-delay: 0.5s;"></div>
          <div class="absolute bottom-1/4 left-1/3 w-2.5 h-2.5 bg-red-400/25 rounded-full animate-ping" style="animation-delay: 1s;"></div>
        </div>
      </div>

      <!-- Error Message -->
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        Server Error
      </h1>

      <p class="text-xl text-text-muted mb-8 max-w-2xl mx-auto leading-relaxed">
        We're experiencing technical difficulties on our end. Our team has been automatically notified and is working to resolve this issue as quickly as possible.
      </p>

      <!-- Status Information -->
      <div class="bg-surface/50 backdrop-blur-sm border border-red-400/20 rounded-lg p-6 mb-8 max-w-md mx-auto">
        <div class="flex items-center justify-center gap-3 mb-4">
          <div class="w-3 h-3 bg-red-400 rounded-full animate-pulse"></div>
          <span class="text-red-400 font-semibold">System Status: Investigating</span>
        </div>
        <p class="text-sm text-text-muted">
          Error occurred at: {new Date().toLocaleString()}
        </p>
        <p class="text-xs text-text-muted mt-2">
          Reference ID: {Math.random().toString(36).substr(2, 9).toUpperCase()}
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12">
        <button
          onclick="window.location.reload()"
          class="btn-primary inline-flex items-center gap-2 group"
          data-track="500-retry-click"
        >
          <svg class="w-5 h-5 transition-transform group-hover:rotate-180 duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          Try Again
        </button>

        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 bg-surface/50 hover:bg-surface/70 text-white border border-border rounded-lg transition-all duration-300 group"
          data-track="500-home-click"
        >
          <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          Back to Home
        </a>

        <a
          href="mailto:zeromotionmarketing@gmail.com?subject=Server Error Report"
          class="inline-flex items-center gap-2 px-6 py-3 bg-surface/50 hover:bg-surface/70 text-white border border-border rounded-lg transition-all duration-300 group"
          data-track="500-report-click"
        >
          <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.268 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
          </svg>
          Report Issue
        </a>
      </div>

      <!-- What Happened -->
      <div class="bg-surface/30 backdrop-blur-sm border border-border rounded-xl p-8 max-w-2xl mx-auto mb-8">
        <h2 class="text-2xl font-bold text-white mb-6">What Happened?</h2>
        <div class="space-y-4 text-left">
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 bg-red-400/20 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-3 h-3 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-white">Server Error</h3>
              <p class="text-sm text-text-muted">Our server encountered an unexpected error while processing your request.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-6 h-6 bg-yellow-400/20 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-white">Automatic Monitoring</h3>
              <p class="text-sm text-text-muted">Our monitoring systems have been automatically alerted and are investigating the issue.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-6 h-6 bg-green-400/20 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-3 h-3 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-white">Quick Resolution</h3>
              <p class="text-sm text-text-muted">Most server issues are resolved within minutes. Try refreshing the page or check back soon.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- System Status -->
      <div class="bg-surface/20 backdrop-blur-sm border border-border/50 rounded-lg p-6 max-w-md mx-auto">
        <h3 class="text-lg font-semibold text-white mb-4">System Status</h3>
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-muted">Website</span>
            <span class="inline-flex items-center gap-2 text-sm">
              <div class="w-2 h-2 bg-red-400 rounded-full animate-pulse"></div>
              Investigating
            </span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-muted">API Services</span>
            <span class="inline-flex items-center gap-2 text-sm">
              <div class="w-2 h-2 bg-yellow-400 rounded-full animate-pulse"></div>
              Degraded
            </span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-muted">Database</span>
            <span class="inline-flex items-center gap-2 text-sm">
              <div class="w-2 h-2 bg-green-400 rounded-full"></div>
              Operational
            </span>
          </div>
        </div>
      </div>

      <!-- Contact Information -->
      <div class="mt-12 text-center">
        <p class="text-text-muted mb-4">Need immediate assistance?</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="tel:+19853032016"
            class="inline-flex items-center gap-2 text-primary hover:text-white transition-colors duration-300"
            data-track="500-phone-click"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            Call Support
          </a>
          <a
            href="mailto:zeromotionmarketing@gmail.com"
            class="inline-flex items-center gap-2 text-primary hover:text-white transition-colors duration-300"
            data-track="500-email-click"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            Email Support
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Track 500 error page interactions
    document.addEventListener('DOMContentLoaded', () => {
      const trackClicks = (selector, eventName) => {
        document.querySelectorAll(selector).forEach(el => {
          el.addEventListener('click', () => {
            if (window.gtag) {
              window.gtag('event', 'click', {
                event_category: '500_page',
                event_label: eventName,
                page_location: window.location.href
              });
            }
          });
        });
      };

      trackClicks('[data-track="500-retry-click"]', 'retry_page');
      trackClicks('[data-track="500-home-click"]', 'back_to_home');
      trackClicks('[data-track="500-report-click"]', 'report_issue');
      trackClicks('[data-track="500-phone-click"]', 'call_support');
      trackClicks('[data-track="500-email-click"]', 'email_support');
    });

    // Auto-retry mechanism
    let retryCount = 0;
    const maxRetries = 3;
    const retryInterval = 30000; // 30 seconds

    const autoRetry = () => {
      if (retryCount < maxRetries) {
        retryCount++;
        setTimeout(() => {
          // Only auto-retry if user hasn't navigated away
          if (document.visibilityState === 'visible') {
            window.location.reload();
          }
        }, retryInterval);
      }
    };

    // Start auto-retry after 10 seconds
    setTimeout(autoRetry, 10000);
  </script>
</BaseLayout>
